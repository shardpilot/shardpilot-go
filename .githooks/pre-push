#!/bin/bash -p
#
# ⚠ AND `-p`, BECAUSE BASH RUNS FILES BEFORE LINE 1. A non-interactive bash SOURCES
# `$BASH_ENV` before executing the script, so an environment naming a tracked path
# there ran branch-supplied code first -- `exit 0` in it approves the push without
# reaching the PATH filter or the scanner. Measured both ways: with a plain
# `#!/bin/bash` shebang the startup file runs and prints before the body; with `-p`
# it does not (shardpilot/shardpilot-go#79 review). Privileged mode also refuses
# shell functions inherited from the environment, which is the same attack by a
# second road -- a `git` function would otherwise shadow every call in this file.
#
# ⚠ AND `-p` PROTECTS THIS PROCESS, NOT THE CHAIN. The rig said so on the first
# run: with `-p` the hook itself ignores the startup file, and the SCANNER it
# invokes is another bash, which sourced it and took the `exit 0` -- so the gate
# approved the push with its trusted scanner reporting clean. Protecting the shell
# you were shown leaves every shell it starts.
#
# Unset rather than sanitise: `ENV` is the same vector for a `sh`-mode child.
# ⚠ AND `CDPATH`, BECAUSE `cd` PRINTS. With `CDPATH` exported, a successful `cd`
# writes the directory it chose to stdout -- so `physdir`, which captures `cd ... &&
# pwd -P`, took TWO lines and built a hooks path containing a newline; the installed
# scanner then read as missing and every push was refused
# (shardpilot/shardpilot-go#79 review). Reproduced with `CDPATH=.:..`. It also picks
# a DIFFERENT directory than the argument names, which is worse than the noise.
unset BASH_ENV ENV CDPATH
#
# ⚠ AND THE EXPORTED FUNCTIONS, WHICH `unset` CANNOT NAME. `-p` stops THIS shell
# from importing an inherited function and leaves the environment ENTRY in place:
# measured, `BASH_FUNC_git%%` is still in `env` after a `bash -p` has started, and
# the scanner -- another bash, through its own `#!/usr/bin/env bash` -- imports it
# and runs it in place of `git` (shardpilot/shardpilot-go#79 review). That is the
# sentence twelve lines up, one road along: protecting the shell you were shown
# leaves every shell it starts.
#
# The line above cannot reach these. The entry's name is not an identifier, and
# bash refuses it to every builtin that could clear it -- `unset` and `export -n`
# both measured saying so. `env -u` accepts such a name; nothing built in does.
#
# ⚠ ENUMERATED WITH A BUILTIN, BECAUSE THE PATH FILTER HAS NOT RUN YET. `env | sed`
# here would be two branch-resolvable commands running AHEAD of the guard that
# exists to stop them -- the defect this file already recorded once, when a repair
# called `git rev-parse` before the sanitiser. `compgen -e` is a builtin, and
# `/usr/bin/env` is reached by absolute path, exactly like `/bin/bash` above. Every
# name passed to it begins with `BASH_FUNC` by construction of the match, so a
# hostile function BODY cannot steer this into stripping something else.
#
# ⚠ AND THE MARKER IS NOT THE TEST. A pushing environment can set it, so it decides
# only whether we have ALREADY tried: entries still present after one pass are
# REFUSED rather than re-exec'd, which closes that bypass and bounds this to one
# exec. Nothing has read stdin yet, so the ref list survives it.
sp_strip=()
while IFS= read -r sp_name; do
  case "$sp_name" in
    BASH_FUNC_*) sp_strip+=(-u "$sp_name") ;;
  esac
done < <(compgen -e 2>/dev/null || true)
if [ "${#sp_strip[@]}" -gt 0 ]; then
  if [ -n "${SP_PREPUSH_FUNCS_STRIPPED:-}" ] || [ ! -x /usr/bin/env ]; then
    printf 'REFUSING: this environment exports shell functions. A child shell\n' >&2
    printf '  imports them even though this hook ignores them, and they could not\n' >&2
    printf '  be removed before the scanner runs.\n' >&2
    exit 2
  fi
  exec /usr/bin/env "${sp_strip[@]}" SP_PREPUSH_FUNCS_STRIPPED=1 "$0" "$@"
fi
unset sp_strip sp_name
#
# The PATH filter below is about what a bare command RESOLVES to; this is about
# what runs before any command of ours at all.
#
# ⚠ A FIXED INTERPRETER, NOT `env`. Git runs a non-bare pre-push hook with the
# WORKTREE ROOT as its working directory, so a `PATH` carrying `.` or an empty
# component makes the checked-out branch a search location -- and `/usr/bin/env
# bash` then runs a tracked `./bash` instead of this script, before a single line
# of it has executed (shardpilot/shardpilot-go#79 review). Reproduced. Every
# protection in this file is downstream of which program is running.
#
# The same `PATH` reaches the bare `git` and `mktemp` calls below, which is why
# `sanitise_path` runs before any of them.
#
# RUN THE PUBLIC-SURFACE GATE AGAINST WHAT IS ACTUALLY BEING PUSHED.
#
# This is the only PUBLIC repository in the platform, and a repository publishes
# its HISTORY along with its tree. A commit carrying internal material is
# published the moment it is pushed -- not when it merges -- so a gate that runs
# only in CI catches it one step too late, and the remedy is a branch rewrite
# rather than a fix.
#
# WHY A HOOK AND NOT A make TARGET. The question the gate has to answer is
# "which commit will CI compare this against", and CI's answer depends on the
# REFSPEC being pushed:
#
#     push to an EXISTING ref  -> github.event.before, the pre-push tip
#     push CREATING a ref      -> the repository's default branch
#
# A Makefile cannot know the refspec. A `make check` target tried, and ten
# review rounds each found another way the guess was wrong -- narrow fetch
# configurations, `push.default`, forks whose default is not `main`, tags
# shadowing short names, remotes named with slashes or leading dashes. Every
# fix modelled a little more of git's own ref resolution.
#
# git hands a pre-push hook exactly what it could not guess. Per `githooks(5)`,
# each line on stdin is:
#
#     <local ref> <local sha> <remote ref> <remote sha>
#
# `<remote sha>` IS `github.event.before` for an existing ref, and all zeros
# when the ref is being created. So the base is read, not derived.
#
# ⚠ WHAT THIS REFUSES RATHER THAN GUESSES. `check_public_surface.sh` scans the
# tree `git write-tree` writes -- your INDEX. That is only the tree being
# pushed when the pushed tip IS your HEAD and nothing is uncommitted. When it is
# not -- `git push origin other-branch:main`, a dirty tree, a detached push --
# this hook REFUSES instead of scanning something else and reporting on it. The
# Makefile scanned anyway and documented the gap in a comment; a comment is not
# a gate.
#
# ⚠ INSTALL BY COPY, AND PIN core.hooksPath TO THE PHYSICAL DIRECTORY.
#
#     Use the installer in README.md. It is the only copy, and a scene executes
#     the text of it.
#
# ⚠ THIS BLOCK USED TO SPELL THE COMMANDS OUT, AND THEY WERE WRONG. In the main
# worktree `git rev-parse --git-common-dir` returns the RELATIVE `.git`, so they
# stored `.git/hooks` in `core.hooksPath` -- and git resolves a relative
# `core.hooksPath` against the directory hooks run in, where a linked worktree's
# `.git` is a FILE, so the hook was never invoked there and the gate was silently
# absent (shardpilot/shardpilot-go#79 review). Reproduced: `--git-path hooks`
# succeeds in the main worktree and fails with `Not a directory` in a linked one.
#
# The README installer computes the physical path and verifies the result in every
# worktree. Two copies of a procedure drift, and the copy nothing executes drifts
# first -- this one had never been run.
#
# Three things, each closing a way the gate was silently absent:
#
#   * BOTH FILES. Everything this hook EXECUTES must come from outside tracked
#     content -- the scanner as much as the hook -- or a branch you are
#     inspecting supplies its own checker.
#   * `--git-common-dir`, NOT `--git-dir`. In a linked worktree the latter names
#     `.git/worktrees/<name>` while git reads hooks from the common directory,
#     so the copy lands where git never looks.
#   * `git config --local core.hooksPath "$h"`. The earlier instruction was
#     `git config --unset core.hooksPath`, which cannot clear a GLOBAL or SYSTEM
#     setting -- measured: with an inherited value, `--git-path hooks` still
#     resolves to it and the hook is never invoked. A LOCAL setting overrides an
#     inherited one, so the path is pinned rather than unset
#     (shardpilot/shardpilot-go#79 review).
#
# The copies do not update themselves: re-copy when either file changes. That is
# the trade, and it is the right way round -- a hook that updates itself from the
# branch it is inspecting is not a gate.
#
# Bypassing is `git push --no-verify`, which is a decision to publish unscanned.

set -euo pipefail

# See the note above: every read below must see the objects a push transfers.
export GIT_NO_REPLACE_OBJECTS=1

# ⚠ AND THE CALLER'S ALTERNATE INDEX MUST NOT LEAK IN. `git push` invoked with
# GIT_INDEX_FILE set passes it to this hook, and every `git add` below -- plus
# the scanner's own fixture repositories -- would then read and MUTATE that
# index instead of the worktree's private one, which is exactly the collision
# this design exists to avoid (shardpilot/shardpilot-go#79 review).
unset GIT_INDEX_FILE
# ⚠ AND EVERY OTHER REPOSITORY SELECTOR, because clearing one of them is not
# isolation. `GIT_DIR=/repo/.git GIT_WORK_TREE=/repo git push` passes both to this
# hook, so `cd "$wt"` changed the directory and changed nothing else: `read-tree`
# and the `update-index` calls below then wrote the CALLER'S index -- replacing a
# developer's staged work with a historical tree plus synthetic evidence entries
# (shardpilot/shardpilot-go#79 review). That is the only defect in this gate whose
# damage lands outside the push it refuses.
#
# The list is what `git --help environment` names as pointing a command at a
# repository; anything left set here is inherited by every command below, and the
# scan worktree is entered with `cd`, which changes only the directory.
# ⚠ AND THE OBJECT STORES ARE NOT SELECTORS. `GIT_OBJECT_DIRECTORY` and
# `GIT_ALTERNATE_OBJECT_DIRECTORIES` say where objects LIVE, not which repository a
# command means -- and the commits being pushed may exist only there, so clearing
# them made `cat-file`, `diff` and `worktree add` unable to read the very push under
# inspection (shardpilot/shardpilot-go#79 review, reproduced).
#
# My previous fix listed them with the rest because they appear in the same section
# of `git --help environment`. The rule was "clear what points a command at a
# repository"; two members of the list I applied it to do not point at one. A claim
# about the members is not established by deriving the membership.
# ⚠ THE SELECTOR IS DROPPED, THE REPOSITORY IS NOT. A push launched as
# `git --git-dir=/path/repo.git push` runs this hook from the CALLER's cwd and names
# the repository only through `GIT_DIR` -- so clearing it made every later command
# discover whatever repository contains that cwd, or none, and the gate looked for
# its trusted scanner in a different repository's hooks directory
# (shardpilot/shardpilot-go#79 review). The loop exists to drop INHERITED selectors
# that may point elsewhere; the one that says which repository is being pushed is
# resolved first and put back.
# A literal newline, needed by the sentinel convention below and by this
# selector-preserving step, so it is defined before either.
NL='
'
TAB="$(printf '\tX')"; TAB="${TAB%X}"
CR="$(printf '\rX')"; CR="${CR%X}"
inherited_git_dir=""
if [ -n "${GIT_DIR:-}" ]; then
  # ⚠ WITH BUILTINS. This step runs BEFORE the PATH filter -- it has to, since the
  # filter needs the repository -- and my first version called `git` here: a
  # checkout-controlled directory leading PATH would have executed a tracked `bin/git`
  # ahead of every protection in this file, including the one that drops it
  # (shardpilot/shardpilot-go#79 review). A fix that introduces an external command
  # ahead of the sanitiser is worse than the defect it repaired.
  #
  # Absolute is all this needs: the point is to keep naming the SAME repository after
  # the selectors are cleared, not to canonicalise it.
  case "$GIT_DIR" in
    /*) inherited_git_dir="$GIT_DIR" ;;
    *) inherited_git_dir="$PWD/$GIT_DIR" ;;
  esac
  # ⚠ AND THE SPELLING IS NORMALISED BEFORE ANY LAYOUT TEST. `git --git-dir=.git/ push`
  # is valid and git passes the trailing slash through, so this captured
  # `<checkout>/.git/` -- which neither the later `*/.git` pattern nor the equality
  # against `$checkout_root/.git` recognises, and an ORDINARY push was refused as an
  # ownerless separate git directory (shardpilot/shardpilot-go#79 review). Those tests
  # are lexical, so what they read has to be a normal form; preserving the inherited
  # value was necessary and not sufficient.
  #
  # ⚠ AND A `.` COMPONENT IS PART OF THE NORMAL FORM TOO. `git --git-dir=.git/.
  # push` is an ordinary invocation -- measured: git hands the hook the literal
  # `.git/.` -- and this loop removed only trailing SLASHES, so the `*/.git`
  # ownership test below saw `.../.git/.`, failed to match, and classified an
  # ordinary checkout as an ownerless separate git directory: every push refused
  # (shardpilot/shardpilot-go#79 review).
  #
  # ⚠ `.` IS COLLAPSED AND `..` IS DELIBERATELY NOT. A `.` component is a no-op in
  # a pathname whatever the filesystem holds, so removing it preserves meaning
  # unconditionally. `..` does not: `a/../b` is not `b` when `a` is a symlink, so
  # collapsing it lexically could make a path read as INSIDE the checkout when it
  # physically is not -- a false acceptance, which is the direction that costs
  # something here. A `..` spelling already matches the `*/.git` test on its own,
  # so nothing is lost by leaving it.
  #
  # Only builtins: this decides whether the first external command may run at all.
  # >>> GIT_DIR NORMAL FORM. scripts/test_prepush_bare_exemption.sh lifts the lines
  # between these markers and runs them against the spellings git actually hands a
  # hook. Moving or renaming the markers makes that test refuse.
  while :; do
    case "$inherited_git_dir" in
      /) break ;;
      */) inherited_git_dir="${inherited_git_dir%/}" ;;
      */.)
        # ⚠ `/.` IS THE ROOT DIRECTORY, NOT NOTHING. Stripping the component leaves
        # an empty string, and both "break here" and "accept the empty value" are
        # wrong -- the normal form of `/.` is `/`. Caught by the rig, not by reading.
        gd_head="${inherited_git_dir%/.}"
        [ -n "$gd_head" ] || gd_head="/"
        inherited_git_dir="$gd_head"
        ;;
      */./*) inherited_git_dir="${inherited_git_dir%%/./*}/${inherited_git_dir#*/./}" ;;
      ./*) inherited_git_dir="${inherited_git_dir#./}" ;;
      *) break ;;
    esac
  done
  # <<< GIT_DIR NORMAL FORM
  unset gd_head
fi
for gv in GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_NAMESPACE \
          GIT_CEILING_DIRECTORIES GIT_DISCOVERY_ACROSS_FILESYSTEM GIT_PREFIX \
          GIT_ATTR_NOSYSTEM; do
  unset "$gv" 2>/dev/null || true
done
unset gv

# ⚠ AND THE CONFIG-INJECTING ONES, WHICH THIS LIST HAD NEVER HELD. `git -c k=v push`
# reaches a hook as `GIT_CONFIG_PARAMETERS`, and it OUTRANKS the `GIT_CONFIG_COUNT`
# overrides this file sets further down: `git -c core.fsmonitor=./fsmon push`
# re-enabled the branch-supplied program that the driver neutralisation exists to
# stop -- measured, and named by no review (shardpilot/shardpilot-go#79 review found
# the sibling in `core.bare`).
#
# ⚠ THE REVIEW SAID `GIT_CONFIG_COUNT`; ON THIS GIT IT IS `GIT_CONFIG_PARAMETERS`.
# Measured on 2.50.1: a hook under `git -c core.bare=false push` sees
# `GIT_CONFIG_PARAMETERS='core.bare'='false'` and no COUNT at all. A repair aimed at
# the mechanism as named would not have closed it, so both are cleared and the
# question is asked of both.
#
# ⚠ AND MY EARLIER "MEASURED AS IRRELEVANT" WAS OF THE WRONG MECHANISM. The
# bare-exemption comment below said external config layering cannot flip bareness;
# that test was of `GIT_CONFIG_GLOBAL`, which indeed cannot, and I generalised it to
# an environment that can. A reading proves less than the claim built from it.
#
# Recorded BEFORE clearing, because the bare exemption further down may not be taken
# from a file that git was not reading alone.
sp_cfg_env=no
for gv in GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT GIT_CONFIG GIT_CONFIG_GLOBAL \
          GIT_CONFIG_SYSTEM; do
  eval "gv_val=\${$gv:-}"
  [ -n "$gv_val" ] && sp_cfg_env=yes
  unset "$gv" 2>/dev/null || true
done
unset gv gv_val
if [ -n "$inherited_git_dir" ]; then
  GIT_DIR="$inherited_git_dir"
  export GIT_DIR
fi

# ⚠ AND THE OBJECT STORES ARE MADE ABSOLUTE, because the scan ENTERS A DIFFERENT
# DIRECTORY. A relative `GIT_OBJECT_DIRECTORY=objects-alt` resolves against the
# repository root for the reads above and against the temporary worktree after
# `cd "$wt"` -- so keeping the variable, which the previous round correctly
# restored, then refused every such push (shardpilot/shardpilot-go#79 review).
# Preserving a value and preserving its MEANING are two steps.
# ⚠ AND `GIT_ALTERNATE_OBJECT_DIRECTORIES` IS A LIST. It is colon-separated, so
# passing the whole value to one `cd` failed and assigned empty -- making commits
# stored only in those alternates unreadable and refusing an otherwise supported
# push (shardpilot/shardpilot-go#79 review). A variable whose name is plural was
# treated as a path.
# cquote_alt renders a path as git's C-quoted form: literal backslash doubled,
# literal quote escaped, the whole wrapped in quotes.
#
# ⚠ NOT THROUGH `sed`, AND THE REASON IS THIS FILE'S OWN HISTORY. The round before
# wrote these as sed scripts and I verified them by TYPING the expression into a
# shell rather than reading the one in the file -- which by then carried four
# backslashes, not two, so the pattern matched a doubled backslash that is never
# present and the quote branch emitted two. Measured after the fact: git reads the
# original `"…/obj\\ects"` and rejects the value this produced
# (shardpilot/shardpilot-go#86 review). A transformation whose text passes through
# three quoting layers cannot be checked by reading it; done byte by byte, there
# are no layers to get wrong.
cquote_alt() {
  cq_rest="$1"
  cq_out=""
  while [ -n "$cq_rest" ]; do
    cq_c="${cq_rest%"${cq_rest#?}"}"
    cq_rest="${cq_rest#?}"
    case "$cq_c" in
      '\') cq_out="$cq_out\\\\" ;;
      '"') cq_out="$cq_out\\\"" ;;
      # ⚠ AND THE CONTROL BYTES GIT ITSELF ESCAPES. The default branch emitted the
      # byte literally, and this value is written into `objects/info/alternates`,
      # which is LINE ORIENTED -- so a newline in the path split it into two
      # malformed records, the private object store could not reach the real one,
      # the pushed commits became unreadable and a valid push was refused
      # (shardpilot/shardpilot-go#79 review). A separator drawn from the alphabet
      # of the values it separates is not a separator, which this file has already
      # written down about a different value.
      "$NL") cq_out="$cq_out\\n" ;;
      "$TAB") cq_out="$cq_out\\t" ;;
      "$CR") cq_out="$cq_out\\r" ;;
      *) cq_out="$cq_out$cq_c" ;;
    esac
  done
  printf '"%s"' "$cq_out"
}
absolutize_one() {
  case "$1" in
    /*|"") printf '%s' "$1" ;;
    *)
      # ⚠ A SENTINEL, BECAUSE `$( )` EATS TRAILING NEWLINES. A directory name may
      # end in one -- git resolves `"/tmp/objects\n"` -- and the substitution
      # silently trimmed it, so the hook looked in a directory that does not exist
      # and refused a push whose objects were reachable
      # (shardpilot/shardpilot-go#86 review). `pwd` adds one newline of its own;
      # the sentinel makes the two distinguishable.
      # ⚠ `--`, BECAUSE A DIRECTORY MAY BE NAMED LIKE AN OPTION. `cd "-P"` is `cd -P`
      # with no operand, which resolves to `$HOME` rather than `$PWD/-P` -- so a legal
      # relative `GIT_OBJECT_DIRECTORY` or alternate named `-P` or `-L` exported the
      # WRONG object store and the push was refused for objects that were there
      # (shardpilot/shardpilot-go#79 review). `physdir` already had the terminator;
      # this function was written before it and never revisited.
      abs_out="$( cd -- "$1" 2>/dev/null && pwd && printf X )" || { printf '%s' "$1"; return 0; }
      abs_out="${abs_out%X}"
      abs_out="${abs_out%?}"
      printf '%s' "$abs_out"
      ;;
  esac
}
physdir() {
  # Prints the physically-resolved directory followed by a literal `X`, or
  # returns 1 and prints nothing.
  #
  # ⚠ TWO SUBSTITUTIONS EAT THE SAME BYTE, SO BOTH ARE SENTINELLED. A directory
  # name may end in a newline -- `mkdir "$PWD/w<NL>"` is an ordinary directory --
  # and `$( )` strips EVERY trailing newline, not one. The inner sentinel
  # separates the name's last byte from the one `pwd` appends; the `X` this
  # function prints does the same for the CALLER's assignment, which would
  # otherwise eat it a second time (shardpilot/shardpilot-go#79 review).
  pd_out="$( cd -- "$1" 2>/dev/null && pwd -P && printf X )" || return 1
  pd_out="${pd_out%X}"
  pd_out="${pd_out%$NL}"
  printf '%sX' "$pd_out"
}
if [ -n "${GIT_OBJECT_DIRECTORY:-}" ]; then
  # ⚠ THE SAME SENTINEL AS THE LIST BELOW. The round before put it on the
  # alternates call site and not on this one -- fixed where I was shown -- so an
  # object directory whose name ends in a newline was silently trimmed here and
  # the hook pointed git at a directory that does not exist
  # (shardpilot/shardpilot-go#86 review). The sibling of a site you just repaired
  # is the first place to look, and it is cheaper to look than to be told.
  GIT_OBJECT_DIRECTORY="$(absolutize_one "$GIT_OBJECT_DIRECTORY"; printf X)"
  GIT_OBJECT_DIRECTORY="${GIT_OBJECT_DIRECTORY%X}"
  export GIT_OBJECT_DIRECTORY
fi
# ⚠ AND `GIT_ALTERNATE_OBJECT_DIRECTORIES` IS A LIST. It is colon-separated, so
# passing the whole value to one `cd` failed and assigned empty -- making commits
# stored only in those alternates unreadable and refusing an otherwise supported
# push (shardpilot/shardpilot-go#79 review). A variable whose name is plural was
# treated as a path.
if [ -n "${GIT_ALTERNATE_OBJECT_DIRECTORIES:-}" ]; then
  alt_out=""
  alt_rest="$GIT_ALTERNATE_OBJECT_DIRECTORIES"
  while [ -n "$alt_rest" ]; do
    # ⚠ A QUOTED ENTRY OWNS ITS COLONS. git documents that an entry beginning with
    # a double quote is a C-quoted path, so `"objects:shared"` is ONE directory --
    # and splitting on every colon cut it into two entries that name nothing, so
    # neither half was absolutized, the reconstructed relative value changed meaning
    # inside the temporary worktree, and objects reachable only through that legal
    # alternate became unreadable (shardpilot/shardpilot-go#86 review). The
    # separator is found by walking, not by `%%:*`, because where it IS depends on
    # the quoting.
    case "$alt_rest" in
      '"'*)
        alt_one=""
        alt_scan="${alt_rest#\"}"
        while [ -n "$alt_scan" ]; do
          alt_c="${alt_scan%"${alt_scan#?}"}"
          alt_scan="${alt_scan#?}"
          case "$alt_c" in
            '\') alt_one="$alt_one$alt_c${alt_scan%"${alt_scan#?}"}"; alt_scan="${alt_scan#?}" ;;
            '"') break ;;
            *) alt_one="$alt_one$alt_c" ;;
          esac
        done
        # The unquoted spelling is what `cd` needs; the escapes are undone by the
        # same rule git wrote them under.
        alt_one="$(printf '%b' "$alt_one"; printf X)"
        alt_one="${alt_one%X}"
        alt_rest="${alt_scan#:}"
        ;;
      *:*) alt_one="${alt_rest%%:*}"; alt_rest="${alt_rest#*:}" ;;
      *) alt_one="$alt_rest"; alt_rest="" ;;
    esac
    # ⚠ THE SENTINEL BELONGS AT THE CALL SITE TOO. Putting it only inside
    # `absolutize_one` fixes nothing: THIS substitution strips the trailing newline
    # again, and my first measurement of the fix could not see that because the rig
    # wrapped the call in a substitution of its own -- so the instrument had the
    # defect under test (shardpilot/shardpilot-go#86 review).
    alt_abs="$(absolutize_one "$alt_one"; printf X)"
    alt_abs="${alt_abs%X}"
    # ⚠ AND IT GOES BACK IN QUOTED, or the parse was for nothing. Reading a quoted
    # entry and re-emitting it BARE hands git a value it splits at the same colon
    # this loop just refused to split at -- so `"objects:shared"` was parsed
    # correctly, absolutized correctly, and then published as two directories
    # neither of which exists. Preserving a value and preserving its MEANING are
    # two steps, which is the sentence written thirty lines above this one about
    # this same variable (shardpilot/shardpilot-go#86 review).
    case "$alt_abs" in
      *:*|*'"'*|*'\'*) alt_abs="$(cquote_alt "$alt_abs")" ;;
    esac
    if [ -z "$alt_out" ]; then
      alt_out="$alt_abs"
    else
      alt_out="$alt_out:$alt_abs"
    fi
  done
  GIT_ALTERNATE_OBJECT_DIRECTORIES="$alt_out"
  export GIT_ALTERNATE_OBJECT_DIRECTORIES
  unset alt_out alt_rest alt_one alt_abs
fi

# ⚠ A GRAFT HIDES A PUBLISHED ANCESTOR, AND `GIT_NO_REPLACE_OBJECTS` DOES NOT STOP
# IT. With the pushed tip marked a synthetic root, `rev-list` omits the real parent
# even with replacement objects disabled -- so if the destination still holds that
# parent, pushing the child makes it publicly reachable again while the scan walked
# only the child (shardpilot/shardpilot-go#79 review). The two mechanisms are
# separate and the gate needs both off.
GIT_GRAFT_FILE=/dev/null
export GIT_GRAFT_FILE

# ⚠ AND A SHALLOW BOUNDARY, WHICH IS THE THIRD MECHANISM THAT HIDES AN ANCESTOR.
# `GIT_SHALLOW_FILE` marks the pushed tip as a root for `rev-list` and for
# `merge-base --is-ancestor` alike, so if the destination retains the real parent as
# an unadvertised object, pushing the child makes it reachable again while the gate
# walks only the child (shardpilot/shardpilot-go#79 review). Replacement objects,
# grafts and shallow files are three separate switches for one effect, and I had
# turned off two.
GIT_SHALLOW_FILE=/dev/null
export GIT_SHALLOW_FILE

# ⚠ NOTHING FROM THE PUSHED BRANCH MAY RUN. `git worktree add` fires
# post-checkout, and where core.hooksPath still points at tracked content that hook is
# TRACKED CONTENT -- so a branch from an untrusted contributor would execute
# arbitrary code on this machine merely by being inspected, before any scan.
# Every git command below runs with hooks pointed at an empty directory.
# ⚠ AND THE SEARCH PATH IS SANITISED BEFORE THE FIRST BARE COMMAND. `.` and an
# empty component both mean "the current directory", which git has just set to the
# worktree root; a relative entry means whatever the checkout says it means. They
# are dropped rather than the whole PATH replaced, because a developer's toolchain
# may legitimately live somewhere unusual and a gate that cannot find `git` is a
# gate that gets uninstalled.
# ⚠ AND AN ABSOLUTE ENTRY CAN STILL BE INSIDE THE CHECKOUT. `PATH="$PWD/bin:/usr/bin"`
# passes a test that asks only whether a component starts with `/`, and a branch
# supplying `bin/git` then gains execution at the first bare command
# (shardpilot/shardpilot-go#79 review). "Absolute" was a proxy for "outside the
# tree", and the property is the second one.
#
# Git runs a non-bare pre-push hook with the WORKTREE ROOT as its working
# directory, so `pwd -P` gives that root without running anything -- which matters,
# because this filter has to be finished before the first external command.
# Everything here is a shell builtin for the same reason.
# ⚠ SENTINELLED, LIKE `physdir`. A directory name may END IN A NEWLINE, and `$( )`
# strips every trailing one -- so a checkout at `/tmp/w<NL>` gave a root of
# `/tmp/w` while a PATH entry of `/tmp/w<NL>/bin` kept its newline (it is not
# trailing there), the containment match missed, and a branch-supplied `bin/git`
# stayed on PATH to be executed before the trusted scanner
# (shardpilot/shardpilot-go#79 review). The technique was already in this file;
# this site was written before it and never revisited. `pwd` and `printf` are
# builtins, so the filter is still finished before the first external command.
checkout_root="$(pwd -P && printf X)"
checkout_root="${checkout_root%X}"
checkout_root="${checkout_root%$NL}"

# ⚠ AND THE OTHER CHECKOUTS TOO. An absolute PATH entry inside ANOTHER linked
# worktree -- the main checkout's `bin` while pushing from a feature worktree -- is
# branch-controlled exactly as this one is, and dropping only the invoking
# checkout's entries left it to supply `bin/mktemp` or `bin/git` for the first
# external command this hook runs (shardpilot/shardpilot-go#79 review). Executable
# search paths are the same question as the shared hooks directory, one round later.
#
# ⚠ WITH BUILTINS, BECAUSE `git worktree list` IS ITSELF AN EXTERNAL COMMAND. Asking
# git which checkouts exist would run the binary this filter is meant to choose. So
# the roots are read the way git records them: for a linked worktree `GIT_DIR` names
# `<common>/worktrees/<name>`, and every checkout has a `gitdir` file there naming
# its own root. Measured: git leaves `GIT_DIR` unset for a hook in the MAIN
# worktree and sets it in a linked one, and the cwd is the invoking root in both.
#
# What this pass cannot see is stated where it is enforced: see the second filter
# after the enumeration below.
# ⚠ AN ARRAY, BECAUSE THE DELIMITER WOULD BE PART OF THE DATA. The first version
# joined these roots with a NEWLINE -- and the whole reason this list exists is that
# a worktree path may CONTAIN one, so a root named `other<NL>root` was split into two
# entries that match nothing and the PATH entry beneath it survived. The scene for
# the newline case reported it immediately (shardpilot/shardpilot-go#79 review). A
# separator drawn from the same alphabet as the values is not a separator.
other_roots=()
wt_common=""
if [ -n "${GIT_DIR:-}" ]; then
  wt_common="$GIT_DIR"
elif [ -f "$checkout_root/.git" ]; then
  # `.git` is a FILE here, holding `gitdir: <path>`.
  #
  # ⚠ NOT ONE LINE. A pathname may contain a newline, and a line-oriented read
  # keeps only its prefix -- so the gate resolves the wrong common directory from
  # the very file that names it (shardpilot/shardpilot-go#79 review). Read to EOF,
  # like the two sites below that already carry this fix.
  #
  # ⚠ AND `|| true`, NOT `|| var=""`. `read -d ""` returns NON-ZERO at EOF with the
  # content already in the variable, so the old failure branch would have wiped a
  # successful read.
  wt_gitline=""
  IFS= read -r -d "" wt_gitline < "$checkout_root/.git" || true
  wt_gitline="${wt_gitline%$NL}"
  case "$wt_gitline" in
    "gitdir: "*) wt_common="${wt_gitline#gitdir: }" ;;
  esac
elif [ -d "$checkout_root/.git" ]; then
  wt_common="$checkout_root/.git"
fi
case "$wt_common" in
  ""|/*) ;;
  *) wt_common="$checkout_root/$wt_common" ;;
esac
case "$wt_common" in
  */worktrees/*) wt_common="${wt_common%/worktrees/*}" ;;
esac
if [ -n "$wt_common" ]; then
  case "$wt_common" in
    */.git)
      wt_main="${wt_common%/.git}"
      if wt_phys_main="$(physdir "$wt_main")"; then
        wt_main="${wt_phys_main%X}"
      fi
      other_roots+=("$wt_main")
      ;;
  esac
  for wt_gd in "$wt_common"/worktrees/*/gitdir; do
    [ -f "$wt_gd" ] || continue
    # ⚠ THE WHOLE FILE, NOT ITS FIRST LINE. A worktree path may CONTAIN a newline --
    # `other<NL>root` is an ordinary directory name -- and `read -r` stops at it, so
    # the root this pass compared against was a prefix and a PATH entry beneath the
    # real one stayed: its `bin/mktemp` ran twice before the NUL-delimited enumeration
    # later noticed and refused (shardpilot/shardpilot-go#79 review). `read -d ''`
    # stops at NUL, of which there is none, so it reads to EOF and returns non-zero
    # with the whole content in the variable -- which is why the status is discarded
    # here rather than used as a failure.
    wt_line=""
    IFS= read -r -d "" wt_line < "$wt_gd" || true
    [ -n "$wt_line" ] || continue
    wt_line="${wt_line%$NL}"
    case "$wt_line" in
      ""|/*) ;;
      *) wt_line="$wt_common/$wt_line" ;;
    esac
    case "$wt_line" in
      */.git) wt_line="${wt_line%/.git}" ;;
    esac
    # ⚠ PHYSICALLY, LIKE THE PATH ENTRIES THEY ARE COMPARED WITH. The `gitdir` file
    # holds the LOGICAL path git was given -- `/var/folders/...` on this platform --
    # while an entry resolved with `physdir` comes back as `/private/var/folders/...`,
    # so the two never matched and the root was collected and then never used
    # (shardpilot/shardpilot-go#79 review). Two spellings of one directory compared as
    # strings is the same defect as two spellings of one decoder.
    if wt_phys_root="$(physdir "$wt_line")"; then
      wt_line="${wt_phys_root%X}"
    fi
    [ -n "$wt_line" ] && other_roots+=("$wt_line")
  done
fi
# ⚠ REFUSED HERE, BEFORE THE FIRST EXTERNAL COMMAND. The same refusal used to sit
# after the enumeration -- which is after `mktemp` and several bare `git` calls have
# already resolved through PATH, so a tracked `<main>/bin/mktemp` executed and only
# then was the push refused: the branch got its code run and the refusal was a
# consolation (shardpilot/shardpilot-go#79 review). A guard against execution has to
# precede execution; everything it needs is above and all of it is builtin.
if [ -n "$wt_common" ]; then
  wt_common_is_dotgit=no
  case "$wt_common" in */.git) wt_common_is_dotgit=yes ;; esac
  # ⚠ UNSOUND, AND NOT REPAIRED HERE. AN OPEN FINDING, STATED RATHER THAN CLOSED.
  #
  # An external git directory may legally be named `.git` -- main checkout
  # `/tmp/main`, common directory `/tmp/store/.git` -- and this suffix test then
  # calls it an ordinary layout and skips the owner guard entirely, so a PATH entry
  # under `/tmp/main/bin` survives to supply the first `git` or `mktemp`
  # (shardpilot/shardpilot-go#79 review).
  #
  # The review's remedy is "determine ownership from the resolved layout rather than
  # the basename". I could not: MEASURED, the two layouts are indistinguishable from
  # inside the git directory. Their `config` files are byte-identical,
  # `core.worktree` is unset in both -- there is no back-pointer, which this file
  # already records one guard down -- and `git worktree list` reports `/tmp/store`,
  # the git directory's PARENT, rather than the checkout `/tmp/main`, so the later
  # enumeration does not name it either.
  #
  # The two sound remedies both cost something this file has already refused to pay,
  # so the choice is the reviewer's rather than mine:
  #
  #   1. Refuse every `/.git`-suffixed common directory the INVOKING checkout does
  #      not own directly. Sound, and it refuses an ordinary push from a LINKED
  #      worktree -- which is how every lane in this workspace works, and B and C
  #      are indistinguishable from the invoking side too.
  #   2. Move the decision after the PATH filter, where `git worktree list` can be
  #      consulted. This file's own rule says a guard that runs after the thing it
  #      guards is a consolation, and the first `mktemp` has already resolved by
  #      then.
  #
  # Narrowing what IS provable, without the false refusal of (1): the exemption is
  # unchanged where the invoking checkout owns the directory outright, and the
  # gap above is the linked-worktree case in both layouts. It is written here so
  # the next reader does not have to rediscover that the basename was load-bearing.
  if [ "$wt_common_is_dotgit" = no ]; then
    # A separate git directory. Its checkout is discoverable only from the CHECKOUT
    # side, so unless this one owns it, there is a checkout on this machine whose
    # root cannot be named -- and a PATH entry inside it cannot be ruled out.
    wt_owns=no
    if [ -d "$checkout_root/.git" ]; then
      [ "$checkout_root/.git" = "$wt_common" ] && wt_owns=yes
    elif [ -f "$checkout_root/.git" ]; then
      wt_own_line=""
      IFS= read -r -d "" wt_own_line < "$checkout_root/.git" || true
      wt_own_line="${wt_own_line%$NL}"
      [ "$wt_own_line" = "gitdir: $wt_common" ] && wt_owns=yes
    fi
    # ⚠ AND A BARE REPOSITORY HAS NO CHECKOUT TO NAME, so this guard's own premise
    # does not hold for it. `git --git-dir=/tmp/local.git push` was refused with
    # "whose checkout this gate cannot name" -- reproduced -- even though there is
    # no worktree there whose contents could be on PATH
    # (shardpilot/shardpilot-go#79 review). The refusal is about ruling out a PATH
    # entry INSIDE a checkout; with no checkout there is nothing to rule out.
    #
    # ⚠ READ, NOT ASKED. The later `--is-bare-repository` check runs `git`, and this
    # gate is the one that decides "before any command is run" -- calling git here
    # would put the question ahead of the filter that makes its answer trustworthy,
    # which is the defect this file recorded when a repair called `git rev-parse`
    # before the sanitiser. So the config file is PARSED with builtins.
    #
    # ⚠ AND THE CONFIG IS NOT BRANCH-SUPPLIED. `config` is never a tracked file, so
    # it is under the same control as PATH itself and is not the thing this hook
    # defends against; the branch being pushed cannot reach it. Measured as the only
    # structural difference: a bare repository writes `bare = true`, and a
    # `--separate-git-dir` one writes `bare = false` and no `core.worktree` at all,
    # so the two are otherwise identical from inside the git directory.
    #
    # ⚠ AND THE THIRD CORRECTION TO THIS PARSER IS THE SIGNAL, NOT THE THIRD
    # EXAMPLE. Two rounds narrowed it by the shape of the case that had arrived --
    # first folding the names, then matching them WHOLE instead of by prefix -- and
    # a third arrived: an `[include]` file overriding `core.bare` to false, which
    # git honours and this read straight past, taking the exemption on a repository
    # git calls non-bare (shardpilot/shardpilot-go#79 review). Adding an
    # `[include]` case would be the third narrowing of one predicate, and this file
    # already records what that means.
    #
    # The subject is not "which spellings must I skip". It is: THIS EXEMPTION MAY
    # BE TAKEN ONLY FROM A FILE THIS PARSER ACCOUNTED FOR IN FULL. The exemption
    # WIDENS what is allowed, so being more permissive than git is a hole and being
    # stricter is only an inconvenience. So the parse now reports whether every
    # line it passed was one whose effect it reproduces, and the exemption is
    # declined otherwise -- which cannot be outrun by a git version that grows
    # another construct.
    #
    # ⚠ MEASURED AGAINST GIT, NOT AGAINST MY EXPECTATIONS, over fifteen configs
    # built and then handed to `git rev-parse --is-bare-repository`. The reviewer
    # named ONE escape; the run found THREE: `[include]`, `[includeIf]`, and a
    # same-line `[core] bare = false`, which git honours and the old loop skipped
    # because it read any line starting with `[` as a section header and nothing
    # else. All three are now declined, and the ordinary bare repositories --
    # plain, `[Core]`-folded, comment-carrying, `[remote "origin"]`-carrying,
    # CRLF, and `[core "sub"]`-carrying -- still take the exemption.
    #
    # Two things this deliberately does NOT do. It does not fold the VALUE, so
    # `bare = "true"` and `bare = TRUE` decline where git accepts; that is the safe
    # direction and widening it is a separate decision. And external config layering
    # is not read -- measured as irrelevant here: a global `core.bare` neither makes
    # a non-bare repository bare nor a bare one non-bare.
    # >>> BARE-EXEMPTION PARSE. scripts/test_prepush_bare_exemption.sh lifts the
    # lines between these two markers and runs them against real repositories,
    # comparing the verdict with git's own `--is-bare-repository`. It tests THIS
    # text, not a copy of it: a fixture that re-assembles the logic in its own body
    # passes while the site does something else, which this repository has paid for
    # five times. Moving or renaming the markers makes that test refuse.
    wt_is_bare=no
    wt_cfg_modelled=yes
    if [ -r "$wt_common/config" ]; then
      wt_sect=""
      while IFS= read -r wt_cl || [ -n "$wt_cl" ]; do
        wt_ct="${wt_cl#"${wt_cl%%[![:space:]]*}"}"
        # Trailing whitespace off as well, so "a section header ALONE on its line"
        # is decidable -- and CR with it, because a config written on another
        # platform is still git's to read.
        while :; do
          case "$wt_ct" in
            *" "|*"$TAB"|*"$CR") wt_ct="${wt_ct%?}" ;;
            *) break ;;
          esac
        done
        case "$wt_ct" in
          ""|"#"*|";"*) continue ;;
        esac
        # A value continued onto the next line makes the NEXT line part of this
        # one, which this loop does not follow.
        case "$wt_ct" in
          *\\) wt_cfg_modelled=no; continue ;;
        esac
        case "$wt_ct" in
          "["*"]") wt_sect="$wt_ct"
            # The one construct in git's grammar whose effect is ANOTHER WHOLE
            # CONFIG. Not a spelling to skip: a file this parser has not read
            # cannot be a file it accounted for. The names are matched exactly,
            # so an ordinary `[includes]` section is still modelled.
            case "$wt_sect" in
              # `include` WHOLE, so an ordinary `[includes]` is still modelled --
              # the lesson two rounds up. `includeif` by PREFIX, because it always
              # carries a subsection and the two spellings of that subsection are
              # not the subject: over-matching here only DECLINES an exemption,
              # which is the direction that costs nothing.
              "["[Ii][Nn][Cc][Ll][Uu][Dd][Ee]"]"|"["[Ii][Nn][Cc][Ll][Uu][Dd][Ee][Ii][Ff]*)
                wt_cfg_modelled=no ;;
            esac
            ;;
          # A header with a value after the closing bracket -- `[core] bare = false`,
          # which git reads as both. The old loop consumed the whole line as a
          # section name and never saw the assignment.
          "["*) wt_cfg_modelled=no ;;
          # ⚠ AN EXACT NAME, NOT A PREFIX. Git config names fold but they are NAMES:
          # `bareRepository = true` standing after the ordinary `bare = false` was
          # read as `core.bare` by this pattern, and the repository was marked bare --
          # bypassing the unresolved-checkout guard so a PATH entry inside an
          # externally owned main checkout could supply the next `git` or `mktemp`
          # (shardpilot/shardpilot-go#79 review). The previous round made this fold
          # and left it a prefix: two narrowings of one predicate, each describing the
          # kind of the example that had arrived. The name is extracted and compared
          # WHOLE now, which is the property.
          *=*)
            # ⚠ SECTION AND VARIABLE NAMES FOLD, and this compared them literally --
            # so a bare repository written `[Core]`, which git reads exactly as
            # `[core]`, left `wt_is_bare=no` and an ordinarily named `/tmp/repo.git`
            # was refused by the checkout-owner guard (shardpilot/shardpilot-go#79
            # review). The PATTERNS fold here rather than the strings, because folding
            # a string needs a command and this runs before the PATH filter.
            wt_cn="${wt_ct%%=*}"
            while :; do
              case "$wt_cn" in
                *" "|*"$TAB") wt_cn="${wt_cn%?}" ;;
                *) break ;;
              esac
            done
            case "$wt_cn" in
              [Bb][Aa][Rr][Ee]) ;;
              *) continue ;;
            esac
            case "$wt_sect" in
              "["[Cc][Oo][Rr][Ee]"]")
                wt_cv="${wt_ct#*=}"
                wt_cv="${wt_cv#"${wt_cv%%[![:space:]]*}"}"
                case "$wt_cv" in
                  true*|yes*|on*|1*) wt_is_bare=yes ;;
                  *) wt_is_bare=no ;;
                esac
                ;;
            esac
            ;;
          # Neither a header nor an assignment. Git may or may not accept it; what
          # matters here is that this loop did not reproduce its effect.
          *) wt_cfg_modelled=no ;;
        esac
      done < "$wt_common/config"
      unset wt_sect wt_cl wt_ct wt_cv wt_cn
    fi
    # <<< BARE-EXEMPTION PARSE
    # ⚠ AND THE EXEMPTION IS THE PARSE'S TO GIVE ONLY WHEN THE PARSE WAS COMPLETE.
    # `wt_is_bare=yes` from a file carrying a construct this loop skipped is a
    # guess, and this is the guard that decides before any command runs.
    # ⚠ AND THE FILE WAS NOT THE ONLY SOURCE. `git -c core.bare=false push` makes git
    # operate on a non-bare worktree while this parser reads `true` from the file, so
    # the exemption skipped the unresolved-checkout guard and left a tracked
    # `<main>/bin` on PATH for the first external command
    # (shardpilot/shardpilot-go#79 review, reproduced). Parsing that environment would
    # be a second grammar to reimplement -- its quoting differs by git version -- and
    # the exemption only ever WIDENS, so the honest answer is that the parse cannot
    # claim completeness and the exemption is not taken.
    if [ "$wt_owns" = no ] && [ "$wt_is_bare" = yes ] && [ "$wt_cfg_modelled" = yes ] &&
       [ "$sp_cfg_env" = no ]; then
      wt_owns=yes
    fi
    if [ "$wt_owns" = no ]; then
      printf 'REFUSING: %s is a git directory whose checkout this gate cannot name.\n' "$wt_common" >&2
      printf '  A separate git directory records no path back to its worktree, so a\n' >&2
      printf '  PATH entry inside that checkout cannot be ruled out -- and this is\n' >&2
      printf '  decided before any command is run, so nothing from it has executed.\n' >&2
      printf '  Push from the main checkout, or keep the git directory inside it.\n' >&2
      if [ "$wt_is_bare" = yes ] && [ "$sp_cfg_env" = yes ]; then
        printf '  This config says bare, but the push carries configuration in its\n' >&2
        printf '  environment -- a `git -c ...`, or GIT_CONFIG_* -- which outranks the\n' >&2
        printf '  file and can make git disagree with what is read here. Push without\n' >&2
        printf '  it, or from the main checkout.\n' >&2
      elif [ "$wt_is_bare" = yes ] && [ "$wt_cfg_modelled" = no ]; then
        printf '  This config says bare, but it also carries a construct this gate\n' >&2
        printf '  does not read -- an include, a continued line, or a setting beside\n' >&2
        printf '  a section header -- so what git makes of it is not knowable here,\n' >&2
        printf '  and the bare-repository exemption is not taken on a guess.\n' >&2
      fi
      exit 2
    fi
  fi
fi

# >>> INSIDE-A-CHECKOUT. scripts/test_prepush_bare_exemption.sh lifts the lines
# between these markers. Moving or renaming the markers makes that test refuse.
inside_a_checkout() {
  # $1 is a physically-resolved directory. True when it lies in the invoking
  # checkout or in any other checkout this pass could name.
  #
  # ⚠ THE ROOT IS A CHECKOUT TOO, AND `"$root"/` IS `//` THERE. With the invoking
  # checkout at `/`, this prefix became `//` and matched no absolute path at all --
  # so a tracked `/workspace/bin` on PATH was not seen as checkout-controlled and
  # was left there for the first `mktemp` or `git`. The later enumeration does
  # normalise `/` and refuses, but only AFTER that program has run
  # (shardpilot/shardpilot-go#79 review), which is this file's own recorded lesson:
  # a guard that runs after the thing it guards is a consolation.
  #
  # `check_path_outside` already carried the normalisation. Both prefixes here are
  # built the same way now -- the review named the first, and `other_roots` has the
  # identical shape, so fixing only the named one would leave the same hole for a
  # linked worktree rooted at `/`.
  ir_prefix="$checkout_root/"
  case "$ir_prefix" in //) ir_prefix=/ ;; esac
  case "$1/" in
    "$ir_prefix"*) return 0 ;;
  esac
  [ "$1" = "$checkout_root" ] && return 0
  if [ "${#other_roots[@]}" -gt 0 ]; then
    for ir_one in "${other_roots[@]}"; do
      [ -n "$ir_one" ] || continue
      ir_prefix="$ir_one/"
      case "$ir_prefix" in //) ir_prefix=/ ;; esac
      case "$1/" in
        "$ir_prefix"*) return 0 ;;
      esac
      [ "$1" = "$ir_one" ] && return 0
    done
  fi
  return 1
}
# <<< INSIDE-A-CHECKOUT
sanitised_path=""
dropped_inside=no
old_ifs="$IFS"
IFS=:
# ⚠ AND PATHNAME GENERATION IS OFF WHILE SPLITTING. `$PATH` unquoted is split AND
# globbed, while executable lookup treats those bytes literally -- so a literal
# component `/opt/tool[12]/bin` was rewritten into every matching `/opt/tool1/bin`
# and `/opt/tool2/bin`, and this gate judged directories that were never on the
# caller's PATH while missing the one that was (shardpilot/shardpilot-go#79 review).
# The separator is what splitting is for; the glob is a second grammar nobody asked
# for here.
set -f
for path_entry in $PATH; do
  case "$path_entry" in
    /*) ;;
    *) continue ;;
  esac
  # Resolved physically, so a symlink pointing into the checkout is caught too.
  if entry_phys="$(physdir "$path_entry")"; then
    entry_phys="${entry_phys%X}"
  else
    entry_phys="$path_entry"
  fi
  if inside_a_checkout "$entry_phys"; then
    dropped_inside=yes
    continue
  fi
  sanitised_path="${sanitised_path:+$sanitised_path:}$path_entry"
done
set +f
IFS="$old_ifs"
if [ -z "$sanitised_path" ]; then
  printf 'REFUSING: PATH contains no absolute directory, so no utility this gate\n' >&2
  printf '  runs can be resolved from outside the checkout.\n' >&2
  exit 2
fi
PATH="$sanitised_path"
export PATH
if [ "$dropped_inside" = yes ]; then
  printf 'note: PATH entries inside this checkout were dropped for this hook.\n' >&2
fi

# ⚠ REDIRECTING `core.hooksPath` DOES NOT DISABLE THE OTHER FACILITIES THAT RUN A
# PROGRAM. `core.fsmonitor` is documented as a hook command, and `git diff --quiet
# HEAD --` invokes it: reproduced, a tracked `./fsmon` executed before the trusted
# scanner ran, so a branch gained local code execution merely by being PUSHED
# (shardpilot/shardpilot-go#79 review). `git worktree add --no-checkout` closes the
# filter-driver route; this is the same class through a different door.
#
# ⚠ AND THE REVIEW NAMED ONE KEY OF SEVERAL. Measured on the same command, with
# `core.fsmonitor` already neutralised: a `diff.<name>.textconv` fired, and so did a
# `filter.<name>.clean`. `core.attributesFile=/dev/null` does NOT stop them -- the
# driver is selected by the IN-TREE `.gitattributes`, which the pushed branch owns.
#
# So the key names cannot be typed here: `<name>` is arbitrary. But they are BOUNDED
# BY THE CONFIG, and the config is not branch-supplied -- this file already relies
# on that, one guard up: "`config` is never a tracked file, so it is under the same
# control as PATH itself". What the branch owns is the SELECTION and the program the
# value points at. So the set is DERIVED from the config rather than enumerated from
# memory, and every configured key whose value git executes is emptied.
#
# In the ENVIRONMENT, not on a wrapper: `git_safe` covers sixteen call sites and the
# bare `git diff` that carries this defect is not one of them. An override every
# invocation inherits cannot be bypassed by adding a call site.
#
# ⚠ AND THE SUFFIX LIST WENT THE SAME WAY AS THE DRIVER NAMES. It read
# `clean|smudge`, and `filter.<name>.process` -- the standard long-running form --
# fired straight through it with `core.fsmonitor` already neutralised, measured
# (shardpilot/shardpilot-go#79 review). Adding `process` would be the same
# enumeration one level down, in the half of the key I had left enumerated.
#
# A DRIVER SECTION EXISTS TO CONFIGURE A PROGRAM, so every key in one is cleared and
# there is no suffix to keep current. `filter.<n>.required` is emptied with the rest,
# which is harmless: the driver it guards is emptied too. Single-component keys like
# `diff.algorithm` need two dots to match and are untouched.
#
# `git config --list` was measured not to run any of these itself, which is what
# makes reading the list a safe first step.
unset GIT_CONFIG_COUNT 2>/dev/null || true
sp_cfg_keys="$(git config --list --name-only 2>/dev/null |
  grep -E '^(core\.fsmonitor|core\.alternaterefscommand|core\.gitproxy|(diff|filter|merge)\.[^.]+\..+)$' |
  sort -u || true)"
sp_cfg_n=0
sp_seen=""
# ⚠ AND PATHNAME GENERATION IS OFF WHILE SPLITTING, FOR THE SECOND TIME IN THIS
# FILE. The PATH loop above learned this and turns it off at line ~870; `set +f`
# restores it eighteen lines later, and this enumeration -- written afterwards --
# splits an unquoted list with globbing live. A driver name may contain a pattern
# character: `filter.x*.clean` is a legal key, and a TRACKED file named
# `filter.xZ.clean` makes this loop export an override for the file's name while
# leaving the real key active, so the `git diff` below runs the branch's program
# (shardpilot/shardpilot-go#79 review). The separator is what splitting is for; the
# glob is a second grammar nobody asked for here, and the branch controls the
# directory this expands in.
set -f
# `core.fsmonitor` is emptied whether or not it is currently set, so a value added
# between this read and the commands below cannot arrive unanswered.
for sp_k in core.fsmonitor $sp_cfg_keys; do
  case " $sp_seen " in *" $sp_k "*) continue ;; esac
  sp_seen="$sp_seen $sp_k"
  eval "export GIT_CONFIG_KEY_$sp_cfg_n=\"\$sp_k\""
  eval "export GIT_CONFIG_VALUE_$sp_cfg_n=''"
  sp_cfg_n=$((sp_cfg_n + 1))
done
set +f
GIT_CONFIG_COUNT="$sp_cfg_n"
export GIT_CONFIG_COUNT
unset sp_cfg_keys sp_k sp_seen

hooks_off="$(mktemp -d)"
# ⚠ THE TRAP GOES ON AS SOON AS THERE IS SOMETHING TO CLEAN. Everything between
# this line and the `trap` below can exit -- the second `mktemp`, resolving it,
# preparing the private object store -- and each of those paths left the first
# directory behind, on every retry, under the comment that states the cleanup
# invariant (shardpilot/shardpilot-go#79 review). The handler names variables that
# may not exist yet, so it reads them with defaults; a cleanup that assumes the
# state it is cleaning up is a cleanup for the successful path only.
cleanup() {
  # ⚠ A DEFAULT THAT YIELDS A VALID ABSOLUTE PATH IS NOT A TOLERANT DEFAULT.
  # `${tmpdir:-}/wt` expands to `/wt` before the second `mktemp` has run, and
  # `worktree remove --force` deletes a linked worktree there -- untracked files
  # included -- so the handler written to survive an unbuilt state could destroy an
  # unrelated one (shardpilot/shardpilot-go#79 review). The guard is on the
  # VARIABLE, not on the string it composes.
  if [ -n "${tmpdir:-}" ]; then
    git_safe worktree remove --force "$tmpdir/wt" >/dev/null 2>&1 || true
  fi
  [ -n "${tmpdir:-}" ] && rm -rf "$tmpdir"
  [ -n "${hooks_off:-}" ] && rm -rf "$hooks_off"
  # ⚠ NO GLOBAL PRUNE. `git worktree prune` removes the administrative record of
  # EVERY missing worktree, not only this one -- so an unrelated worktree on a
  # temporarily disconnected mount lost its metadata, and came back as "not a
  # repository" (shardpilot/shardpilot-go#79 review). Cleanup removes what this
  # hook created and nothing else.
  # Through `git_safe`, like the normal deletion: the stated invariant is that
  # nothing this hook runs fires a repository hook, and an EXIT path that skips
  # the wrapper is the invariant holding only when nothing goes wrong
  # (shardpilot/shardpilot-go#79 review).
  [ -n "${base_ref:-}" ] && git_safe update-ref -d "$base_ref" 2>/dev/null || true
}
trap cleanup EXIT
git_safe() { git -c core.hooksPath="$hooks_off" "$@"; }

# in_worktree runs a git command INSIDE the scan worktree.
#
# ⚠ `cd` CHANGES THE DIRECTORY AND NOTHING ELSE, AND THE SELECTOR OUTRANKS IT. This
# hook clears every INHERITED repository selector and then resolves and re-exports
# `GIT_DIR` for the repository being pushed -- correctly, because the outer commands
# have to know which repository that is. Nobody asked what it means after `cd "$wt"`:
# it means `read-tree` writes the INVOKING repository's index, and the `update-index`
# calls and scanner fixtures after it keep targeting that repository -- replacing a
# developer's staged work with a historical tree plus synthetic evidence
# (shardpilot/shardpilot-go#79 review). That is the second time in this file that a
# selector's damage lands OUTSIDE the push it refuses, and the first was the
# inherited half of the same variable.
#
# The object stores stay: they say where objects LIVE, not which repository a command
# means, and the commits under inspection may exist only there. They were made
# absolute two hundred lines up for exactly this crossing.
#
# One wrapper, six call sites. The count of sites is the thing that keeps being
# wrong in this file, so the sites do not get to spell this themselves.
in_worktree() {
	( cd "$wt" && unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE && git_safe "$@" )
}

# git_probe runs a git command whose OUTPUT is the answer, and refuses when the
# command FAILED. It sets `PROBE_OUT`; it does not return a value, because a helper
# that exits from inside `$( … )` exits the SUBSHELL and the gate reads the empty
# result as an answer -- which is the very defect this exists to stop.
#
# ⚠ A PROBE'S STATUS IS NOT ITS ANSWER, and this file has now been shown five
# instances of the same sentence: `! git diff --quiet` in a bare repository, where
# the FATAL error read as "the working tree differs"; the HEAD advertisement, whose
# failure read as "no default branch"; and the three below. Each was repaired where
# it was shown, which is repairing instances. The predicate lives here now, so a
# site that means to treat a failure AS an answer has to say so by not calling this.
#
# ⚠ WHAT THE POPULATION ACTUALLY IS, greped rather than recalled: ten sites in this
# file convert a git status into a value. FIVE of them fail CLOSED -- the empty
# value reaches a refusal (`real_objects`, `head_sha`, `--is-bare-repository`, the
# baseline pair at the fetch, and the scan-target scaffold, whose absence is a
# legitimate answer). TWO already refuse on failure and are the pattern this copies.
# The remaining three are below, and they are the ones a reader should check first
# when adding a fourth.
git_probe() { # git_probe <what> <git command...>
  gp_what="$1"; shift
  gp_rc=0
  PROBE_OUT="$( "$@" 2>/dev/null && printf X )" || gp_rc=$?
  PROBE_OUT="${PROBE_OUT%X}"
  PROBE_OUT="${PROBE_OUT%$NL}"
  if [ "$gp_rc" -ne 0 ]; then
    printf 'REFUSING: %s could not be read (git exited %s).\n' "$gp_what" "$gp_rc" >&2
    printf '  A probe that FAILED prints nothing, and nothing would be read here as\n' >&2
    printf '  an answer -- so this gate cannot speak for what it was asked.\n' >&2
    exit 2
  fi
}
# ⚠ THE TEMPORARIES AND THEIR TRAP ARE ONE STEP. Both directories were created
# here and at line ~170, with the trap installed only after the second -- so
# every refusal in between (a missing or non-executable scanner, the commonest
# one there is) left an empty directory behind for good
# (shardpilot/shardpilot-go#79 review). A cleanup that begins after the first
# thing that can exit is not cleanup.
# ⚠ ABSOLUTE AND PHYSICAL, IMMEDIATELY. With a relative `TMPDIR` -- `TMPDIR=tmp`
# is legal -- `mktemp -d` returns a relative pathname, and this file runs dozens of
# `( cd "$wt" && … )` in which that name then means something else: staging looked
# for `tmp/tmp.X/committed-object` under the temporary worktree and refused every
# otherwise valid push (shardpilot/shardpilot-go#79 review). A relative path is a
# value whose meaning depends on where it is read, and this program reads it from
# several places.
tmpdir="$(mktemp -d)"
tmpdir="$( cd "$tmpdir" && pwd -P )" || {
  printf 'REFUSING: the temporary directory could not be resolved.\n' >&2
  exit 2
}
# ⚠ SYNTHETIC EVIDENCE WAS BEING WRITTEN INTO THE REPOSITORY UNDER INSPECTION.
#
# `hash-object -w` puts the staged evidence in whatever object store the caller
# is using, so every push left unreachable blobs behind in the user's repository
# -- measured: four per push on a one-file repository, and they persist until a
# `gc`. It also makes a WRITABLE object store a precondition for pushing, which
# an ordinary push does not need: a clone reading a shared store mounted
# read-only can transfer every object it must and was refused here
# (shardpilot/shardpilot-go#79 review).
#
# A private store under the temporary directory takes the writes; the caller's
# store is reached as an ALTERNATE, and git follows alternates transitively, so
# everything readable before is readable still. The path is captured BEFORE the
# override, because `--git-path objects` answers with the variable being replaced.
evidence_objects="$tmpdir/objects"
real_objects="$(git rev-parse --path-format=absolute --git-path objects 2>/dev/null && printf X)" || real_objects=""
real_objects="${real_objects%X}"
real_objects="${real_objects%$NL}"
if [ -z "$real_objects" ] || ! mkdir -p "$evidence_objects/info"; then
  printf 'REFUSING: could not prepare a private object store for evidence.\n' >&2
  printf '  Writing it into the repository under inspection is what this avoids.\n' >&2
  exit 2
fi
# The alternates file is newline-separated, so a store whose path contains one
# has to be C-quoted -- the same reason the environment list is quoted above.
{ cquote_alt "$real_objects"; printf '\n'; } > "$evidence_objects/info/alternates" || {
  printf 'REFUSING: could not point the evidence store at %s.\n' "$real_objects" >&2
  exit 2
}
GIT_OBJECT_DIRECTORY="$evidence_objects"
export GIT_OBJECT_DIRECTORY
base_ref=""

# ⚠ THE REFSPEC IS BUFFERED BEFORE ANYTHING TOUCHES A COMMIT-CONTROLLED PATH.
# A commit replacing the tracked scanner with a symlink to `/dev/stdin` made the
# drift check below read the hook's own input through it: `cmp` consumed the
# refspec line, `cat` then returned empty, the loop processed no updates, and the
# hook exited 0 without scanning the commit that did it
# (shardpilot/shardpilot-go#79 review). Reading anything the branch controls
# before this line is reading with the gate's own input at stake.
pushed_lines="$(cat)"

# ⚠ THE SAME EATEN BYTE, AND HERE IT FAILS OPEN TOO. `$tracked_scanner` is built
# from this value and tested with `-r` below: a root short of its last byte names
# a path that does not exist, the test is false, and the comparison against the
# tracked scanner -- the check that catches a branch shipping its own scanner --
# is skipped without a word (shardpilot/shardpilot-go#79, derived population).
# ⚠ AND IT TOLERATES HAVING NO WORKTREE, exactly as the same call twelve sites down
# already does. In a BARE repository `--show-toplevel` is fatal, and under `set -e`
# this line ended the hook with git's own `fatal: this operation must be run in a
# work tree` and status 128 -- an opaque abort where the gate should either run or
# refuse in its own words. Found while exempting bare repositories from the
# checkout-owner guard (shardpilot/shardpilot-go#79 review): removing the wrong
# refusal exposed the next site that assumed a checkout, which is the same sentence
# this file keeps writing -- a rule stated at one site and not at its twin.
root="$(git rev-parse --show-toplevel 2>/dev/null && printf X)" || root=""
root="${root%X}"
root="${root%$NL}"
tracked_scanner=""
if [ -n "$root" ]; then
  tracked_scanner="$root/scripts/check_public_surface.sh"
fi

# ⚠ THE SCANNER MUST BE TRUSTED TOO, AND THE TRACKED ONE IS NOT.
#
# Installing the HOOK outside the worktree closed one execution path and left
# its twin open: `scripts/check_public_surface.sh` is tracked, so checking out an
# untrusted contributor's branch and pushing it made this hook copy THAT
# branch's scanner into the worktree and run it -- arbitrary code, before any
# trustworthy scan, exactly the thing the hook exists to prevent
# (shardpilot/shardpilot-go#79 review). Fixing the hook's own installation was
# necessary and not sufficient: everything this hook EXECUTES has to come from
# outside tracked content.
# ⚠ ASK GIT WHERE HOOKS LIVE. `--git-dir` in a LINKED WORKTREE names
# `.git/worktrees/<name>`, while git reads hooks from the COMMON dir -- so an
# install built on `--git-dir` puts the hook where git never looks and the gate
# is silently absent while appearing installed (shardpilot/shardpilot-go#79
# review). Measured here: `--git-dir` gave `.git/worktrees/…-hook`, and
# `--git-path hooks` gave `.git/hooks`, which is what git actually reads.
# ⚠ THE PHYSICAL HOOKS DIRECTORY, NOT THE CONFIGURED ONE. `--git-path hooks`
# HONOURS `core.hooksPath`, so on a repository still carrying the setting this
# file used to recommend it resolves back to `.githooks` -- tracked,
# branch-controlled, and the exact thing moving out of tracked content was meant
# to escape (shardpilot/shardpilot-go#79 review). Measured:
# `git -c core.hooksPath=.githooks rev-parse --git-path hooks` prints `.githooks`,
# while `--git-common-dir` prints the real one either way. Asking the authority
# was right; asking the resolver the USER can relocate was not.
# ⚠ ABSOLUTE. `--git-common-dir` answers `.git` in the MAIN worktree, and git
# resolves a RELATIVE core.hooksPath against the directory the hook runs in -- so
# a `.git/hooks` stored by the install resolves, inside a linked worktree, to a
# path where `.git` is a FILE, and the hook is never executed
# (shardpilot/shardpilot-go#79 review). Measured: main worktree `.git`, linked
# worktree an absolute path; the recovery hint printed the relative one too.
# ⚠ AND THE STATUS IS CHECKED, because the failure of this substitution is not an
# empty value -- it is a WRONG one. If `git rev-parse --git-common-dir` fails, the
# inner `$( )` is empty, `cd ""` fails, `pwd` never runs, and the whole expression
# becomes `/hooks`; with the `cd` succeeding into the current directory instead it
# becomes `$PWD/hooks`. Either way the symlink check below then tests a path that
# does not exist and PASSES vacuously, and `scanner` points somewhere inside the
# checkout -- the branch-controlled content this gate installs outside the worktree
# to avoid.
#
# Found by enumerating every status-discarding substitution in this file rather
# than by a review: 12 of them, 11 of which fail only by absence and are handled.
# This is the twelfth (shardpilot/shardpilot-go#79, derived population).
# ⚠ AND THE SENTINEL, because a command substitution eats EVERY trailing newline --
# git's own terminator AND the pathname's final byte when the common directory's name
# ends in one. `physdir` then resolved a different or nonexistent directory and the
# hook refused before it could locate its trusted scanner
# (shardpilot/shardpilot-go#79 review). The convention is already applied to
# `--show-toplevel` and the object-store paths; this call was written without it.
common_dir="$(git rev-parse --git-common-dir 2>/dev/null && printf X)" || common_dir=""
common_dir="${common_dir%X}"
common_dir="${common_dir%$NL}"
if [ -z "$common_dir" ]; then
  printf 'REFUSING: could not locate the common git directory.
' >&2
  printf '  Every path this gate trusts is derived from it, and a failure here
' >&2
  printf '  yields a path inside the checkout rather than no path at all.
' >&2
  exit 2
fi
# ⚠ THE OTHER SIDE OF THE CONTAINMENT COMPARISON. The review named the worktree
# root; this is the value it is compared AGAINST, built the same way and losing
# the same byte. A comparison is not repaired by fixing one operand
# (shardpilot/shardpilot-go#79, derived population). `pwd -P` also replaces the
# logical `pwd` that was here: comparing a logical path to a physical one answers
# a question neither operand asked.
if hooks_root="$(physdir "$common_dir")"; then
  hooks_root="${hooks_root%X}"
else
  hooks_root=""
fi
hooks_dir="$hooks_root/hooks"
if [ "$hooks_dir" = "/hooks" ] || [ -z "${hooks_dir%/hooks}" ]; then
  printf 'REFUSING: the common git directory %s could not be resolved.
' "$common_dir" >&2
  exit 2
fi
scanner="$hooks_dir/check_public_surface.sh"
# ⚠ CLASS: A PATH THIS GATE TRUSTS MAY BE A SYMLINK, AND EVERY TEST BELOW FOLLOWS
# ONE. `-x` and `-s` answer about the TARGET, so an intuitive link from the
# installed scanner back to the tracked `scripts/check_public_surface.sh` made the
# hook execute the checked-out branch's bytes -- the exact thing installing outside
# the worktree exists to prevent (shardpilot/shardpilot-go#79 review). The hooks
# DIRECTORY has the same problem: linked into the checkout, everything beneath it is
# branch-controlled while each file looks like a regular executable.
#
# Three rounds fixed this by name -- final names, then temporary names, now the
# directory and the target. The class is "a path whose NATURE was not checked", and
# it is checked here for both.
# ⚠ AND OUTSIDE THE WORKTREE, WHICH `-L` DOES NOT ASK. A repository initialised
# with `--separate-git-dir="$PWD/.repo"` has an ordinary common git directory
# BENEATH its own checkout, so `$h` is no symlink and the test below passes -- while
# `.repo/hooks/pre-push` and the trusted scanner are trackable paths a branch can
# provide, and `git reset --hard <branch>` overwrites the installed bytes before the
# next push (shardpilot/shardpilot-go#79 review). The property is CONTAINMENT, and
# the symlink test was a proxy for it that holds only in the usual layout.
# ⚠ AND THE NAME ITSELF MAY END IN A NEWLINE, WHICH BOTH SUBSTITUTIONS ATE.
# `git rev-parse --show-toplevel` prints the path and a terminator, so a worktree
# named `w<NL>` arrived here as `w`, `cd` failed on a directory that does not
# exist, and this assignment became EMPTY -- skipping the containment check
# entirely and admitting the very layout it was added to refuse
# (shardpilot/shardpilot-go#79 review).
wt_top="$(git rev-parse --show-toplevel 2>/dev/null && printf X)" || wt_top=""
wt_top="${wt_top%X}"
wt_top="${wt_top%$NL}"
worktree_root=""
if [ -n "$wt_top" ] && worktree_root="$(physdir "$wt_top")"; then
  worktree_root="${worktree_root%X}"
else
  worktree_root=""
  # ⚠ AN UNRESOLVED ROOT MUST NOT MEAN "NOTHING TO CHECK". Empty was the value
  # the defect above produced, and the check read it as "no worktree" and passed.
  # A bare repository legitimately has none; anything else is a resolution that
  # FAILED, and this gate does not pass on a measurement it could not take.
  if [ "$(git rev-parse --is-bare-repository 2>/dev/null || printf false)" != true ]; then
    printf 'REFUSING: this repository has a worktree, but its root could not be\n' >&2
    printf '  resolved, so the hooks directory cannot be shown to lie outside it.\n' >&2
    exit 2
  fi
fi
if [ -n "$worktree_root" ]; then
  # ⚠ INSIDE THE WORKTREE IS NOT THE PROPERTY -- TRACKABLE IS.
  #
  # The predicate this replaces refused every ORDINARY repository: `.git/hooks`
  # is physically inside the worktree, so the case matched and a push from a
  # normal clone was refused. It went unnoticed because the two operands were
  # built differently -- a LOGICAL `pwd` here against a PHYSICAL one there -- and
  # on macOS `/var` resolves to `/private/var`, so the prefixes never matched and
  # the check never fired at all. Making both physical, which the comparison
  # needs, exposed it: measured on a symlink-free path, the operands agree and
  # every ordinary repository is refused (that is CI, and every Linux checkout).
  #
  # What the finding was about is content a BRANCH can supply, and git decides
  # that by its own rule: it refuses to track any path with a `.git` component.
  # So `<root>/.git/hooks` is unreachable from a branch however deeply it sits
  # inside the worktree, while `--separate-git-dir=$PWD/.repo` gives `.repo/hooks`
  # -- inside, with no such component, and trackable. That is the line, and it is
  # git's line rather than a list of layouts I happened to think of.
  # ⚠ AND A ROOT OF `/` DOUBLES THE SLASH. `"$worktree_root"/*` expands to `//*`
  # when the root IS `/`, which matches nothing -- so a worktree at the filesystem
  # root with a separate git directory at `/repo` skipped the containment check
  # entirely (shardpilot/shardpilot-go#79 review). The prefix is built once, with
  # the trailing slash included rather than appended.
  # ⚠ EVERY WORKTREE, BECAUSE THE HOOKS DIRECTORY IS SHARED. `--show-toplevel`
  # answers for the INVOKING worktree, and the trusted hooks directory belongs to
  # the common git directory that all of them share -- so a shared git dir sitting
  # at a trackable path beneath the MAIN worktree passed this check whenever the
  # push came from a linked one (shardpilot/shardpilot-go#79 review). The property
  # is "reachable as a tracked path from ANY checkout of this repository", and the
  # invoking one is not the only checkout.
  #
  # `-z` because a worktree path may contain a newline, which the line-oriented
  # form of this listing cannot carry.
  # ⚠ TO A FILE, BECAUSE `$( )` CANNOT CARRY A NUL. `-z` is required -- a worktree
  # path may contain a newline -- and command substitution drops NUL bytes, so the
  # records collapsed into one and the loop below saw nothing. The check passed by
  # enumerating an empty list, which is the failure mode this file keeps naming:
  # a probe that cannot go positive.
  wt_list_file="$tmpdir/worktrees"
  # ⚠ AND A FAILED ENUMERATION IS NOT AN EMPTY ONE. Truncating on failure left the
  # containment test running against the INVOKING checkout alone, so a shared git
  # directory trackable from another linked worktree would not be seen -- which is
  # the very finding this listing was added for, reintroduced by its own fallback
  # (shardpilot/shardpilot-go#79 review). The comment directly above already names
  # the class: a probe that cannot go positive.
  if ! git worktree list --porcelain -z > "$wt_list_file" 2>/dev/null; then
    printf 'REFUSING: this repository'"'"'s worktrees could not be enumerated, so the\n' >&2
    printf '  containment check can only speak for the invoking checkout. A shared git\n' >&2
    printf '  directory trackable from another worktree would not be seen.\n' >&2
    exit 2
  fi
  check_containment() {
    root_prefix="$1/"
    case "$root_prefix" in //) root_prefix=/ ;; esac
    case "$hooks_dir/" in
      "$root_prefix"*)
        # Trackability is decided on the path RELATIVE to the worktree: a `.git`
        # component anywhere in it puts the directory beyond any branch's reach.
        hooks_rel="${hooks_dir#"$root_prefix"}"
        case "/$hooks_rel/" in
          */.git/*) : ;;
          *)
            printf 'REFUSING: the hooks directory %s is inside the worktree %s\n' "$hooks_dir" "$1" >&2
            printf '  and is trackable there (%s). A branch can supply the hook or the\n' "$hooks_rel" >&2
            printf '  scanner, and a checkout can replace the installed bytes.\n' >&2
            exit 2
            ;;
        esac
        ;;
    esac
  }
  # ⚠ THE SECOND PATH FILTER, AND IT REFUSES RATHER THAN DROPS. The builtin pass
  # above named every checkout it could reach without running anything; this one has
  # git's own answer, and by now external commands HAVE run. A survivor found here
  # was on PATH while `mktemp` and `git` were resolved, so there is nothing left to
  # drop -- the honest answer is that this gate cannot speak for the run
  # (shardpilot/shardpilot-go#79 review). It is also the only place the builtin
  # pass's limits become visible instead of silent.
  check_path_outside() {
    cpo_rest="$PATH"
    while [ -n "$cpo_rest" ]; do
      cpo_one="${cpo_rest%%:*}"
      case "$cpo_rest" in *:*) cpo_rest="${cpo_rest#*:}" ;; *) cpo_rest="" ;; esac
      [ -n "$cpo_one" ] || continue
      case "$cpo_one" in /*) ;; *) continue ;; esac
      if cpo_phys="$(physdir "$cpo_one")"; then
        cpo_phys="${cpo_phys%X}"
      else
        cpo_phys="$cpo_one"
      fi
      cpo_prefix="$1/"
      case "$cpo_prefix" in //) cpo_prefix=/ ;; esac
      case "$cpo_phys/" in
        "$cpo_prefix"*)
          printf 'REFUSING: the PATH entry %s lies inside the worktree %s, where a\n' "$cpo_one" "$1" >&2
          printf '  branch can supply it -- and this gate has already resolved external\n' >&2
          printf '  commands, so dropping it now would not undo what it may have run.\n' >&2
          exit 2
          ;;
      esac
    done
  }
  common_phys="$(physdir "$common_dir")" && common_phys="${common_phys%X}" || common_phys="$common_dir"
  # Does the checkout this hook was invoked from own that git directory? If so, its
  # root is already in the filter and the unfindable-owner case below is not a gap.
  invoking_owns_common=no
  if [ -d "$worktree_root/.git" ]; then
    iv_phys="$(physdir "$worktree_root/.git")" && iv_phys="${iv_phys%X}" || iv_phys=""
    [ -n "$iv_phys" ] && [ "$iv_phys" = "$common_phys" ] && invoking_owns_common=yes
  elif [ -f "$worktree_root/.git" ]; then
    # Read to EOF: a common directory whose pathname contains a newline was
    # truncated here, so `invoking_owns_common` stayed false and the owner guard
    # refused a push made from the OWNING main checkout
    # (shardpilot/shardpilot-go#79 review).
    iv_link=""
    IFS= read -r -d "" iv_link < "$worktree_root/.git" || true
    iv_link="${iv_link%$NL}"
    case "$iv_link" in
      "gitdir: "*)
        iv_phys="$(physdir "${iv_link#gitdir: }")" && iv_phys="${iv_phys%X}" || iv_phys=""
        [ -n "$iv_phys" ] && [ "$iv_phys" = "$common_phys" ] && invoking_owns_common=yes
        ;;
    esac
  fi
  check_containment "$worktree_root"
  check_path_outside "$worktree_root"
  if [ -s "$wt_list_file" ]; then
    while IFS= read -r -d "" wt_rec; do
      case "$wt_rec" in
        worktree\ *)
          wt_other="${wt_rec#worktree }"
          wt_phys="$(physdir "$wt_other")" || continue
          wt_phys="${wt_phys%X}"
          [ "$wt_phys" = "$worktree_root" ] && continue
          # ⚠ A GIT DIRECTORY IS NOT A CHECKOUT, AND `git worktree list` REPORTS ONE.
          # With `--separate-git-dir`, the first record names the GIT DIRECTORY rather
          # than the worktree -- so `<gitdir>/hooks` read as "trackable beneath a
          # worktree" and this gate refused every push to a repository installed that
          # way, with the directory outside any checkout
          # (shardpilot/shardpilot-go#79 review). Nothing tracks a git directory.
          if [ "$wt_phys" = "$common_phys" ]; then
            wt_owner="${wt_phys%/*}"
            # ...but the checkout that OWNS it, if any, is still a checkout, and it is
            # found the way git links them: a `.git` FILE naming this directory.
            # `core.worktree` is not set for a separate git dir -- measured, not assumed.
            wt_owner_found=no
            if [ -f "$wt_owner/.git" ]; then
              # Read to EOF, for the same reason as the two sites above: a
              # truncated back-pointer never matches, so an owned checkout reads
              # as ownerless. Third instance of one defect; the review named one.
              wt_link=""
              IFS= read -r -d "" wt_link < "$wt_owner/.git" || true
              wt_link="${wt_link%$NL}"
              if [ "$wt_link" = "gitdir: $wt_phys" ] || [ "$wt_link" = "gitdir: $wt_other" ]; then
                wt_owner_found=yes
                wt_owner_phys="$(physdir "$wt_owner")" && wt_owner_phys="${wt_owner_phys%X}" &&
                  check_containment "$wt_owner_phys" &&
                  check_path_outside "$wt_owner_phys"
              fi
            fi
            # ⚠ AN EXTERNAL GIT DIRECTORY HAS NO BACK-POINTER, so its checkout cannot
            # be found at all -- measured: `--separate-git-dir` writes `gitdir:` into
            # the CHECKOUT and nothing into the directory, and `core.worktree` is not
            # set. The parent assumption above covers `<main>/.repo`; for
            # `/tmp/store/repo.git` owning `/tmp/main` there is nothing to follow, so a
            # PATH entry under `/tmp/main/bin` is inside a checkout this gate cannot
            # enumerate and a branch there supplies the next `git` or `mktemp`
            # (shardpilot/shardpilot-go#79 review).
            #
            # It is only a gap when the INVOKING checkout is not that owner -- when it
            # is, its root is already filtered. So this refuses exactly the layout it
            # cannot speak for, and says which two things make it go away.
            if [ "$wt_owner_found" = no ] && [ "$invoking_owns_common" = no ]; then
              printf 'REFUSING: %s is a git directory whose checkout this gate cannot find.\n' "$wt_phys" >&2
              printf '  A separate git directory records no path back to its worktree, so a\n' >&2
              printf '  PATH entry inside that checkout cannot be ruled out. Push from the\n' >&2
              printf '  main checkout, or keep the git directory inside it.\n' >&2
              exit 2
            fi
            continue
          fi
          check_containment "$wt_phys"
          check_path_outside "$wt_phys"
          ;;
      esac
    done < "$wt_list_file"
  fi
fi
for tp in "$hooks_dir" "$scanner"; do
  if [ -L "$tp" ]; then
    printf 'REFUSING: %s is a symbolic link.\n' "$tp" >&2
    printf '  Every test below follows it, so what this gate trusts would be\n' >&2
    printf '  whatever the link points at -- including tracked content.\n' >&2
    exit 2
  fi
done
unset tp
if [ ! -x "$scanner" ] || [ ! -s "$scanner" ]; then
  # ⚠ `-s` AS WELL AS `-x`. A re-copy that lands while a push is running leaves
  # the destination truncated for an instant, and an empty scanner is executable
  # and exits 0 -- a gate that reports clean because there was nothing to run
  # (shardpilot/shardpilot-go#79 review). The install now publishes each file by
  # rename, so no truncated state is observable at all; this is the second half,
  # here because a gate should not depend on the install being followed.
  printf 'REFUSING: no usable trusted scanner at %s.\n' "$scanner" >&2
  printf '  Install it beside the hook, from a checkout you trust:\n' >&2
  # ⚠ THE HINT MUST NAME THE DIRECTORY THE CHECK USES. It printed `--git-dir`
  # while the lookup above searches `--git-common-dir`, so in a linked worktree
  # following the recovery instruction copied somewhere the next push would not
  # look, and refused identically (shardpilot/shardpilot-go#79 review). A
  # recovery hint that does not recover is a loop with a message attached.
  printf '    cp scripts/check_public_surface.sh %s/\n' "$hooks_dir" >&2
  printf '    chmod +x %s/check_public_surface.sh\n' "$hooks_dir" >&2
  printf '  Running the TRACKED copy would execute whatever the checked-out\n' >&2
  printf '  branch says it is.\n' >&2
  exit 2
fi
# Reading tracked content is safe; executing it is not. A drift warning keeps the
# trusted copy honest without trusting the branch.
# The drift note reads tracked content, so it refuses a symlink rather than
# following one: the point of reading is to compare bytes, and a symlink is a
# request to read somewhere else.
if [ -L "$tracked_scanner" ]; then
  printf 'NOTE: %s is a symlink; not comparing against it.\n' "scripts/check_public_surface.sh" >&2
elif [ -r "$tracked_scanner" ] && ! cmp -s "$scanner" "$tracked_scanner"; then
  printf 'NOTE: the trusted scanner differs from %s.\n' "scripts/check_public_surface.sh" >&2
  printf '  If that is an update you want, re-copy it; if it is a branch you are\n' >&2
  printf '  inspecting, this is exactly why the copy exists.\n' >&2
fi

remote_name="${1:-origin}"
# githooks(5): $2 is where the push is actually going. $1 may be a name or, for a
# direct-URL push, the URL itself.
dest="${2:-$remote_name}"

# ⚠ AND NEVER PRINT IT. A direct push URL or `remote.<name>.pushurl` can embed
# `user:token@`, and a diagnostic that echoes it puts the credential in terminal
# scrollback and CI logs -- a gate that exists to stop publication leaking one
# by complaining (shardpilot/shardpilot-go#79 review). Messages use the NAME, or
# a userinfo-stripped form when the name is itself a URL; the unmodified value
# goes only to ls-remote and fetch.
safe_dest="$remote_name"
case "$safe_dest" in
  *://*@*) safe_dest="$(printf '%s' "$safe_dest" | sed -E 's#(://)[^/@]*@#\1<redacted>@#')" ;;
esac

# ⚠ RESOLVED ONLY IF SOMETHING WILL BE SCANNED. A deletion-only push carries an
# all-zero local SHA and needs no local objects at all, so it is valid from a
# repository whose `HEAD` is UNBORN -- and this unconditional resolution aborted
# before the loop could recognise the deletion, refusing a push git performs
# without reading a single object (shardpilot/shardpilot-go#79 review). Measured:
# `fatal: ambiguous argument 'HEAD'`, and the remote ref still standing.
#
# The refspec is read first, and `HEAD` is required only when at least one update
# is not a deletion. An unborn HEAD with something to scan is still a refusal --
# the value would be needed and is not there -- and it says so by name.
# ⚠ AND "NOT A DELETION" IS NOT "NEEDS A COMMIT". A repository with an unborn HEAD
# can hold a blob or a tree made with plumbing, and pushing one to a non-branch
# namespace -- `<blob>:refs/archive/blob` -- is valid and needs no commit at all;
# this required HEAD for it and refused (shardpilot/shardpilot-go#79 review). The
# question is what the SCAN needs, and the scan needs a commit only when one is
# being introduced. Asked of the object, not of the line's shape.
head_sha=""
needs_head=no
while IFS=" " read -r _ lsha _ _; do
  case "$lsha" in
    ""|*[!0-9a-fA-F]*) continue ;;
  esac
  case "$lsha" in
    *[!0]*) ;;
    *) continue ;;
  esac
  # ⚠ AND A TAG IS A WRAPPER, SO ASK WHAT IT WRAPS. `cat-file -t` reports `tag`
  # for an annotated tag whatever it points at, so a tag around a BLOB set
  # `needs_head` and refused a push that introduces no commit -- the same object
  # the branch above already handles, wrapped (shardpilot/shardpilot-go#79
  # review). `^{commit}` peels through the wrapper and fails on a tag that does
  # not reach one, which is the question being asked.
  if git rev-parse --verify --quiet "$lsha^{commit}" >/dev/null 2>&1; then
    needs_head=yes
    break
  fi
done <<PUSHED_LINES
$pushed_lines
PUSHED_LINES
# ⚠ RESOLVED ALWAYS, REQUIRED CONDITIONALLY. The condition is about whether a
# MISSING HEAD is a refusal, and my first version made it about whether to LOOK --
# so every non-commit push from a repository that HAS history lost its scan base
# and fell into the synthetic branch, and five scenes that had published for rounds
# went red at once. The battery said so before the push did.
head_sha="$(git rev-parse HEAD 2>/dev/null && printf X)" || head_sha=""
head_sha="${head_sha%X}"
head_sha="${head_sha%$NL}"
if [ "$needs_head" = yes ]; then
  if [ -z "$head_sha" ]; then
    printf 'REFUSING: this push introduces commits, and HEAD could not be resolved\n' >&2
    printf '  to place them. A scan that cannot locate the pushed history is not a scan.\n' >&2
    exit 2
  fi
fi
status=0

# scan_commit <commit> <base> -- scans that commit's tree, with TODAY'S scanner.
#
# ⚠ A TEMPORARY WORKTREE, NOT A TEMPORARY INDEX. The scanner is index-driven --
# `git write-tree` for the file list, `git cat-file blob :path` for content --
# so pointing GIT_INDEX_FILE at a per-commit index looks like the cheap answer.
# It is not: the scanner SELF-TESTS by building fixture repositories and running
# `git add -A` inside them, and an inherited GIT_INDEX_FILE redirects those
# writes into the per-commit index. Measured, not guessed: the index is
# corrupted mid-run, `git write-tree` then yields something that is not a tree,
# and the scanner refuses with "git ls-files failed". A worktree has its own
# index and the fixtures have theirs, so nothing collides.
#
# ⚠ AND TODAY'S SCANNER IS STAGED INTO IT. The scanner refuses to run unless it
# matches its staged copy -- a real protection, since an edited gate reporting
# clean is its worst failure. So the current scanner is written into the
# worktree and staged there: the tree examined is commit C's, except at the
# scanner's own path, and the rules applied are TODAY'S rather than the ones
# that shipped with C. That is the right direction -- a rule added since C
# should still catch what C published -- and it is a difference, so it is named.
# scan_ref_name <commit> <base> <ref> -- for a push that introduces no commits:
# the tree is already published, the NAME is not.
scan_ref_name() {
  printf 'public surface: no new commits; scanning the published ref name\n'
  # ⚠ THE COMMIT IS ITS OWN BASE HERE, and that is the whole of the difference.
  # This tree is ALREADY published -- an alias branch, or a missing annotated tag
  # for an older commit -- so the only new thing is the NAME. Passing the
  # destination's current default branch made the lane-B anti-cheat compare this
  # commit's baseline file against a target that has since REDUCED its own, read
  # the difference as raising the baseline, and refuse a push introducing no
  # content at all (shardpilot/shardpilot-go#79 review). Lane A is absolute and
  # still reads every byte, the ref name and tag object included; only the
  # comparative check is pointed at something it can meaningfully answer about.
  scan_commit "$1" "$1" "$3" "$4" "$5" "${6:-}"
}

# read_evidence runs a git read whose OUTPUT BECOMES EVIDENCE and refuses if it
# does not complete. There is no useful partial answer here: everything
# downstream reads the file as the object.
#
# ⚠ FIVE SITES SWALLOWED THE FAILURE, and the review found three of them in one
# round after the commit-object site was fixed in the previous one -- `|| true`,
# `|| break`, `|| : > file`. Each converts an unreadable published object into
# clean evidence, which is the dangerous direction: a short read scans clean and
# every check above it honestly reports on what it was given
# (shardpilot/shardpilot-go#79 review). Written once so a sixth site is a call
# rather than a fourth instance of this finding.
# ⚠ THE CLASS INCLUDES EVERY WRITE, NOT ONLY THE GIT READS. Having unified the
# `git` sites one round earlier I went on believing the class was closed, and the
# review found a `printf` into the same directory that no one had checked -- while
# a derived pass over EVERY write into the evidence directory shows four:
# the ref name, two truncations, and the concatenation that builds the tag target
# (shardpilot/shardpilot-go#79 review). A grep for one command name is not a
# population; the population is "what becomes evidence".
run_evidence() {
  ev_dest="$1"
  ev_mode="$2"
  ev_what="$3"
  shift 3
  if [ "$ev_mode" = write ]; then
    "$@" > "$ev_dest" 2>/dev/null && return 0
  else
    "$@" >> "$ev_dest" 2>/dev/null && return 0
  fi
  printf 'REFUSING: %s could not be written whole.\n' "$ev_what" >&2
  printf '  Evidence that stops partway scans clean, and everything downstream\n' >&2
  printf '  reads it as the answer.\n' >&2
  exit 2
}

read_evidence() {
  ev_dest="$1"
  ev_mode="$2"
  ev_what="$3"
  shift 3
  run_evidence "$ev_dest" "$ev_mode" "$ev_what" git "$@"
}

# scan_commit <commit> <base> <published-ref-name> [tag-object-file]
scan_commit() {
  wt="$tmpdir/wt"
  rm -rf "$wt"
  # ⚠ NO CHECKOUT. `worktree add` runs the CLEAN and SMUDGE drivers a
  # `.gitattributes` in the inspected history names -- so a commit that assigns a
  # locally configured filter, even one a later commit removes, made this hook
  # execute that program on attacker-controlled bytes BEFORE the scanner ran.
  # Redirecting hooks does not help: a filter driver is not a hook
  # (shardpilot/shardpilot-go#79 review). The scanner reads its bytes with
  # `git cat-file blob :<path>`, from the INDEX, so an index is all it needs and
  # a working tree is what it never wanted.
  if ! git_safe worktree add --detach --no-checkout --quiet "$wt" "$1" 2>/dev/null; then
    printf 'REFUSING: could not create a worktree at %s to scan it.\n' "$1" >&2
    exit 2
  fi
  # ⚠ `--no-checkout` LEAVES THE INDEX EMPTY, IT DOES NOT POPULATE IT. The
  # scanner enumerates with `git ls-files` and reads with `cat-file blob :<path>`,
  # so an empty index makes every file invisible and the run reports a clean tree
  # it never looked at -- which is the worst outcome this hook has, and the first
  # rig probe caught it immediately (the scanner's own roster self-check failed,
  # because nothing existed to find the names in).
  if ! in_worktree read-tree "$1" 2>/dev/null; then
    printf 'REFUSING: could not read the tree of %s into an index to scan it.\n' "$1" >&2
    exit 2
  fi

  # ⚠ ASK THE TREE. THE WORKING DIRECTORY IS EMPTY AND ALWAYS WAS.
  #
  # These two checks tested the FILESYSTEM under a `--no-checkout` worktree, where
  # nothing is materialised -- so `[ -L "$wt/scripts" ]` was false for a commit
  # whose `scripts` IS a symlink, and the guard against a tree shaped to redirect
  # this gate's writes never fired once. Measured: `ls -A` on that worktree lists
  # nothing, while `git ls-tree` reports `120000`.
  #
  # The round before added `sparse-checkout disable` to make them non-vacuous,
  # believing it would populate the worktree. On git 2.50.1 it does not: it
  # returns 0, sets `core.sparseCheckout=false`, and materialises nothing, in cone
  # and non-cone alike. So the repair did not repair, and the checks stayed empty.
  #
  # And `disable` is DOCUMENTED as restoring the working directory to include all
  # files, which is why it has to go rather than be relied on for not doing it: a
  # populate here would run the commit's own smudge filters -- arbitrary programs
  # from the tree under inspection, before the trusted scanner
  # (shardpilot/shardpilot-go#79 review). That the hazard does not fire on this
  # version is not a reason to keep the call; it is the reason the call was never
  # doing anything.
  #
  # Asking the tree removes both: no populate, and an answer that does not depend
  # on sparsity, on the checkout, or on the git version's idea of `disable`.
  # ⚠ AN UNREADABLE ENTRY IS NOT AN ABSENT ONE. `ls-tree` reports success with
  # EMPTY output for a path a commit does not carry, so a non-zero status means the
  # probe failed -- and mapping that to "" let a mode allow-list consume a
  # measurement that was never taken (shardpilot/shardpilot-go#79 review). Fourth
  # site of this shape in this file; the population was produced by grepping every
  # substitution that swallows a status, not by listing the ones I was shown.
  if ! scripts_row="$( in_worktree ls-tree "$1" -- scripts 2>/dev/null )"; then
    printf 'REFUSING: the entry for `scripts` in %s could not be read, so this gate\n' "$1" >&2
    printf '  cannot tell an unreadable entry from an absent one.\n' >&2
    exit 2
  fi
  case "${scripts_row%% *}" in
    ""|040000) ;;
    *)
      printf 'REFUSING: in %s, `scripts` is not a real directory (mode %s).\n' "$1" "${scripts_row%% *}" >&2
      printf '  A commit that shapes it as a symlink or a file would redirect this\n' >&2
      printf '  gate writes outside the worktree it is inspecting.\n' >&2
      exit 2
      ;;
  esac
  if ! scanner_row="$( in_worktree ls-tree "$1" -- scripts/check_public_surface.sh 2>/dev/null )"; then
    printf 'REFUSING: the entry for the scanner path in %s could not be read, so its\n' "$1" >&2
    printf '  mode cannot be checked and a gitlink there would go unscanned.\n' >&2
    exit 2
  fi
  # ⚠ WHAT IS ALLOWED, NOT WHAT IS BANNED. Naming `120000` left `160000`: a commit
  # can make the scanner path a GITLINK whose target is absent locally, and
  # `cat-file -e "$1:scripts/check_public_surface.sh"` then dereferences the
  # missing target and reports the path ABSENT -- so the trusted scanner was staged
  # over it, the scanner's own gitlink refusal never saw the row, and the
  # unscanned repository reference was published
  # (shardpilot/shardpilot-go#79 review). This is the third time in this file that
  # a ban-list left the mode nobody thought of; the allowed set is two entries and
  # does not grow.
  case "${scanner_row%% *}" in
    ""|100644|100755) ;;
    *)
      printf 'REFUSING: in %s, the scanner path is mode %s, not a regular file.\n' \
        "$1" "${scanner_row%% *}" >&2
      exit 2
      ;;
  esac
  # The directory is created rather than checked out: this gate writes evidence
  # into it, and nothing from the commit is materialised anywhere.
  mkdir -p "$wt/scripts"

  # ⚠ AND THE COMMIT'S OWN SCANNER IS EVIDENCE, NOT SCAFFOLDING. Overwriting it
  # with today's copy hid it: the scanner excludes its own path from the tree
  # pass and self-audits the staged replacement, so material added to THAT file
  # in THAT commit would never be examined and would publish anyway. It is moved
  # to a plain tracked path first, where it is read like any other file.
  # stage_evidence <source-file> <relative-dest> -- puts something the scanner
  # must read into the tree it is about to read.
  #
  # ⚠ THE DESTINATION MUST NOT ALREADY EXIST. A commit that tracks the evidence
  # path would have its own file overwritten -- so material stored THERE would
  # never be scanned -- and a destination shaped as a symlink would make the
  # write land outside the worktree, which is the filesystem escape closed one
  # finding earlier arriving through a second door
  # (shardpilot/shardpilot-go#79 review). Refused, not repaired: a commit
  # tracking this name is a finding.
  stage_evidence() {
    # ⚠ ASK THE COMMIT, NOT THE CHECKOUT. `git worktree add` preserves sparse
    # checkout rules, so a path can be present in the index and absent from the
    # filesystem -- and `[ -e ]` then reports a reserved evidence path free while
    # the commit owns it (shardpilot/shardpilot-go#79 review).
    # ⚠ AND ASK ABOUT THE ENTRY, NOT ABOUT ITS TARGET. `cat-file -e "$1:$2"`
    # DEREFERENCES: a `160000` gitlink whose target commit is absent locally --
    # which git permits, since a gitlink's target need not be transferred -- makes
    # it exit non-zero although the tree entry exists. The no-checkout worktree has
    # no filesystem leaf either, so the path read as free, `update-index` replaced
    # the gitlink with synthetic evidence, and the scanner's own gitlink refusal
    # never saw it (shardpilot/shardpilot-go#79 review).
    #
    # `ls-tree` answers about the ENTRY. Same shape as the tagged-tree finding two
    # rounds ago: a probe that resolves an object cannot report on an object it
    # cannot resolve.
    if ! tracked_name="$(git ls-tree --name-only "$1" -- "$2" 2>/dev/null)"; then
      printf 'REFUSING: could not read whether %s tracks the evidence path %s.\n' "$1" "$2" >&2
      exit 2
    fi
    if [ -n "$tracked_name" ] ||
       git cat-file -e "$1:$2" 2>/dev/null || [ -e "$wt/$2" ] || [ -L "$wt/$2" ]; then
      printf 'REFUSING: %s already tracks %s, which this gate needs as an\n' "$1" "$2" >&2
      printf '  evidence path. A commit that owns it can hide content from the\n' >&2
      printf '  scan or redirect this write outside the worktree.\n' >&2
      exit 2
    fi
    # ⚠ WRITTEN TO THE INDEX DIRECTLY, PAST EVERY COMMIT-CONTROLLED FILTER.
    # `git add` applies clean filters, so a commit adding `.gitattributes` with
    # `filter=lfs` on a reserved path staged an LFS POINTER instead of the
    # evidence -- the scanner reads the index, so the content it was given to
    # examine was replaced by something clean (shardpilot/shardpilot-go#79
    # review). `hash-object -w` plus `update-index --cacheinfo` writes the bytes
    # as they are. A failure refuses: unstaged evidence is unread evidence, and
    # this gate does not report on what it has not read.
    blob="$( in_worktree hash-object -w --no-filters -- "$3" 2>/dev/null )"
    # ⚠ THE MODE IS PART OF WHAT THE SCANNER CLASSIFIES BY. Everything was staged
    # `100644`, so a tagged tree's SYMLINK -- `logo.png -> assets/logo` -- reached
    # the scanner as a regular file whose leaf ends in `.png`, and its image rule
    # refused a push the same symlink in an ordinary commit passes
    # (shardpilot/shardpilot-go#79 review). The scanner has a `120000` branch; it
    # was never reachable through this path.
    mode="${4:-100644}"
    if [ -z "$blob" ] || ! in_worktree update-index --add \
         --cacheinfo "$mode,$blob,$2" 2>/dev/null; then
      printf 'REFUSING: could not stage %s for scanning in %s.\n' "$2" "$1" >&2
      exit 2
    fi
    cp "$3" "$wt/$2" 2>/dev/null || true
  }

  # ⚠ THE BLOB, NOT THE CHECKOUT. `worktree add` runs the branch's own
  # `.gitattributes`, so the bytes that land in the worktree are not necessarily
  # the bytes that were committed: with `working-tree-encoding` set on this path,
  # a blob whose ASCII carries an internal identifier is transcoded on the way
  # out and that identifier is absent from the file this used to copy. The
  # transformed bytes were staged as evidence, the entry was then replaced by the
  # trusted scanner, and the scanner excludes its own path, so the committed
  # bytes were examined by nothing (shardpilot/shardpilot-go#79 review). The
  # object database is the one copy the inspected branch cannot rewrite.
  #
  # ⚠ AND THE COMMENT DOES NOT CARRY THE EXAMPLE. The first version of these
  # lines quoted the reviewer's sample identifier verbatim, and this repository's
  # own public-surface gate refused the push that added it -- correctly. A review
  # thread is not published; a comment in tracked content is. Describe the shape,
  # never the instance.
  # ⚠ AND `scanner_row` ALREADY SAID WHETHER THE ENTRY EXISTS. This probe was asked
  # on its own and a FAILURE read as "the commit carries no scanner file" -- so a
  # transient object-store or promisor failure let the trusted scanner replace an
  # entry that IS there, and that path is excluded from content scanning, so the
  # commit's own scanner bytes were published without ever becoming evidence
  # (shardpilot/shardpilot-go#79 review). The row above is the authority on
  # existence; this probe may only confirm it, never contradict it.
  if [ -n "$scanner_row" ] && ! git_safe cat-file -e "$1:scripts/check_public_surface.sh" 2>/dev/null; then
    printf 'REFUSING: %s lists a scanner at scripts/check_public_surface.sh whose blob\n' "$1" >&2
    printf '  could not be read, so this gate cannot stage it as evidence and would\n' >&2
    printf '  replace it with its own copy unseen.\n' >&2
    exit 2
  fi
  if git_safe cat-file -e "$1:scripts/check_public_surface.sh" 2>/dev/null; then
    if ! git_safe cat-file blob "$1:scripts/check_public_surface.sh" \
         > "$tmpdir/committed-scanner" 2>/dev/null; then
      printf 'REFUSING: could not read %s from %s to scan it.\n' \
        "scripts/check_public_surface.sh" "$1" >&2
      exit 2
    fi
    rm -f "$wt/scripts/check_public_surface.sh"
    stage_evidence "$1" scripts/scanner-as-committed.txt "$tmpdir/committed-scanner"
  fi

  # ⚠ THE WHOLE COMMIT OBJECT, NOT ONLY ITS MESSAGE. The tree is not the whole
  # of what a push makes reachable, and neither is the message: author and
  # committer names and addresses are published with it, and `%B` reads none of
  # them (shardpilot/shardpilot-go#79 review, after an earlier round had already
  # moved from tree-only to tree-plus-message). `git cat-file commit` is the
  # object as it will be published -- headers, message, everything -- and it is
  # staged as an ordinary file so the SAME rules read it, with no second scanner
  # and no second pattern list to drift.
  # ⚠ A FAILED WRITE IS A REFUSAL, NOT AN EMPTY FILE. This fallback replaced
  # partial evidence with nothing and carried on scanning, so a commit whose
  # object exceeds a limit the hook inherits -- a large benign message prefix with
  # prohibited metadata after the cut -- passed, while git still transferred the
  # WHOLE object through the push pipe (shardpilot/shardpilot-go#79 review). Same
  # shape as the scanner copy fixed one round earlier: a failure that produces a
  # readable artifact is the dangerous kind, because everything downstream reads
  # it as an answer.
  read_evidence "$tmpdir/committed-object" write "the commit object for $1" cat-file commit "$1"
  stage_evidence "$1" scripts/commit-object-as-committed.txt "$tmpdir/committed-object"

  # ⚠ AND THE TREE'"'"'S PATH NAMES, INCLUDING EMPTY SUBTREES. The scan worktree'"'"'s
  # index cannot carry an empty directory: `read-tree` writes no entry for one,
  # staging the synthetic evidence files invalidates the cached tree, and the
  # scanner'"'"'s `write-tree` rebuild silently drops it -- so a commit containing an
  # explicitly constructed empty subtree whose DIRECTORY NAME carries prohibited
  # material published that name with nothing in the index or the commit object
  # exposing it (shardpilot/shardpilot-go#79 review). The commit object records
  # only the root tree id, so it cannot answer this either.
  #
  # `-rt` shows trees when recursing, which is precisely the entry `-r` alone
  # hides; the listing is staged like the rest so the same rules read it.
  read_evidence "$tmpdir/committed-tree" write "the tree listing of $1" ls-tree -rt "$1"
  stage_evidence "$1" scripts/commit-tree-as-committed.txt "$tmpdir/committed-tree"

  # ⚠ AND THE REF NAME IS PUBLISHED. A clean tree, a clean object, and a branch
  # called after an internal identifier still puts that identifier in the public
  # repository -- the third widening of "what does a push make reachable", after
  # trees and then commit objects (shardpilot/shardpilot-go#79 review). It is
  # staged like the rest so the same rules read it.
  run_evidence "$tmpdir/pushed-ref-name" write "the pushed ref name" printf '%s\n' "$3"
  stage_evidence "$1" scripts/pushed-ref-as-committed.txt "$tmpdir/pushed-ref-name"

  if [ -n "${4:-}" ] && [ -s "$4" ]; then
    stage_evidence "$1" scripts/tag-object-as-committed.txt "$4"
  fi
  if [ -n "${5:-}" ] && [ -s "$5" ]; then
    stage_evidence "$1" scripts/tag-target-as-committed.txt "$5"
  fi
  # Each tagged-tree blob keeps its own name, so the scanner classifies it the way
  # it would classify the published file.
  if [ -n "${6:-}" ] && [ -d "$6" ]; then
    for tb in "$6"/*; do
      [ -f "$tb" ] || continue
      # No suffix test: every file here is a blob, because the modes are elsewhere.
      tbmode=100644
      if [ -f "$6.modes/${tb##*/}" ]; then
        tbmode="$(cat "$6.modes/${tb##*/}")"
      fi
      case "$tbmode" in 100644|100755|120000) ;; *) tbmode=100644 ;; esac
      stage_evidence "$1" "scripts/tag-tree-${tb##*/}" "$tb" "$tbmode"
    done
  fi

  # ⚠ AND `git add` IS A CLEAN FILTER TOO. Staging the trusted scanner with it
  # would run whatever driver the branch's attributes name, on the way in
  # (shardpilot/shardpilot-go#79 review). The file is written to disk because the
  # shell must execute it -- these are OUR bytes, not the branch's -- and staged
  # by object id, past the filters entirely.
  # ⚠ CHECKED EXPLICITLY, because `set -e` DOES NOT APPLY HERE. Every call to
  # this function is the left side of `||`, and bash disables errexit throughout
  # such a body -- so a truncated copy continued, `chmod` made the partial file
  # executable, and a truncation landing inside the leading comment block yields a
  # valid shell script that exits 0 before installing the fail-closed trap: an
  # unscanned push reported as clean (shardpilot/shardpilot-go#79 review).
  #
  # And the comparison, not just the exit codes: what runs must be what was
  # trusted. A copy that "succeeded" and differs is the same failure wearing a
  # zero.
  mkdir -p "$wt/scripts" || { printf 'REFUSING: could not create %s.\n' "$wt/scripts" >&2; exit 2; }
  if ! cp "$scanner" "$wt/scripts/check_public_surface.sh" ||
     ! chmod +x "$wt/scripts/check_public_surface.sh" ||
     ! cmp -s "$scanner" "$wt/scripts/check_public_surface.sh"; then
    printf 'REFUSING: the trusted scanner could not be placed for the scan.\n' >&2
    printf '  A partial copy that is executable is worse than none: a truncation\n' >&2
    printf '  inside its leading comments is a valid script that exits 0.\n' >&2
    exit 2
  fi
  # ⚠ AND THIS ONE REFUSES TOO, like its sibling forty lines above. It read
  # `if [ -n "$sblob" ]` and ended in `|| true`, so a failure to hash or to stage
  # the trusted scanner was silently skipped -- and the scan then ran against an
  # index that does not contain the scanner it is executing, which is the same
  # sentence that stands over the other call: unstaged evidence is unread evidence.
  # Two sites, one written to refuse and one to shrug (shardpilot/shardpilot-go#79
  # review, second site of the reported class). "Could not measure" is not "nothing
  # to do".
  sblob="$( git_safe hash-object -w --no-filters -- "$scanner" 2>/dev/null )"
  if [ -z "$sblob" ] || ! in_worktree update-index --add \
       --cacheinfo "100755,$sblob,scripts/check_public_surface.sh" >/dev/null 2>&1; then
    printf 'REFUSING: could not stage the trusted scanner for the scan of %s.\n' "$1" >&2
    printf '  The scan would then read an index that does not contain the scanner\n' >&2
    printf '  it is running, and report on a tree it was not given.\n' >&2
    exit 2
  fi
  # ⚠ NO BASE REF RATHER THAN A BASE THAT IS NOT A COMMIT. An empty destination has
  # nothing to compare against, and the scanner documents an unset variable as the
  # legal skip for exactly that; handing it the empty TREE made `^{commit}` fail and
  # it refused every first push (shardpilot/shardpilot-go#79 review). My first
  # repair of the unborn case substituted a value where the answer is "there is
  # none" -- the same substitution as putting HEAD in for a tag's target, two
  # rounds ago.
  # ⚠ "NO BASELINE" IS A DECISION THE CALLER MAKES, NOT A PROBE RESULT. This asked
  # `cat-file -e` and treated a FAILURE as proof that no commit baseline exists -- so
  # a temporarily unreadable object store, or a promisor read that did not answer,
  # ran the trusted scanner with `PUBLIC_SURFACE_BASE_REF` unset, and it explicitly
  # SKIPS its baseline-vs-target ratchet: the push was approved after the only
  # comparative check had been silently removed (shardpilot/shardpilot-go#79 review).
  #
  # The intent is carried by the VALUE: every path that means "there is no ancestry
  # to compare" passes the empty tree, and nothing else does. Anything else must
  # resolve to a commit or this gate cannot speak for the comparison.
  if [ "$2" = "$(git hash-object -t tree /dev/null)" ]; then
    ( cd "$wt" && unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE PUBLIC_SURFACE_BASE_REF &&
      ./scripts/check_public_surface.sh )
  elif git cat-file -e "$2^{commit}" 2>/dev/null; then
    ( cd "$wt" && unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE &&
      PUBLIC_SURFACE_BASE_REF="$2" ./scripts/check_public_surface.sh )
  else
    printf 'REFUSING: the baseline %s could not be read, so the ratchet would run\n' "$2" >&2
    printf '  against nothing while reporting that it ran.\n' >&2
    exit 2
  fi
  rc=$?
  git_safe worktree remove --force "$wt" >/dev/null 2>&1 || rm -rf "$wt"
  return $rc
}

# The whole push, read once: a single ref cannot answer questions about the push
# it is part of. A here-string keeps the loop in this shell, so `status` survives
# it -- a pipe would run it in a subshell and every failure would be discarded.
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac

  # ⚠ A TAG IS NOT ITS COMMIT. githooks(5) supplies the TAG OBJECT's id for an
  # annotated or signed tag, so comparing it to HEAD refused a standard release
  # push -- and `--follow-tags` with it -- forcing --no-verify past this gate for
  # an ordinary operation (shardpilot/shardpilot-go#79 review). The peeled object
  # decides eligibility; the tag object is scanned in its own right below,
  # because its annotation and signer metadata are published too.
  # ⚠ A TAG NEED NOT POINT AT A COMMIT. `git tag` accepts `[<commit> | <object>]`,
  # so an annotated tag on a tree or a blob peels to nothing and this fallback
  # left `peeled` as the tag's own id -- which can neither equal HEAD nor be an
  # ancestor of it, so a valid tag push was refused before it was scanned
  # (shardpilot/shardpilot-go#79 review). Such a tag has no tree to scan; what it
  # publishes is the tag OBJECT, and that is collected either way.
  # ⚠ A FAILING PEEL IS TWO DIFFERENT ANSWERS, AND THE FALLBACK GAVE BOTH THE SAME
  # ONE. The line here read `rev-parse --verify --quiet` FAILING as "not a commit"
  # -- true for a tag on a tree or a blob, and equally true when the read simply
  # did not succeed. In the second case `peeled` became the tag's own id,
  # `target_kind` became `tag`, and the created-ref path then selects the EMPTY-TREE
  # baseline: the commit content is still scanned, but the lane B comparative
  # ratchet is skipped and a regression is approved with a green tick
  # (shardpilot/shardpilot-go#79 review).
  #
  # This is the sixth instance of one sentence in this file: a probe's STATUS is
  # not its answer. The others were repaired by routing through `git_probe`, and
  # this one had been argued into an exception because the failure looked
  # informative. It is informative only if the question has exactly two outcomes,
  # and this one has three.
  #
  # So the source's type is asked FIRST, and a tag is peeled through `^{}` -- whose
  # failure is a failure. The fallback survives only where the target is VERIFIED
  # not to be a commit, which is the legal case it was written for: `git tag`
  # accepts `[<commit> | <object>]`, such a tag has no tree to scan, and what it
  # publishes is the tag OBJECT, collected either way.
  git_probe "the type of $local_sha" git cat-file -t "$local_sha"
  src_kind="$PROBE_OUT"
  if [ "$src_kind" = tag ]; then
    git_probe "the target type of the tag $local_sha" git cat-file -t "$local_sha^{}"
    if [ "$PROBE_OUT" = commit ]; then
      git_probe "the commit the tag $local_sha points at" \
        git rev-parse --verify --quiet "$local_sha^{commit}"
      peeled="$PROBE_OUT"
      target_kind=commit
    else
      # A verified non-commit target: the tag object is the whole of what is
      # published, exactly as before.
      peeled="$local_sha"
      target_kind=tag
    fi
  else
    peeled="$local_sha"
    target_kind="$src_kind"
  fi
  # ⚠ AN ANCESTOR IS ELIGIBLE FOR A TAG. `--follow-tags` publishes missing
  # annotated tags reachable from the refs being pushed, not only tags whose
  # target IS HEAD -- so requiring equality refused an otherwise standard branch
  # push because one of its tags pointed at the first of two commits
  # (shardpilot/shardpilot-go#79 review). A tag target that HEAD contains is
  # scannable from this checkout, which is all the eligibility test is for.
  # ⚠ THE REF SAYS WHETHER IT IS A TAG; THE OBJECT TYPE DOES NOT. Requiring
  # `peeled != local_sha` accepted only ANNOTATED ancestor tags, because a
  # LIGHTWEIGHT tag points straight at the commit and peels to itself -- so
  # `git push origin tag v1` for a tag on an earlier commit was refused, though
  # its target is exactly as scannable (shardpilot/shardpilot-go#79 review).
  # ⚠ THE DESTINATION SAYS WHAT IS BEING PUBLISHED, NOT THE SOURCE.
  # `git push origin HEAD~1:refs/tags/v1` supplies `HEAD~1` as the local ref, so
  # classifying by it rejected a valid tag push and demanded --no-verify for an
  # operation git explicitly permits (shardpilot/shardpilot-go#79 review). What
  # the remote will hold is what matters.
  case "$remote_ref" in
    refs/tags/*) is_tag=yes ;;
    *) is_tag=no ;;
  esac
  eligible=no
  # ⚠ NOT ONLY UNDER `refs/tags/`. Git restricts `refs/heads/*` to commits and
  # allows a blob or tree anywhere else -- `<blob>:refs/archive/snapshot` is a
  # valid push -- and keying eligibility on the TAG namespace left those updates
  # ineligible, so the only way to make one was `--no-verify`: a gate that forces
  # its own bypass (shardpilot/shardpilot-go#79 review). The evidence path below
  # does not depend on the namespace; it stages the published object and the ref
  # name, both of which exist here too.
  if [ "$target_kind" != commit ]; then
    # No commit means no tree and no ratchet baseline to compare against; the
    # object being published is the tag itself, which scan_ref_name collects.
    eligible=yes
  elif [ "$peeled" = "$head_sha" ]; then
    eligible=yes
  # ⚠ THE ANCESTRY IS THE WHOLE CRITERION. The extra clause asked whether the SOURCE
  # peeled from a tag or the DESTINATION was under refs/tags, and eligibility is
  # about neither: it is about whether this checkout can scan the commit, which
  # `--is-ancestor` answers on its own. `git push origin HEAD~1:refs/archive/snapshot`
  # was refused for failing a test about namespaces, leaving `--no-verify` as the
  # only way to make a push git accepts (shardpilot/shardpilot-go#79 review) --
  # the second time this gate has forced its own bypass over a namespace question.
  elif git merge-base --is-ancestor "$peeled" "$head_sha" 2>/dev/null; then
    eligible=yes
  fi
  if [ "$eligible" = no ]; then
    printf 'REFUSING: pushing %s, which is not your HEAD.\n' "${local_ref:-?}" >&2
    printf '  The commits are scanned from their own trees, but the base and the\n' >&2
    printf '  ratchet are read relative to the checked-out repository state.\n' >&2
    printf '  Check out %s and push again, or --no-verify and own it.\n' "${local_ref:-that ref}" >&2
    exit 2
  fi
  # ⚠ AND THERE IS NOTHING TO BE INCONSISTENT WITH WHEN HEAD IS UNBORN. This
  # compares the checkout against HEAD so that what is scanned is what is
  # published; with no HEAD there is no checkout state in the question at all, and
  # `git diff HEAD` aborts with `bad revision` -- refusing a non-commit push that
  # needs no commit (shardpilot/shardpilot-go#79 review). The eligibility branch
  # above already reaches `eligible=yes` for such an object without consulting
  # HEAD; this line had not been given the same condition.
  # ⚠ AND ONLY WHERE THERE IS A WORKING TREE TO DIFFER. In a bare repository both
  # `git diff` calls are fatal, and `! git diff` reads a FAILED probe as the answer
  # "it differs" -- so the gate refused a bare push saying the working tree differs
  # from HEAD, about a repository that has neither working tree nor index. That is
  # this file's own recurring class: a probe that cannot answer "no". `worktree_root`
  # is empty exactly when the earlier block established the repository is bare, so it
  # is the discriminator already computed rather than a second question.
  if [ -n "$head_sha" ] && [ -n "$worktree_root" ] &&
     { ! git diff --quiet HEAD -- || ! git diff --cached --quiet; }; then
    printf 'REFUSING: the index or working tree differs from HEAD.\n' >&2
    printf '  Commit or stash first, so what is scanned is what is published.\n' >&2
    exit 2
  fi

  # ⚠ A BASELINE MUST BE A COMMIT, AND THE PREVIOUS TARGET NEED NOT BE ONE. Force-
  # updating a tag that currently points at a blob or a tree TO a commit makes
  # `remote_sha` a non-commit, and every introduced commit was then scanned with
  # that value in PUBLIC_SURFACE_BASE_REF -- where `^{commit}` does not resolve, so
  # the scanner refused unconditionally and a legitimate push could not be made at
  # all (shardpilot/shardpilot-go#79 review). The fetch below exists for a tip that
  # is ABSENT; this one is present and simply is not a commit, which no fetch
  # changes.
  #
  # It is handed to the branch that already knows how to find a baseline when there
  # is no previous commit, rather than copied: my first attempt duplicated that
  # logic here and referred to a variable that branch had not yet set. The rig said
  # `base_ref: unbound variable` on the first run.
  # ⚠ FETCH FIRST, THEN ASK. The object may be ABSENT in a `--no-tags` clone, and
  # the test below then skipped -- while the fetch further down brought it in and
  # nothing asked again, leaving a non-commit in `$base` and refusing every
  # introduced commit (shardpilot/shardpilot-go#79 review). My previous fix put the
  # question in one place; it had to be placed after the answer could exist.
  case "$remote_sha" in
    *[!0]*)
      if ! git cat-file -e "$remote_sha" 2>/dev/null; then
        # ⚠ A HOOK'S FETCH MUST LEAVE NO TRACE. Without `--no-write-fetch-head` this
        # overwrites .git/FETCH_HEAD, so a developer who fetched a commit intending
        # `git merge FETCH_HEAD` silently merges the destination's default branch
        # instead, because a push ran in between. Without `--no-tags` it can
        # auto-follow tags into the fetched history and create them locally, in a
        # clone made with --no-tags on purpose (shardpilot/shardpilot-go#79 review).
        #
        # ⚠ AND THIS IS THE ONLY PLACE THE OBJECT IS OBTAINED, so the type question
        # below sees the result. The retry used to sit AFTER that question: a first
        # fetch failing transiently and a retry succeeding left a blob or a tree as
        # `base`, `scan_commit` saw no PUBLIC_SURFACE_BASE_REF, and the lane-B
        # baseline ratchet was skipped SILENTLY (same review). A question asked
        # before its answer can still change is asked of the wrong state.
        # ⚠ TWICE, BECAUSE THE OLD SHAPE RETRIED AND HOISTING IT MUST NOT COST
        # THAT. Collapsing the two attempts into one made a transient first failure
        # fatal for a push the previous code recovered -- a repair that fixes the
        # ordering by removing the tolerance is a second defect
        # (found by the rig for shardpilot/shardpilot-go#79 review).
        git fetch --quiet --no-tags --no-write-fetch-head -- "$dest" "$remote_sha" 2>/dev/null ||
          git fetch --quiet --no-tags --no-write-fetch-head -- "$dest" "$remote_sha" 2>/dev/null || true
      fi
      ;;
  esac
  # ⚠ AND THE TYPE IS ASKED, NOT INFERRED FROM A SECOND PROBE'S FAILURE. Existence
  # was just established, so a non-zero `rev-parse --verify` here meant "not a
  # commit" -- and means exactly the same thing when the probe fails transiently, at
  # which point the pre-push tip is replaced by zero and the comparison silently
  # moves to the destination's default branch (shardpilot/shardpilot-go#79 review).
  # A more permissive baseline there passes a regression against the ref actually
  # being updated. `cat-file -t` states the type, and its failure is a refusal.
  # ⚠ AND THE QUESTION IS WHETHER IT PEELS TO A COMMIT, not what the outer object
  # is. `cat-file -t` on an annotated tag whose target is a commit answers `tag`, so
  # the previous round's repair discarded a perfectly good commit baseline and moved
  # the comparison to the destination's default branch -- where a more permissive
  # Lane-B baseline passes a regression against the ref actually being updated
  # (shardpilot/shardpilot-go#79 review). That repair removed an ambiguous FAILURE
  # and introduced a wrong SUBJECT.
  #
  # The peel answers it, and the failure channel stays separate: `^{commit}` resolving
  # is the yes; it not resolving is ambiguous on its own, so the type is then asked of
  # an object whose existence is already proven, and a failure of THAT is a refusal.
  remote_is_commit=yes
  if git cat-file -e "$remote_sha" 2>/dev/null; then
    if ! git rev-parse --verify --quiet "$remote_sha^{commit}" >/dev/null 2>&1; then
      git_probe "the type of $remote_sha" git cat-file -t "$remote_sha"
      [ "$PROBE_OUT" = commit ] || remote_is_commit=no
    fi
  fi
  if [ "$remote_is_commit" = no ]; then
    printf 'public surface: %s previously held a non-commit object; comparing against the default branch\n' \
      "${remote_ref:-the remote ref}"
    remote_sha=0000000000000000000000000000000000000000
  fi
  case "$remote_sha" in
    *[!0]*)
      base="$remote_sha"
      why="the pre-push tip of ${remote_ref:-the remote ref}"
      # Reaching here means the object is ABSENT: it was fetched above if it was
      # obtainable, and a present non-commit zeroed `remote_sha` and took the
      # default-branch branch below. A gate is not entitled to fetch twice.
      if ! git rev-parse --verify --quiet "$base^{commit}" >/dev/null 2>&1; then
        printf 'REFUSING: the pre-push tip %s is not here and could not be fetched.\n' "$base" >&2
        exit 2
      fi
      ;;
    *)
      # ⚠ A COMBINED PUSH BRINGS ITS OWN BASELINE. When one invocation both
      # updates the destination's default branch and creates another ref, the
      # remote still advertises the OLD default tip while the new one is in this
      # very push -- so the created ref was compared against a baseline about to
      # stop existing (shardpilot/shardpilot-go#79 review). The pushed lines are
      # the authority on what the default branch is becoming.
      # ⚠ THE ADVERTISED REF IS KEPT WHOLE, and the short name is derived from it.
      # `sub("refs/heads/","",$2)` is a no-op for a HEAD that points outside
      # `refs/heads/*` -- `refs/archive/base` is a legal symref target -- so the
      # fetch below asked for `refs/heads/refs/archive/base` and every created-ref
      # push was refused (shardpilot/shardpilot-go#79 review). Stripping a prefix
      # that may not be there produces a value that LOOKS like a branch name.
      # ⚠ A DETACHED HEAD ADVERTISES AN OID AND NO `ref:` ROW. The parser kept only
      # the symref, so a destination whose HEAD is detached at a commit refused every
      # created-ref push for "no default branch" -- while the exact baseline was in the
      # advertisement all along (shardpilot/shardpilot-go#79 review). No guess is
      # needed when the object id is stated.
      # ⚠ AND A FAILED PROBE IS NOT AN ANSWER, which the enumeration forty lines down
      # already knows about itself. `|| ls_head=""` turned a transient failure into an
      # empty advertisement, and empty reads as "this destination advertises no default
      # branch" -- so every created-ref push was refused for a fact the probe never
      # established (shardpilot/shardpilot-go#79 review). The later non-symref
      # enumeration cannot recover it: `--symref` is the option that shows the
      # underlying ref. Same pattern as `ls_rc`, at the probe written before it.
      ls_head_rc=0
      ls_head="$(git ls-remote --symref -- "$dest" HEAD 2>/dev/null)" || ls_head_rc=$?
      if [ "$ls_head_rc" -ne 0 ]; then
        printf 'REFUSING: could not read the HEAD advertisement of %s (git exited %s).\n' "$safe_dest" "$ls_head_rc" >&2
        printf '  A probe that failed prints nothing, and nothing here reads as "this\n' >&2
        printf '  destination advertises no default branch" -- which would refuse the\n' >&2
        printf '  push for a fact that was never established.\n' >&2
        exit 2
      fi
      branch_ref="$(printf '%s\n' "$ls_head" \
        | awk '$1=="ref:" && $3=="HEAD" && !seen {print $2; seen=1}')"
      detached_head=""
      if [ -z "$branch_ref" ]; then
        detached_head="$(printf '%s\n' "$ls_head" \
          | awk '$2=="HEAD" && !seen {print $1; seen=1}')"
        case "$detached_head" in
          ""|*[!0-9a-f]*) detached_head="" ;;
        esac
      fi
      branch="${branch_ref#refs/heads/}"
      unborn=no
      if [ -z "$branch" ]; then
        # ⚠ AN EMPTY DESTINATION HAS NO DEFAULT BRANCH, AND THAT IS NOT A REFUSAL.
        # A bare repository just initialised advertises NOTHING -- its HEAD names an
        # unborn branch, so `ls-remote --symref` returns no rows -- and the first
        # push to it was refused, leaving `--no-verify` as the only way to start a
        # repository (shardpilot/shardpilot-go#79 review). Nothing is published
        # there, so there is no baseline to be wrong about: every introduced commit
        # is new, and the empty tree says exactly that.
        # ⚠ EMPTY OUTPUT FROM A FAILED COMMAND IS NOT AN EMPTY DESTINATION. The
        # status and stderr were discarded, so a transient failure of THIS
        # enumeration read as "advertises no refs at all" -- and the hook then
        # exited 0 with the base ref unset, bypassing the ratchet, on a destination
        # that has refs (shardpilot/shardpilot-go#79 review). Reproduced with a bare
        # remote holding `refs/heads/main` and a dangling HEAD.
        #
        # The status is captured, and `--exit-code` makes the two answers
        # distinguishable: 0 with rows, 2 for "no matching refs", anything else is a
        # failure. Only 2 means empty; a failure refuses.
        # ⚠ NO PIPELINE HERE: `$?` AFTER `git … | head -1` IS `head`'S STATUS, and
        # `head` succeeds on empty input, so the capture would report success for
        # every outcome -- the same defect this finding is about, one layer along. My
        # first version of this fix had it, and the probe I wrote to check the
        # statuses had it too: all three cases reported 0 until the pipe came out.
        # Measured without it: empty → 2, nonempty → 0, unreachable → 128.
        # ⚠ AND THE ASSIGNMENT IS IN A CONDITION, because `set -e` kills the script on
        # an assignment from a command substitution that exits non-zero -- and the
        # WHOLE POINT here is a non-zero exit. Written plainly, `--exit-code`'s 2 for
        # an empty destination aborted the hook before the status could be read, and
        # the first-push scene turned red: the fix refused the case it was written to
        # allow. The regression suite named it on the first run after the change.
        ls_rc=0
        ls_out="$(git ls-remote --exit-code -- "$dest" 2>/dev/null)" || ls_rc=$?
        if [ "$ls_rc" -ne 0 ] && [ "$ls_rc" -ne 2 ]; then
          printf 'REFUSING: could not enumerate the refs of %s (git exited %s).\n' "$safe_dest" "$ls_rc" >&2
          printf '  An enumeration that failed prints nothing, and nothing reads as\n' >&2
          printf '  "this destination is empty" -- which unsets the baseline and lets\n' >&2
          printf '  the ratchet through on a repository that has refs.\n' >&2
          exit 2
        fi
        if [ "$ls_rc" -eq 2 ]; then
          unborn=yes
          base="$(git hash-object -t tree /dev/null)"
          why="the empty tree, because $safe_dest advertises no refs at all"
        elif [ "$target_kind" != commit ]; then
          # ⚠ AND A PUSH THAT INTRODUCES NO COMMIT ASKS NO BASELINE QUESTION. The
          # refusal above is about GUESSING a branch name, which matters because a
          # wrong guess yields a wrong, higher ratchet baseline. A blob or a tree has
          # no ancestry to compare, and the eligibility branch above already reaches
          # `eligible=yes` for one without consulting a baseline at all -- so
          # refusing here withheld a push whose baseline is not consulted
          # (shardpilot/shardpilot-go#79 review). The empty tree is what the
          # no-refs-at-all branch uses for the same reason.
          unborn=yes
          base="$(git hash-object -t tree /dev/null)"
          why="the empty tree, because this update introduces no commit and has no ancestry to compare"
        elif [ -n "$detached_head" ]; then
          # ⚠ AND A STATED OBJECT ID NEEDS NO GUESS. The refusal below exists because
          # guessing a default-branch NAME turns a fork or a rename into the wrong
          # baseline. A detached HEAD states the commit outright, so there is no name
          # to guess -- and the destination proving nonempty was being used to refuse
          # a push whose baseline was in the advertisement all along
          # (shardpilot/shardpilot-go#79 review).
          base="$detached_head"
          why="the commit $safe_dest advertises at its detached HEAD"
          if ! git cat-file -e "$base^{commit}" 2>/dev/null &&
             ! git fetch --quiet --no-tags --no-write-fetch-head -- "$dest" "$base" 2>/dev/null; then
            printf 'REFUSING: the advertised HEAD %s is not here and could not be fetched.\n' "$base" >&2
            exit 2
          fi
        else
          printf 'REFUSING: %s did not advertise a default branch (HEAD symref).\n' "$safe_dest" >&2
          printf '  Guessing a name is how a fork or a rename becomes the wrong,\n' >&2
          printf '  higher baseline.\n' >&2
          exit 2
        fi
      fi
      # ⚠ A UNIQUE REF PER INVOCATION. Resolving a shared ref "immediately"
      # after fetching it is still two commands, and a concurrent push can land
      # between them -- so the previous fix narrowed the window instead of
      # closing it (shardpilot/shardpilot-go#79 review). A name no other
      # invocation uses has no window at all.
      # ⚠ A PID IS NOT UNIQUE, AND `+` OVERWRITES. A pid is reused after wraparound
      # and a user may simply own `refs/prepush-base-<n>`, so the force refspec
      # would overwrite someone's ref and the cleanup would then DELETE it -- even
      # when the fetch failed before creating anything
      # (shardpilot/shardpilot-go#79 review). The name carries the tmpdir's random
      # component, which mktemp guarantees is unused, and cleanup removes the ref
      # only after this hook has actually created it.
      # ⚠ AND A NON-COMMIT PUSH ASKS NO BASELINE QUESTION HERE EITHER. The
      # advertised `HEAD` may itself point at a blob or a tree, so the fetch
      # succeeds and `^{commit}` yields nothing -- and the empty-base check below
      # then refused a push whose scan never needs a commit baseline
      # (shardpilot/shardpilot-go#79 review). The no-symref branch already takes the
      # empty tree for exactly this case; this one had the condition and not the
      # reason. Third place in this file where "not a commit" had to be carried
      # after the first two were fixed.
      if [ "$target_kind" != commit ]; then
        unborn=yes
        base="$(git hash-object -t tree /dev/null)"
        why="the empty tree, because this update introduces no commit and has no ancestry to compare"
      fi
      if [ "$unborn" = no ]; then
      base_ref="refs/prepush-base-$$-${tmpdir##*/}"
      if git rev-parse --verify --quiet "$base_ref" >/dev/null 2>&1; then
        printf 'REFUSING: %s already exists; refusing to overwrite a ref this hook did not create.\n' \
          "$base_ref" >&2
        exit 2
      fi
      # ⚠ HOOKS OFF FOR THIS FETCH TOO. It updates a ref, so a `reference-transaction`
      # hook runs for it -- one that rejects unfamiliar namespaces aborts the fetch
      # and makes this gate refuse a valid push, and one with side effects fires for
      # an internal ref that is deleted moments later
      # (shardpilot/shardpilot-go#79 review). Every other git command here already
      # runs through `git_safe`; this one had been written before that existed.
      # ⚠ FETCH WHAT WAS ADVERTISED, NOT WHAT IT POINTS AT. `$branch_ref` is HEAD's
      # symref TARGET, and a destination may advertise the symref while HIDING the
      # target -- `uploadpack.hideRefs=refs/heads/main` with `HEAD -> refs/heads/main`
      # advertises both the symref row and HEAD's object id, and a fetch of
      # `refs/heads/main` then fails while a fetch of `HEAD` succeeds. Every
      # created-ref push to such a destination was refused
      # (shardpilot/shardpilot-go#79 review). The name is still carried for the
      # message below, because a refusal that cannot say WHICH branch is a refusal an
      # operator cannot act on.
      if ! git_safe fetch --quiet --no-tags --no-write-fetch-head -- "$dest" \
           "+HEAD:$base_ref" 2>/dev/null; then
        printf 'REFUSING: could not fetch %s from %s to compare against.\n' "$branch" "$safe_dest" >&2
        exit 2
      fi
      # ⚠ RESOLVED TO A SHA IMMEDIATELY, and the ref dropped. Two concurrent
      # created-ref pushes from this repository would otherwise both fetch into
      # the same `refs/prepush-base`, and one could overwrite it between the
      # other's assignment and its scan -- comparing against another
      # destination's baseline (shardpilot/shardpilot-go#79 review). A SHA
      # cannot be overwritten.
      base="$(git rev-parse --verify --quiet "$base_ref^{commit}" || true)"
      # ⚠ AND THE DESTINATION'"'"'S OWN HEAD MAY NOT BE A COMMIT. The branch above asks
      # whether the PUSHED target is one; this asks the mirror question, and the two
      # are independent -- a commit pushed to a ref whose destination advertises a
      # blob or a tree fetches fine, peels to nothing, and was refused as "did not
      # resolve" though its scan needs no commit baseline
      # (shardpilot/shardpilot-go#79 review). Fourth place in this file where "not a
      # commit" had to be carried.
      #
      # A FAILED PROBE IS NOT A NON-COMMIT: if the type cannot be read, `base` stays
      # empty and the refusal below stands, which is the safe direction.
      if [ -z "$base" ] && base_kind="$(git cat-file -t "$base_ref" 2>/dev/null)" \
         && [ -n "$base_kind" ] && [ "$base_kind" != commit ]; then
        base="$(git hash-object -t tree /dev/null)"
        base_noncommit="$base_kind"
      fi
      git_safe update-ref -d "$base_ref" 2>/dev/null || true
      base_ref=""
      fi
      # ⚠ A READER THAT EXITS EARLY KILLS ITS WRITER. `awk … exit` closes the pipe
      # while `printf` is still writing, `printf` takes SIGPIPE, and under `pipefail`
      # the substitution's status is 141 -- which `set -e` turns into this gate
      # REFUSING a valid push. Reproduced with a combined push whose refspec exceeds
      # the pipe buffer (shardpilot/shardpilot-go#79 review). Third instance of this
      # shape here, so the population was greped rather than recalled; the sibling
      # symref reader above took the same repair. The match is still the FIRST one.
      incoming="$(printf '%s\n' "$pushed_lines" \
        | awk -v r="$branch_ref" '$3==r && !seen {print $2; seen=1}')"
      # ⚠ ALL ZEROES IS A DELETION, AND IT IS HEX. One push may delete the
      # destination's default branch while creating another ref, and the zero object
      # passed the hex-only test below and became the baseline -- handed to the
      # scanner as PUBLIC_SURFACE_BASE_REF, where it resolves to nothing
      # (shardpilot/shardpilot-go#79 review). A validation that asks about the
      # ALPHABET cannot see a value whose meaning is "no object".
      case "$incoming" in
        *[!0]*) ;;
        *) incoming="" ;;
      esac
      # ⚠ A PUSH IS NOT ATOMIC UNLESS IT SAYS SO, AND THIS HOOK CANNOT SEE THAT IT
      # DID. The sibling update's incoming tip was taken as the baseline because
      # "the pushed lines are the authority on what the default branch is becoming"
      # -- true only if that update LANDS. `--atomic` is a separate request, and an
      # ordinary push can have the default-branch update rejected as non-fast-forward
      # while the created ref succeeds: the two local refs then name the same tip,
      # `base` equals the pushed commit, zero commits are introduced, and the ratchet
      # runs against nothing (shardpilot/shardpilot-go#79 review).
      #
      # The advertised tip is used instead. It can only be OLDER, so the range can
      # only be LARGER -- more commits scanned, never fewer, which is the direction
      # this gate must fail in. What it costs: when the sibling update does land, the
      # commits it introduces are scanned by this push as well as by their own.
      case "$incoming" in
        ""|*[!0-9a-f]*) ;;
        *) if [ "$incoming" != "$base" ]; then
             printf 'public surface: %s is also updated by this push; NOT using its incoming tip, because this push is not known to be atomic\n' "$branch"
           fi ;;
      esac
      if [ -z "$base" ]; then
        printf 'REFUSING: fetched %s from %s but it did not resolve.\n' "$branch" "$safe_dest" >&2
        exit 2
      fi
      why="the default branch of the destination, ${branch}, because this push CREATES ${remote_ref:-the ref}"
      if [ -n "${base_noncommit:-}" ]; then
        why="the empty tree, because the destination's advertised HEAD is a ${base_noncommit} and offers no commit baseline"
      fi
      ;;
  esac

  # EVERY COMMIT THE PUSH INTRODUCES, oldest first. Each one becomes reachable
  # in a public repository the moment this push succeeds.
  # ⚠ ALREADY-PUBLISHED COMMITS ARE NOT THIS PUSH'S TO PUBLISH. Merging a
  # feature branch the destination already exposes brought its whole history
  # into the range, so the gate rescanned commits that are public regardless of
  # this push -- slow, and it charges one push for another's content
  # (shardpilot/shardpilot-go#79 review). Every other ref the destination
  # advertises is excluded.
  # ⚠ EVERY ADVERTISED REF, NOT ONLY HEADS AND TAGS. `--heads --tags` limits the
  # query to those two namespaces, and this repository's own .gitleaksignore
  # records that `refs/pull/*/head` is advertised public history -- so a commit
  # published only through a pull ref was counted as newly introduced, and
  # creating a branch at it could be refused by the commit budget or the lane-B
  # ratchet for republishing what is already public
  # (shardpilot/shardpilot-go#79 review).
  # ⚠ AND THE STATUS, BECAUSE EMPTY OUTPUT HAS TWO MEANINGS. A transient failure
  # here prints nothing, and nothing reads as "the destination publishes no refs"
  # -- so commits already reachable from another advertised ref were counted as
  # newly introduced and the push could be refused by the commit budget or the
  # ratchet for republishing what is already public
  # (shardpilot/shardpilot-go#79 review). This is the twelfth status-discarding
  # substitution in this file, found the same way as the eleventh, and it is the
  # one that fails towards a false REFUSAL rather than a false pass.
  #
  # `--exit-code` distinguishes them: 2 is "no matching refs", which is a real
  # empty set, and anything else nonzero is the transport failing.
  pub_rc=0
  published_raw="$(git ls-remote --exit-code -- "$dest" 2>/dev/null)" || pub_rc=$?
  if [ "$pub_rc" -ne 0 ] && [ "$pub_rc" -ne 2 ]; then
    printf 'REFUSING: could not enumerate the published refs of %s (git exited %s).\n' \
      "$safe_dest" "$pub_rc" >&2
    printf '  An enumeration that failed prints nothing, and nothing reads as "this\n' >&2
    printf '  destination publishes nothing" -- which charges the push for commits it\n' >&2
    printf '  is not introducing.\n' >&2
    exit 2
  fi
  published="$(printf '%s\n' "$published_raw" | awk 'NF{print $1}')"
  # ⚠ ONE ROUND TRIP, NOT ONE PER TIP. A repository advertising hundreds of refs
  # made this a serial fetch per missing tip -- minutes of gate for a push that
  # takes seconds, which is how a gate gets uninstalled
  # (shardpilot/shardpilot-go#79 review). The batch is attempted first; a batch
  # dies entirely if any ONE of its tips is unfetchable, so the per-tip loop
  # below stays as the fallback and still answers for whatever remains missing.
  missing=""
  for p in $published; do
    git cat-file -e "$p^{commit}" 2>/dev/null || missing="$missing $p"
  done
  if [ -n "$missing" ]; then
    # shellcheck disable=SC2086
    git fetch --quiet --no-tags --no-write-fetch-head -- "$dest" $missing 2>/dev/null || true
  fi
  excl=""
  for p in $published; do
    # ⚠ THE PUSHED SHA IS NOT AN EXCEPTION -- IT IS THE EVIDENCE. Creating a ref
    # at the tip of an already-published branch means `ls-remote` advertises
    # exactly that SHA, and skipping it made the hook treat public history as
    # newly introduced: rescanned against the default branch, and refusable on
    # the budget or the ratchet for publishing nothing but a name
    # (shardpilot/shardpilot-go#79 review).
    # ⚠ FETCH WHAT IS NOT HERE. Silently skipping an unresolvable advertised tip
    # counted history that IS already public as newly introduced, which can
    # refuse a legitimate push at the budget (shardpilot/shardpilot-go#79
    # review). One fetch answers it; a failure only costs the exclusion.
    git cat-file -e "$p^{commit}" 2>/dev/null \
      || git fetch --quiet --no-tags --no-write-fetch-head -- "$dest" "$p" 2>/dev/null || true
    git cat-file -e "$p^{commit}" 2>/dev/null && excl="$excl ^$p"
  done
