#!/usr/bin/env bash
#
# RUN THE PUBLIC-SURFACE GATE AGAINST WHAT IS ACTUALLY BEING PUSHED.
#
# This is the only PUBLIC repository in the platform, and a repository publishes
# its HISTORY along with its tree. A commit carrying internal material is
# published the moment it is pushed -- not when it merges -- so a gate that runs
# only in CI catches it one step too late, and the remedy is a branch rewrite
# rather than a fix.
#
# WHY A HOOK AND NOT A make TARGET. The question the gate has to answer is
# "which commit will CI compare this against", and CI's answer depends on the
# REFSPEC being pushed:
#
#     push to an EXISTING ref  -> github.event.before, the pre-push tip
#     push CREATING a ref      -> the repository's default branch
#
# A Makefile cannot know the refspec. A `make check` target tried, and ten
# review rounds each found another way the guess was wrong -- narrow fetch
# configurations, `push.default`, forks whose default is not `main`, tags
# shadowing short names, remotes named with slashes or leading dashes. Every
# fix modelled a little more of git's own ref resolution.
#
# git hands a pre-push hook exactly what it could not guess. Per `githooks(5)`,
# each line on stdin is:
#
#     <local ref> <local sha> <remote ref> <remote sha>
#
# `<remote sha>` IS `github.event.before` for an existing ref, and all zeros
# when the ref is being created. So the base is read, not derived.
#
# ⚠ WHAT THIS REFUSES RATHER THAN GUESSES. `check_public_surface.sh` scans the
# tree `git write-tree` writes -- your INDEX. That is only the tree being
# pushed when the pushed tip IS your HEAD and nothing is uncommitted. When it is
# not -- `git push origin other-branch:main`, a dirty tree, a detached push --
# this hook REFUSES instead of scanning something else and reporting on it. The
# Makefile scanned anyway and documented the gap in a comment; a comment is not
# a gate.
#
# ⚠ INSTALL BY COPY, AND PIN core.hooksPath TO THE PHYSICAL DIRECTORY.
#
#     h="$(git rev-parse --git-common-dir)/hooks"
#     cp .githooks/pre-push "$h/pre-push"
#     cp scripts/check_public_surface.sh "$h/"
#     chmod +x "$h/pre-push" "$h/check_public_surface.sh"
#     git config --local core.hooksPath "$h"
#
# Three things, each closing a way the gate was silently absent:
#
#   * BOTH FILES. Everything this hook EXECUTES must come from outside tracked
#     content -- the scanner as much as the hook -- or a branch you are
#     inspecting supplies its own checker.
#   * `--git-common-dir`, NOT `--git-dir`. In a linked worktree the latter names
#     `.git/worktrees/<name>` while git reads hooks from the common directory,
#     so the copy lands where git never looks.
#   * `git config --local core.hooksPath "$h"`. The earlier instruction was
#     `git config --unset core.hooksPath`, which cannot clear a GLOBAL or SYSTEM
#     setting -- measured: with an inherited value, `--git-path hooks` still
#     resolves to it and the hook is never invoked. A LOCAL setting overrides an
#     inherited one, so the path is pinned rather than unset
#     (shardpilot/shardpilot-go#79 review).
#
# The copies do not update themselves: re-copy when either file changes. That is
# the trade, and it is the right way round -- a hook that updates itself from the
# branch it is inspecting is not a gate.
#
# Bypassing is `git push --no-verify`, which is a decision to publish unscanned.

set -euo pipefail

# See the note above: every read below must see the objects a push transfers.
export GIT_NO_REPLACE_OBJECTS=1

# ⚠ AND THE CALLER'S ALTERNATE INDEX MUST NOT LEAK IN. `git push` invoked with
# GIT_INDEX_FILE set passes it to this hook, and every `git add` below -- plus
# the scanner's own fixture repositories -- would then read and MUTATE that
# index instead of the worktree's private one, which is exactly the collision
# this design exists to avoid (shardpilot/shardpilot-go#79 review).
unset GIT_INDEX_FILE

# ⚠ NOTHING FROM THE PUSHED BRANCH MAY RUN. `git worktree add` fires
# post-checkout, and where core.hooksPath still points at tracked content that hook is
# TRACKED CONTENT -- so a branch from an untrusted contributor would execute
# arbitrary code on this machine merely by being inspected, before any scan.
# Every git command below runs with hooks pointed at an empty directory.
hooks_off="$(mktemp -d)"
git_safe() { git -c core.hooksPath="$hooks_off" "$@"; }
# ⚠ THE TEMPORARIES AND THEIR TRAP ARE ONE STEP. Both directories were created
# here and at line ~170, with the trap installed only after the second -- so
# every refusal in between (a missing or non-executable scanner, the commonest
# one there is) left an empty directory behind for good
# (shardpilot/shardpilot-go#79 review). A cleanup that begins after the first
# thing that can exit is not cleanup.
tmpdir="$(mktemp -d)"
cleanup() {
  git_safe worktree remove --force "$tmpdir/wt" >/dev/null 2>&1 || true
  rm -rf "$tmpdir" "$hooks_off"
  # ⚠ NO GLOBAL PRUNE. `git worktree prune` removes the administrative record of
  # EVERY missing worktree, not only this one -- so an unrelated worktree on a
  # temporarily disconnected mount lost its metadata, and came back as "not a
  # repository" (shardpilot/shardpilot-go#79 review). Cleanup removes what this
  # hook created and nothing else.
  git update-ref -d "refs/prepush-base-$$" 2>/dev/null || true
}
trap cleanup EXIT

# ⚠ THE REFSPEC IS BUFFERED BEFORE ANYTHING TOUCHES A COMMIT-CONTROLLED PATH.
# A commit replacing the tracked scanner with a symlink to `/dev/stdin` made the
# drift check below read the hook's own input through it: `cmp` consumed the
# refspec line, `cat` then returned empty, the loop processed no updates, and the
# hook exited 0 without scanning the commit that did it
# (shardpilot/shardpilot-go#79 review). Reading anything the branch controls
# before this line is reading with the gate's own input at stake.
pushed_lines="$(cat)"

root="$(git rev-parse --show-toplevel)"
tracked_scanner="$root/scripts/check_public_surface.sh"

# ⚠ THE SCANNER MUST BE TRUSTED TOO, AND THE TRACKED ONE IS NOT.
#
# Installing the HOOK outside the worktree closed one execution path and left
# its twin open: `scripts/check_public_surface.sh` is tracked, so checking out an
# untrusted contributor's branch and pushing it made this hook copy THAT
# branch's scanner into the worktree and run it -- arbitrary code, before any
# trustworthy scan, exactly the thing the hook exists to prevent
# (shardpilot/shardpilot-go#79 review). Fixing the hook's own installation was
# necessary and not sufficient: everything this hook EXECUTES has to come from
# outside tracked content.
# ⚠ ASK GIT WHERE HOOKS LIVE. `--git-dir` in a LINKED WORKTREE names
# `.git/worktrees/<name>`, while git reads hooks from the COMMON dir -- so an
# install built on `--git-dir` puts the hook where git never looks and the gate
# is silently absent while appearing installed (shardpilot/shardpilot-go#79
# review). Measured here: `--git-dir` gave `.git/worktrees/…-hook`, and
# `--git-path hooks` gave `.git/hooks`, which is what git actually reads.
# ⚠ THE PHYSICAL HOOKS DIRECTORY, NOT THE CONFIGURED ONE. `--git-path hooks`
# HONOURS `core.hooksPath`, so on a repository still carrying the setting this
# file used to recommend it resolves back to `.githooks` -- tracked,
# branch-controlled, and the exact thing moving out of tracked content was meant
# to escape (shardpilot/shardpilot-go#79 review). Measured:
# `git -c core.hooksPath=.githooks rev-parse --git-path hooks` prints `.githooks`,
# while `--git-common-dir` prints the real one either way. Asking the authority
# was right; asking the resolver the USER can relocate was not.
# ⚠ ABSOLUTE. `--git-common-dir` answers `.git` in the MAIN worktree, and git
# resolves a RELATIVE core.hooksPath against the directory the hook runs in -- so
# a `.git/hooks` stored by the install resolves, inside a linked worktree, to a
# path where `.git` is a FILE, and the hook is never executed
# (shardpilot/shardpilot-go#79 review). Measured: main worktree `.git`, linked
# worktree an absolute path; the recovery hint printed the relative one too.
hooks_dir="$(cd "$(git rev-parse --git-common-dir)" 2>/dev/null && pwd)/hooks"
scanner="$hooks_dir/check_public_surface.sh"
if [ ! -x "$scanner" ] || [ ! -s "$scanner" ]; then
  # ⚠ `-s` AS WELL AS `-x`. A re-copy that lands while a push is running leaves
  # the destination truncated for an instant, and an empty scanner is executable
  # and exits 0 -- a gate that reports clean because there was nothing to run
  # (shardpilot/shardpilot-go#79 review). The install now publishes each file by
  # rename, so no truncated state is observable at all; this is the second half,
  # here because a gate should not depend on the install being followed.
  printf 'REFUSING: no usable trusted scanner at %s.\n' "$scanner" >&2
  printf '  Install it beside the hook, from a checkout you trust:\n' >&2
  # ⚠ THE HINT MUST NAME THE DIRECTORY THE CHECK USES. It printed `--git-dir`
  # while the lookup above searches `--git-common-dir`, so in a linked worktree
  # following the recovery instruction copied somewhere the next push would not
  # look, and refused identically (shardpilot/shardpilot-go#79 review). A
  # recovery hint that does not recover is a loop with a message attached.
  printf '    cp scripts/check_public_surface.sh %s/\n' "$hooks_dir" >&2
  printf '    chmod +x %s/check_public_surface.sh\n' "$hooks_dir" >&2
  printf '  Running the TRACKED copy would execute whatever the checked-out\n' >&2
  printf '  branch says it is.\n' >&2
  exit 2
fi
# Reading tracked content is safe; executing it is not. A drift warning keeps the
# trusted copy honest without trusting the branch.
# The drift note reads tracked content, so it refuses a symlink rather than
# following one: the point of reading is to compare bytes, and a symlink is a
# request to read somewhere else.
if [ -L "$tracked_scanner" ]; then
  printf 'NOTE: %s is a symlink; not comparing against it.\n' "scripts/check_public_surface.sh" >&2
elif [ -r "$tracked_scanner" ] && ! cmp -s "$scanner" "$tracked_scanner"; then
  printf 'NOTE: the trusted scanner differs from %s.\n' "scripts/check_public_surface.sh" >&2
  printf '  If that is an update you want, re-copy it; if it is a branch you are\n' >&2
  printf '  inspecting, this is exactly why the copy exists.\n' >&2
fi

remote_name="${1:-origin}"
# githooks(5): $2 is where the push is actually going. $1 may be a name or, for a
# direct-URL push, the URL itself.
dest="${2:-$remote_name}"

# ⚠ AND NEVER PRINT IT. A direct push URL or `remote.<name>.pushurl` can embed
# `user:token@`, and a diagnostic that echoes it puts the credential in terminal
# scrollback and CI logs -- a gate that exists to stop publication leaking one
# by complaining (shardpilot/shardpilot-go#79 review). Messages use the NAME, or
# a userinfo-stripped form when the name is itself a URL; the unmodified value
# goes only to ls-remote and fetch.
safe_dest="$remote_name"
case "$safe_dest" in
  *://*@*) safe_dest="$(printf '%s' "$safe_dest" | sed -E 's#(://)[^/@]*@#\1<redacted>@#')" ;;
esac

head_sha="$(git rev-parse HEAD)"
status=0

# scan_commit <commit> <base> -- scans that commit's tree, with TODAY'S scanner.
#
# ⚠ A TEMPORARY WORKTREE, NOT A TEMPORARY INDEX. The scanner is index-driven --
# `git write-tree` for the file list, `git cat-file blob :path` for content --
# so pointing GIT_INDEX_FILE at a per-commit index looks like the cheap answer.
# It is not: the scanner SELF-TESTS by building fixture repositories and running
# `git add -A` inside them, and an inherited GIT_INDEX_FILE redirects those
# writes into the per-commit index. Measured, not guessed: the index is
# corrupted mid-run, `git write-tree` then yields something that is not a tree,
# and the scanner refuses with "git ls-files failed". A worktree has its own
# index and the fixtures have theirs, so nothing collides.
#
# ⚠ AND TODAY'S SCANNER IS STAGED INTO IT. The scanner refuses to run unless it
# matches its staged copy -- a real protection, since an edited gate reporting
# clean is its worst failure. So the current scanner is written into the
# worktree and staged there: the tree examined is commit C's, except at the
# scanner's own path, and the rules applied are TODAY'S rather than the ones
# that shipped with C. That is the right direction -- a rule added since C
# should still catch what C published -- and it is a difference, so it is named.
# scan_ref_name <commit> <base> <ref> -- for a push that introduces no commits:
# the tree is already published, the NAME is not.
scan_ref_name() {
  printf 'public surface: no new commits; scanning the published ref name\n'
  # ⚠ THE COMMIT IS ITS OWN BASE HERE, and that is the whole of the difference.
  # This tree is ALREADY published -- an alias branch, or a missing annotated tag
  # for an older commit -- so the only new thing is the NAME. Passing the
  # destination's current default branch made the lane-B anti-cheat compare this
  # commit's baseline file against a target that has since REDUCED its own, read
  # the difference as raising the baseline, and refuse a push introducing no
  # content at all (shardpilot/shardpilot-go#79 review). Lane A is absolute and
  # still reads every byte, the ref name and tag object included; only the
  # comparative check is pointed at something it can meaningfully answer about.
  scan_commit "$1" "$1" "$3" "$4" "$5"
}

# read_evidence runs a git read whose OUTPUT BECOMES EVIDENCE and refuses if it
# does not complete. There is no useful partial answer here: everything
# downstream reads the file as the object.
#
# ⚠ FIVE SITES SWALLOWED THE FAILURE, and the review found three of them in one
# round after the commit-object site was fixed in the previous one -- `|| true`,
# `|| break`, `|| : > file`. Each converts an unreadable published object into
# clean evidence, which is the dangerous direction: a short read scans clean and
# every check above it honestly reports on what it was given
# (shardpilot/shardpilot-go#79 review). Written once so a sixth site is a call
# rather than a fourth instance of this finding.
# ⚠ THE CLASS INCLUDES EVERY WRITE, NOT ONLY THE GIT READS. Having unified the
# `git` sites one round earlier I went on believing the class was closed, and the
# review found a `printf` into the same directory that no one had checked -- while
# a derived pass over EVERY write into the evidence directory shows four:
# the ref name, two truncations, and the concatenation that builds the tag target
# (shardpilot/shardpilot-go#79 review). A grep for one command name is not a
# population; the population is "what becomes evidence".
run_evidence() {
  ev_dest="$1"
  ev_mode="$2"
  ev_what="$3"
  shift 3
  if [ "$ev_mode" = write ]; then
    "$@" > "$ev_dest" 2>/dev/null && return 0
  else
    "$@" >> "$ev_dest" 2>/dev/null && return 0
  fi
  printf 'REFUSING: %s could not be written whole.\n' "$ev_what" >&2
  printf '  Evidence that stops partway scans clean, and everything downstream\n' >&2
  printf '  reads it as the answer.\n' >&2
  exit 2
}

read_evidence() {
  ev_dest="$1"
  ev_mode="$2"
  ev_what="$3"
  shift 3
  run_evidence "$ev_dest" "$ev_mode" "$ev_what" git "$@"
}

# scan_commit <commit> <base> <published-ref-name> [tag-object-file]
scan_commit() {
  wt="$tmpdir/wt"
  rm -rf "$wt"
  # ⚠ NO CHECKOUT. `worktree add` runs the CLEAN and SMUDGE drivers a
  # `.gitattributes` in the inspected history names -- so a commit that assigns a
  # locally configured filter, even one a later commit removes, made this hook
  # execute that program on attacker-controlled bytes BEFORE the scanner ran.
  # Redirecting hooks does not help: a filter driver is not a hook
  # (shardpilot/shardpilot-go#79 review). The scanner reads its bytes with
  # `git cat-file blob :<path>`, from the INDEX, so an index is all it needs and
  # a working tree is what it never wanted.
  if ! git_safe worktree add --detach --no-checkout --quiet "$wt" "$1" 2>/dev/null; then
    printf 'REFUSING: could not create a worktree at %s to scan it.\n' "$1" >&2
    exit 2
  fi
  # ⚠ `--no-checkout` LEAVES THE INDEX EMPTY, IT DOES NOT POPULATE IT. The
  # scanner enumerates with `git ls-files` and reads with `cat-file blob :<path>`,
  # so an empty index makes every file invisible and the run reports a clean tree
  # it never looked at -- which is the worst outcome this hook has, and the first
  # rig probe caught it immediately (the scanner's own roster self-check failed,
  # because nothing existed to find the names in).
  if ! ( cd "$wt" && git_safe read-tree "$1" ) 2>/dev/null; then
    printf 'REFUSING: could not read the tree of %s into an index to scan it.\n' "$1" >&2
    exit 2
  fi

  # ⚠ SPARSITY OFF FIRST, THEN VALIDATE. Checking before expanding validated an
  # ABSENCE: sparse rules can omit `scripts/`, the symlink tests saw nothing,
  # and `sparse-checkout disable` then materialised the commit's symlink for the
  # copy to follow -- into an external file, or into `/dev/zero`
  # (shardpilot/shardpilot-go#79 review). A check that runs before the thing it
  # checks exists is not a check.
  ( cd "$wt" && git_safe sparse-checkout disable >/dev/null 2>&1 ) || true

  # ⚠ THE COMMIT CONTROLS THIS PATH. A commit that replaces `scripts` with a
  # symlink would make the copy below follow it and overwrite a file OUTSIDE
  # the worktree -- the inspected branch editing the machine that inspects it
  # (shardpilot/shardpilot-go#79 review). Refuse anything that is not a real
  # directory rather than repairing it: a tree shaped to escape is a finding,
  # not a formatting problem.
  if [ -L "$wt/scripts" ] || { [ -e "$wt/scripts" ] && [ ! -d "$wt/scripts" ]; }; then
    printf 'REFUSING: in %s, `scripts` is not a real directory.\n' "$1" >&2
    printf '  A commit that shapes it as a symlink or a file would redirect this\n' >&2
    printf '  gate writes outside the worktree it is inspecting.\n' >&2
    exit 2
  fi
  if [ -L "$wt/scripts/check_public_surface.sh" ]; then
    printf 'REFUSING: in %s, the scanner path is a symlink.\n' "$1" >&2
    exit 2
  fi
  # ⚠ SPARSE CHECKOUT CAN OMIT THE CONE THIS WRITES INTO. `git worktree add`
  # inherits the rules, so `scripts/` may be absent from the filesystem while
  # present in the index, and a copy into it would land outside any cone git
  # tracks (shardpilot/shardpilot-go#79 review). Disabling sparsity for the
  # temporary worktree costs nothing -- it exists only to be scanned, and a scan
  # of a partial tree is the failure this whole hook is about.
  mkdir -p "$wt/scripts"

  # ⚠ AND THE COMMIT'S OWN SCANNER IS EVIDENCE, NOT SCAFFOLDING. Overwriting it
  # with today's copy hid it: the scanner excludes its own path from the tree
  # pass and self-audits the staged replacement, so material added to THAT file
  # in THAT commit would never be examined and would publish anyway. It is moved
  # to a plain tracked path first, where it is read like any other file.
  # stage_evidence <source-file> <relative-dest> -- puts something the scanner
  # must read into the tree it is about to read.
  #
  # ⚠ THE DESTINATION MUST NOT ALREADY EXIST. A commit that tracks the evidence
  # path would have its own file overwritten -- so material stored THERE would
  # never be scanned -- and a destination shaped as a symlink would make the
  # write land outside the worktree, which is the filesystem escape closed one
  # finding earlier arriving through a second door
  # (shardpilot/shardpilot-go#79 review). Refused, not repaired: a commit
  # tracking this name is a finding.
  stage_evidence() {
    # ⚠ ASK THE COMMIT, NOT THE CHECKOUT. `git worktree add` preserves sparse
    # checkout rules, so a path can be present in the index and absent from the
    # filesystem -- and `[ -e ]` then reports a reserved evidence path free while
    # the commit owns it (shardpilot/shardpilot-go#79 review).
    if git cat-file -e "$1:$2" 2>/dev/null || [ -e "$wt/$2" ] || [ -L "$wt/$2" ]; then
      printf 'REFUSING: %s already tracks %s, which this gate needs as an\n' "$1" "$2" >&2
      printf '  evidence path. A commit that owns it can hide content from the\n' >&2
      printf '  scan or redirect this write outside the worktree.\n' >&2
      exit 2
    fi
    # ⚠ WRITTEN TO THE INDEX DIRECTLY, PAST EVERY COMMIT-CONTROLLED FILTER.
    # `git add` applies clean filters, so a commit adding `.gitattributes` with
    # `filter=lfs` on a reserved path staged an LFS POINTER instead of the
    # evidence -- the scanner reads the index, so the content it was given to
    # examine was replaced by something clean (shardpilot/shardpilot-go#79
    # review). `hash-object -w` plus `update-index --cacheinfo` writes the bytes
    # as they are. A failure refuses: unstaged evidence is unread evidence, and
    # this gate does not report on what it has not read.
    blob="$( cd "$wt" && git_safe hash-object -w --no-filters -- "$3" 2>/dev/null )"
    if [ -z "$blob" ] || ! ( cd "$wt" && git_safe update-index --add \
         --cacheinfo "100644,$blob,$2" 2>/dev/null ); then
      printf 'REFUSING: could not stage %s for scanning in %s.\n' "$2" "$1" >&2
      exit 2
    fi
    cp "$3" "$wt/$2" 2>/dev/null || true
  }

  # ⚠ THE BLOB, NOT THE CHECKOUT. `worktree add` runs the branch's own
  # `.gitattributes`, so the bytes that land in the worktree are not necessarily
  # the bytes that were committed: with `working-tree-encoding` set on this path,
  # a blob whose ASCII carries an internal identifier is transcoded on the way
  # out and that identifier is absent from the file this used to copy. The
  # transformed bytes were staged as evidence, the entry was then replaced by the
  # trusted scanner, and the scanner excludes its own path, so the committed
  # bytes were examined by nothing (shardpilot/shardpilot-go#79 review). The
  # object database is the one copy the inspected branch cannot rewrite.
  #
  # ⚠ AND THE COMMENT DOES NOT CARRY THE EXAMPLE. The first version of these
  # lines quoted the reviewer's sample identifier verbatim, and this repository's
  # own public-surface gate refused the push that added it -- correctly. A review
  # thread is not published; a comment in tracked content is. Describe the shape,
  # never the instance.
  if git_safe cat-file -e "$1:scripts/check_public_surface.sh" 2>/dev/null; then
    if ! git_safe cat-file blob "$1:scripts/check_public_surface.sh" \
         > "$tmpdir/committed-scanner" 2>/dev/null; then
      printf 'REFUSING: could not read %s from %s to scan it.\n' \
        "scripts/check_public_surface.sh" "$1" >&2
      exit 2
    fi
    rm -f "$wt/scripts/check_public_surface.sh"
    stage_evidence "$1" scripts/scanner-as-committed.txt "$tmpdir/committed-scanner"
  fi

  # ⚠ THE WHOLE COMMIT OBJECT, NOT ONLY ITS MESSAGE. The tree is not the whole
  # of what a push makes reachable, and neither is the message: author and
  # committer names and addresses are published with it, and `%B` reads none of
  # them (shardpilot/shardpilot-go#79 review, after an earlier round had already
  # moved from tree-only to tree-plus-message). `git cat-file commit` is the
  # object as it will be published -- headers, message, everything -- and it is
  # staged as an ordinary file so the SAME rules read it, with no second scanner
  # and no second pattern list to drift.
  # ⚠ A FAILED WRITE IS A REFUSAL, NOT AN EMPTY FILE. This fallback replaced
  # partial evidence with nothing and carried on scanning, so a commit whose
  # object exceeds a limit the hook inherits -- a large benign message prefix with
  # prohibited metadata after the cut -- passed, while git still transferred the
  # WHOLE object through the push pipe (shardpilot/shardpilot-go#79 review). Same
  # shape as the scanner copy fixed one round earlier: a failure that produces a
  # readable artifact is the dangerous kind, because everything downstream reads
  # it as an answer.
  read_evidence "$tmpdir/committed-object" write "the commit object for $1" cat-file commit "$1"
  stage_evidence "$1" scripts/commit-object-as-committed.txt "$tmpdir/committed-object"

  # ⚠ AND THE TREE'"'"'S PATH NAMES, INCLUDING EMPTY SUBTREES. The scan worktree'"'"'s
  # index cannot carry an empty directory: `read-tree` writes no entry for one,
  # staging the synthetic evidence files invalidates the cached tree, and the
  # scanner'"'"'s `write-tree` rebuild silently drops it -- so a commit containing an
  # explicitly constructed empty subtree whose DIRECTORY NAME carries prohibited
  # material published that name with nothing in the index or the commit object
  # exposing it (shardpilot/shardpilot-go#79 review). The commit object records
  # only the root tree id, so it cannot answer this either.
  #
  # `-rt` shows trees when recursing, which is precisely the entry `-r` alone
  # hides; the listing is staged like the rest so the same rules read it.
  read_evidence "$tmpdir/committed-tree" write "the tree listing of $1" ls-tree -rt "$1"
  stage_evidence "$1" scripts/commit-tree-as-committed.txt "$tmpdir/committed-tree"

  # ⚠ AND THE REF NAME IS PUBLISHED. A clean tree, a clean object, and a branch
  # called after an internal identifier still puts that identifier in the public
  # repository -- the third widening of "what does a push make reachable", after
  # trees and then commit objects (shardpilot/shardpilot-go#79 review). It is
  # staged like the rest so the same rules read it.
  run_evidence "$tmpdir/pushed-ref-name" write "the pushed ref name" printf '%s\n' "$3"
  stage_evidence "$1" scripts/pushed-ref-as-committed.txt "$tmpdir/pushed-ref-name"

  if [ -n "${4:-}" ] && [ -s "$4" ]; then
    stage_evidence "$1" scripts/tag-object-as-committed.txt "$4"
  fi
  if [ -n "${5:-}" ] && [ -s "$5" ]; then
    stage_evidence "$1" scripts/tag-target-as-committed.txt "$5"
  fi

  # ⚠ AND `git add` IS A CLEAN FILTER TOO. Staging the trusted scanner with it
  # would run whatever driver the branch's attributes name, on the way in
  # (shardpilot/shardpilot-go#79 review). The file is written to disk because the
  # shell must execute it -- these are OUR bytes, not the branch's -- and staged
  # by object id, past the filters entirely.
  # ⚠ CHECKED EXPLICITLY, because `set -e` DOES NOT APPLY HERE. Every call to
  # this function is the left side of `||`, and bash disables errexit throughout
  # such a body -- so a truncated copy continued, `chmod` made the partial file
  # executable, and a truncation landing inside the leading comment block yields a
  # valid shell script that exits 0 before installing the fail-closed trap: an
  # unscanned push reported as clean (shardpilot/shardpilot-go#79 review).
  #
  # And the comparison, not just the exit codes: what runs must be what was
  # trusted. A copy that "succeeded" and differs is the same failure wearing a
  # zero.
  mkdir -p "$wt/scripts" || { printf 'REFUSING: could not create %s.\n' "$wt/scripts" >&2; exit 2; }
  if ! cp "$scanner" "$wt/scripts/check_public_surface.sh" ||
     ! chmod +x "$wt/scripts/check_public_surface.sh" ||
     ! cmp -s "$scanner" "$wt/scripts/check_public_surface.sh"; then
    printf 'REFUSING: the trusted scanner could not be placed for the scan.\n' >&2
    printf '  A partial copy that is executable is worse than none: a truncation\n' >&2
    printf '  inside its leading comments is a valid script that exits 0.\n' >&2
    exit 2
  fi
  sblob="$( git_safe hash-object -w --no-filters -- "$scanner" 2>/dev/null )"
  if [ -n "$sblob" ]; then
    ( cd "$wt" && git_safe update-index --add \
      --cacheinfo "100755,$sblob,scripts/check_public_surface.sh" >/dev/null 2>&1 ) || true
  fi
  ( cd "$wt" && PUBLIC_SURFACE_BASE_REF="$2" ./scripts/check_public_surface.sh )
  rc=$?
  git_safe worktree remove --force "$wt" >/dev/null 2>&1 || rm -rf "$wt"
  return $rc
}

# The whole push, read once: a single ref cannot answer questions about the push
# it is part of. A here-string keeps the loop in this shell, so `status` survives
# it -- a pipe would run it in a subshell and every failure would be discarded.
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac

  # ⚠ A TAG IS NOT ITS COMMIT. githooks(5) supplies the TAG OBJECT's id for an
  # annotated or signed tag, so comparing it to HEAD refused a standard release
  # push -- and `--follow-tags` with it -- forcing --no-verify past this gate for
  # an ordinary operation (shardpilot/shardpilot-go#79 review). The peeled object
  # decides eligibility; the tag object is scanned in its own right below,
  # because its annotation and signer metadata are published too.
  # ⚠ A TAG NEED NOT POINT AT A COMMIT. `git tag` accepts `[<commit> | <object>]`,
  # so an annotated tag on a tree or a blob peels to nothing and this fallback
  # left `peeled` as the tag's own id -- which can neither equal HEAD nor be an
  # ancestor of it, so a valid tag push was refused before it was scanned
  # (shardpilot/shardpilot-go#79 review). Such a tag has no tree to scan; what it
  # publishes is the tag OBJECT, and that is collected either way.
  peeled="$(git rev-parse --verify --quiet "$local_sha^{commit}" 2>/dev/null || printf '%s' "$local_sha")"
  target_kind="$(git cat-file -t "$peeled" 2>/dev/null || printf 'unknown')"
  # ⚠ AN ANCESTOR IS ELIGIBLE FOR A TAG. `--follow-tags` publishes missing
  # annotated tags reachable from the refs being pushed, not only tags whose
  # target IS HEAD -- so requiring equality refused an otherwise standard branch
  # push because one of its tags pointed at the first of two commits
  # (shardpilot/shardpilot-go#79 review). A tag target that HEAD contains is
  # scannable from this checkout, which is all the eligibility test is for.
  # ⚠ THE REF SAYS WHETHER IT IS A TAG; THE OBJECT TYPE DOES NOT. Requiring
  # `peeled != local_sha` accepted only ANNOTATED ancestor tags, because a
  # LIGHTWEIGHT tag points straight at the commit and peels to itself -- so
  # `git push origin tag v1` for a tag on an earlier commit was refused, though
  # its target is exactly as scannable (shardpilot/shardpilot-go#79 review).
  # ⚠ THE DESTINATION SAYS WHAT IS BEING PUBLISHED, NOT THE SOURCE.
  # `git push origin HEAD~1:refs/tags/v1` supplies `HEAD~1` as the local ref, so
  # classifying by it rejected a valid tag push and demanded --no-verify for an
  # operation git explicitly permits (shardpilot/shardpilot-go#79 review). What
  # the remote will hold is what matters.
  case "$remote_ref" in
    refs/tags/*) is_tag=yes ;;
    *) is_tag=no ;;
  esac
  eligible=no
  if [ "$is_tag" = yes ] && [ "$target_kind" != commit ]; then
    # No commit means no tree and no ratchet baseline to compare against; the
    # object being published is the tag itself, which scan_ref_name collects.
    eligible=yes
  elif [ "$peeled" = "$head_sha" ]; then
    eligible=yes
  elif { [ "$peeled" != "$local_sha" ] || [ "$is_tag" = yes ]; } &&
       git merge-base --is-ancestor "$peeled" "$head_sha" 2>/dev/null; then
    eligible=yes
  fi
  if [ "$eligible" = no ]; then
    printf 'REFUSING: pushing %s, which is not your HEAD.\n' "${local_ref:-?}" >&2
    printf '  The commits are scanned from their own trees, but the base and the\n' >&2
    printf '  ratchet are read relative to the checked-out repository state.\n' >&2
    printf '  Check out %s and push again, or --no-verify and own it.\n' "${local_ref:-that ref}" >&2
    exit 2
  fi
  if ! git diff --quiet HEAD -- || ! git diff --cached --quiet; then
    printf 'REFUSING: the index or working tree differs from HEAD.\n' >&2
    printf '  Commit or stash first, so what is scanned is what is published.\n' >&2
    exit 2
  fi

  # ⚠ A BASELINE MUST BE A COMMIT, AND THE PREVIOUS TARGET NEED NOT BE ONE. Force-
  # updating a tag that currently points at a blob or a tree TO a commit makes
  # `remote_sha` a non-commit, and every introduced commit was then scanned with
  # that value in PUBLIC_SURFACE_BASE_REF -- where `^{commit}` does not resolve, so
  # the scanner refused unconditionally and a legitimate push could not be made at
  # all (shardpilot/shardpilot-go#79 review). The fetch below exists for a tip that
  # is ABSENT; this one is present and simply is not a commit, which no fetch
  # changes.
  #
  # It is handed to the branch that already knows how to find a baseline when there
  # is no previous commit, rather than copied: my first attempt duplicated that
  # logic here and referred to a variable that branch had not yet set. The rig said
  # `base_ref: unbound variable` on the first run.
  # ⚠ FETCH FIRST, THEN ASK. The object may be ABSENT in a `--no-tags` clone, and
  # the test below then skipped -- while the fetch further down brought it in and
  # nothing asked again, leaving a non-commit in `$base` and refusing every
  # introduced commit (shardpilot/shardpilot-go#79 review). My previous fix put the
  # question in one place; it had to be placed after the answer could exist.
  case "$remote_sha" in
    *[!0]*)
      if ! git cat-file -e "$remote_sha" 2>/dev/null; then
        git fetch --quiet --no-tags --no-write-fetch-head -- "$dest" "$remote_sha" 2>/dev/null || true
      fi
      ;;
  esac
  if git cat-file -e "$remote_sha" 2>/dev/null &&
     ! git rev-parse --verify --quiet "$remote_sha^{commit}" >/dev/null 2>&1; then
    printf 'public surface: %s previously held a non-commit object; comparing against the default branch\n' \
      "${remote_ref:-the remote ref}"
    remote_sha=0000000000000000000000000000000000000000
  fi
  case "$remote_sha" in
    *[!0]*)
      base="$remote_sha"
      why="the pre-push tip of ${remote_ref:-the remote ref}"
      if ! git rev-parse --verify --quiet "$base^{commit}" >/dev/null 2>&1; then
        # ⚠ A HOOK'S FETCH MUST LEAVE NO TRACE. Without `--no-write-fetch-head`
        # this overwrites .git/FETCH_HEAD, so a developer who fetched a commit
        # intending `git merge FETCH_HEAD` silently merges the destination's
        # default branch instead, because a push ran in between. Without
        # `--no-tags` it can auto-follow tags into the fetched history and create
        # them locally, in a clone made with --no-tags on purpose
        # (shardpilot/shardpilot-go#79 review). A gate is not entitled to change
        # the repository it is inspecting.
        if ! git fetch --quiet --no-tags --no-write-fetch-head -- "$dest" "$base" 2>/dev/null; then
          printf 'REFUSING: the pre-push tip %s is not here and could not be fetched.\n' "$base" >&2
          exit 2
        fi
      fi
      ;;
    *)
      # ⚠ A COMBINED PUSH BRINGS ITS OWN BASELINE. When one invocation both
      # updates the destination's default branch and creates another ref, the
      # remote still advertises the OLD default tip while the new one is in this
      # very push -- so the created ref was compared against a baseline about to
      # stop existing (shardpilot/shardpilot-go#79 review). The pushed lines are
      # the authority on what the default branch is becoming.
      branch="$(git ls-remote --symref -- "$dest" HEAD 2>/dev/null \
        | awk '$1=="ref:" && $3=="HEAD" {sub("refs/heads/","",$2); print $2; exit}')"
      if [ -z "$branch" ]; then
        printf 'REFUSING: %s did not advertise a default branch (HEAD symref).\n' "$safe_dest" >&2
        printf '  Guessing a name is how a fork or a rename becomes the wrong,\n' >&2
        printf '  higher baseline.\n' >&2
        exit 2
      fi
      # ⚠ A UNIQUE REF PER INVOCATION. Resolving a shared ref "immediately"
      # after fetching it is still two commands, and a concurrent push can land
      # between them -- so the previous fix narrowed the window instead of
      # closing it (shardpilot/shardpilot-go#79 review). A name no other
      # invocation uses has no window at all.
      base_ref="refs/prepush-base-$$"
      if ! git fetch --quiet --no-tags --no-write-fetch-head -- "$dest" \
           "+refs/heads/$branch:$base_ref" 2>/dev/null; then
        printf 'REFUSING: could not fetch %s from %s to compare against.\n' "$branch" "$safe_dest" >&2
        exit 2
      fi
      # ⚠ RESOLVED TO A SHA IMMEDIATELY, and the ref dropped. Two concurrent
      # created-ref pushes from this repository would otherwise both fetch into
      # the same `refs/prepush-base`, and one could overwrite it between the
      # other's assignment and its scan -- comparing against another
      # destination's baseline (shardpilot/shardpilot-go#79 review). A SHA
      # cannot be overwritten.
      base="$(git rev-parse --verify --quiet "$base_ref^{commit}" || true)"
      git update-ref -d "$base_ref" 2>/dev/null || true
      incoming="$(printf '%s\n' "$pushed_lines" \
        | awk -v r="refs/heads/$branch" '$3==r {print $2; exit}')"
      case "$incoming" in
        ""|*[!0-9a-f]*) ;;
        *) if [ "$incoming" != "$base" ]; then
             printf 'public surface: %s is also updated by this push; using its incoming tip\n' "$branch"
             base="$incoming"
           fi ;;
      esac
      if [ -z "$base" ]; then
        printf 'REFUSING: fetched %s from %s but it did not resolve.\n' "$branch" "$safe_dest" >&2
        exit 2
      fi
      why="the default branch of the destination, ${branch}, because this push CREATES ${remote_ref:-the ref}"
      ;;
  esac

  # EVERY COMMIT THE PUSH INTRODUCES, oldest first. Each one becomes reachable
  # in a public repository the moment this push succeeds.
  # ⚠ ALREADY-PUBLISHED COMMITS ARE NOT THIS PUSH'S TO PUBLISH. Merging a
  # feature branch the destination already exposes brought its whole history
  # into the range, so the gate rescanned commits that are public regardless of
  # this push -- slow, and it charges one push for another's content
  # (shardpilot/shardpilot-go#79 review). Every other ref the destination
  # advertises is excluded.
  # ⚠ EVERY ADVERTISED REF, NOT ONLY HEADS AND TAGS. `--heads --tags` limits the
  # query to those two namespaces, and this repository's own .gitleaksignore
  # records that `refs/pull/*/head` is advertised public history -- so a commit
  # published only through a pull ref was counted as newly introduced, and
  # creating a branch at it could be refused by the commit budget or the lane-B
  # ratchet for republishing what is already public
  # (shardpilot/shardpilot-go#79 review).
  published="$(git ls-remote -- "$dest" 2>/dev/null | awk '{print $1}')"
  # ⚠ ONE ROUND TRIP, NOT ONE PER TIP. A repository advertising hundreds of refs
  # made this a serial fetch per missing tip -- minutes of gate for a push that
  # takes seconds, which is how a gate gets uninstalled
  # (shardpilot/shardpilot-go#79 review). The batch is attempted first; a batch
  # dies entirely if any ONE of its tips is unfetchable, so the per-tip loop
  # below stays as the fallback and still answers for whatever remains missing.
  missing=""
  for p in $published; do
    git cat-file -e "$p^{commit}" 2>/dev/null || missing="$missing $p"
  done
  if [ -n "$missing" ]; then
    # shellcheck disable=SC2086
    git fetch --quiet --no-tags --no-write-fetch-head -- "$dest" $missing 2>/dev/null || true
  fi
  excl=""
  for p in $published; do
    # ⚠ THE PUSHED SHA IS NOT AN EXCEPTION -- IT IS THE EVIDENCE. Creating a ref
    # at the tip of an already-published branch means `ls-remote` advertises
    # exactly that SHA, and skipping it made the hook treat public history as
    # newly introduced: rescanned against the default branch, and refusable on
    # the budget or the ratchet for publishing nothing but a name
    # (shardpilot/shardpilot-go#79 review).
    # ⚠ FETCH WHAT IS NOT HERE. Silently skipping an unresolvable advertised tip
    # counted history that IS already public as newly introduced, which can
    # refuse a legitimate push at the budget (shardpilot/shardpilot-go#79
    # review). One fetch answers it; a failure only costs the exclusion.
    git cat-file -e "$p^{commit}" 2>/dev/null \
      || git fetch --quiet --no-tags --no-write-fetch-head -- "$dest" "$p" 2>/dev/null || true
    git cat-file -e "$p^{commit}" 2>/dev/null && excl="$excl ^$p"
  done
  # shellcheck disable=SC2086
  commits="$(git rev-list --reverse "$base..$peeled" $excl)"
  # An annotated tag publishes its own message and signer, which no tree or
  # commit scan reaches. It rides along with the peeled commit's scan as one more
  # staged evidence file.
  # ⚠ A TAG CHAIN IS A CHAIN. `^{}` peels RECURSIVELY, so an outer tag pointing
  # at another annotated tag reaches the commit in one step while the inner tag
  # object is transferred and published unscanned -- reading only `$local_sha`
  # saw the outer one and stopped (shardpilot/shardpilot-go#79 review). Every
  # object on the way down is staged.
  tag_object=""
  tag_target=""
  run_evidence "$tmpdir/tag-object" write "the tag-object evidence file" printf ''

  walk="$local_sha"
  depth=0
  # ⚠ WALK WHILE THE OBJECT IS A TAG, not until it equals the peeled id. For a
  # tag on a TREE OR A BLOB the peel fails and `peeled` is the tag's own id, so
  # this loop exited before its first iteration and the tag object -- the only
  # thing such a push publishes -- was never collected. The rig found it: the
  # clean case passed and so did one whose message carried material
  # (shardpilot/shardpilot-go#79 review).
  while [ "$(git cat-file -t "$walk" 2>/dev/null)" = tag ] && [ "$depth" -lt 32 ]; do
    read_evidence "$tmpdir/tag-object" append "the annotated tag object $walk" cat-file tag "$walk"
    run_evidence "$tmpdir/tag-object" append "a tag-object separator" printf '\n' 
    tag_object="$tmpdir/tag-object"
    nxt="$(git cat-file tag "$walk" 2>/dev/null | awk '$1=="object"{print $2; exit}')"
    [ -n "$nxt" ] || break
    walk="$nxt"
    depth=$((depth + 1))
  done
  # ⚠ ASK WHETHER IT IS STILL A TAG, NOT WHETHER THE COUNTER REACHED THE BOUND. A
  # valid chain of exactly 32 tags ends on a COMMIT with `depth` at 32, every tag
  # already scanned -- and this refused it for being "deeper than 32"
  # (shardpilot/shardpilot-go#79 review). The counter answers "how far did I
  # walk"; the refusal needs "is there more I did not walk".
  if [ "$(git cat-file -t "$walk" 2>/dev/null)" = tag ]; then
    printf 'REFUSING: tag chain deeper than 32 at %s; not scanning further.\n' "$local_sha" >&2
    exit 2
  fi
  n="$(printf '%s\n' "$commits" | grep -c . || true)"
  printf 'public surface: comparing against %s (%s); %s commit(s) introduced\n' "$base" "$why" "$n"
  # ⚠ A REF WITH NO NEW COMMITS STILL PUBLISHES ITS NAME. Pointing a new branch
  # at a commit already reachable from the default branch introduces nothing --
  # and the name is new, public, and was going unscanned because the loop exited
  # first (shardpilot/shardpilot-go#79 review).
  if [ "$n" = 0 ]; then
    # ⚠ A NON-COMMIT TAG HAS NO TREE TO SCAN. `git tag` accepts a tree or a blob,
    # and `worktree add` on one fails -- so the eligibility fix alone turned a
    # refusal-before-scanning into a refusal-while-scanning
    # (shardpilot/shardpilot-go#79 review, and the rig caught the second half
    # immediately). What such a push publishes is the tag OBJECT and the ref
    # NAME; both are staged as evidence, and the tree the scanner walks is our
    # own HEAD, which is already published and is its own base.
    scan_target="$peeled"
    if [ "$target_kind" != commit ]; then
      # ⚠ AND THE TARGET OBJECT ITSELF. Substituting HEAD gave the scanner a tree
      # to walk and a ref name to read, and quietly dropped the one thing the
      # push actually publishes -- a blob tagged this way could carry anything
      # (shardpilot/shardpilot-go#79 review). My previous fix made the push
      # possible and left it unscanned, which is the worse half of the two.
      # ⚠ `target_kind` IS `tag` HERE, NEVER `blob`. `peeled` is the result of a
      # `^{commit}` that FAILED, so it is the tag's own id and its type is `tag`
      # -- the branches below, keyed on it, could not fire once. The rig published
      # a blob carrying a prohibited shape with the fix in place, which is how the
      # substitution was found a second time: a repair keyed on the wrong name
      # looks exactly like the defect it replaced.
      deref="$( git rev-parse --verify --quiet "${local_sha}^{}" 2>/dev/null || printf '%s' "$peeled" )"
      deref_kind="$( git cat-file -t "$deref" 2>/dev/null || printf 'unknown' )"
      run_evidence "$tmpdir/tag-target" write "the tag-target evidence file" printf ''

      if [ "$deref_kind" = blob ]; then
        read_evidence "$tmpdir/tag-target" append "the tagged blob $deref" cat-file blob "$deref"
      elif [ "$deref_kind" = tree ]; then
        # ⚠ THE COMMENT PROMISED A REFUSAL AND THE CODE TRUNCATED. `head -256`
        # dropped everything past the bound in silence, so a 257-entry tree with
        # prohibited material in the tail passed a gate that had scanned the
        # prefix (shardpilot/shardpilot-go#79 review). A bound that is not
        # enforced is a bound that is documented.
        # ⚠ AND A TREE PUBLISHES ITS PATH NAMES. The pipeline kept blob ids and
        # discarded every path, so a tag on a tree whose prohibited identifier is
        # an ENTRY NAME, with clean blob contents, was never shown to the scanner
        # -- the object publishes the names, and the evidence held only the bytes
        # (same review). The listing itself is staged; the same rules read it.
        # ⚠ `-rt`, NOT `-r`. Plain `-r` emits NOTHING for an empty subtree, so a
        # tagged tree holding only a directory whose NAME carries prohibited
        # material produced an empty listing and no evidence at all
        # (shardpilot/shardpilot-go#79 review). `-t` is documented as "show trees
        # when recursing", which is exactly the entry the recursion was hiding.
        read_evidence "$tmpdir/tag-tree-listing" write "the tagged tree listing of $deref" ls-tree -rt "$deref"
        entries="$( wc -l < "$tmpdir/tag-tree-listing" | tr -d ' ' )"
        if [ "${entries:-0}" -gt 256 ]; then
          printf 'REFUSING: the tagged tree has %s entries, past this gate'"'"'s bound of 256.\n' "$entries" >&2
          printf '  Scanning a prefix of it and reporting clean is worse than refusing:\n' >&2
          printf '  everything past the bound becomes publicly reachable unexamined.\n' >&2
          exit 2
        fi
        run_evidence "$tmpdir/tag-target" append "the tagged tree listing" cat "$tmpdir/tag-tree-listing"
        run_evidence "$tmpdir/tag-target" append "a tag-target separator" printf '\n' 
        # ⚠ NOT THROUGH A PIPE. `while read` on the right of `|` runs in a SUBSHELL,
        # so the refusal below would have exited that subshell and let the push
        # continue -- the same shape as the `||` context that disables `set -e`
        # elsewhere in this file. The list goes to a file and the loop redirects
        # from it, which keeps the refusal in the shell that can act on it.
        # Not evidence itself, but a truncated list means fewer blobs scanned,
        # which fails in the same direction as truncated evidence.
        run_evidence "$tmpdir/tag-tree-blobs" write "the tagged tree's blob list" \
          awk '$2=="blob"{print $3}' "$tmpdir/tag-tree-listing"
        while read -r b; do
          [ -n "$b" ] || continue
          read_evidence "$tmpdir/tag-target" append "a blob reached through the tagged tree ($b)" cat-file blob "$b"
          run_evidence "$tmpdir/tag-target" append "a tag-target separator" printf '\n' 
        done < "$tmpdir/tag-tree-blobs"
      fi
      if [ -s "$tmpdir/tag-target" ]; then
        tag_target="$tmpdir/tag-target"
      fi
      scan_target="$head_sha"
    fi
    scan_ref_name "$scan_target" "$base" "$remote_ref" "$tag_object" "$tag_target" || status=$?
    continue
  fi

  # ⚠ A DISCLOSED BUDGET, AND EVERY SKIPPED COMMIT IS NAMED.
  #
  # One scan is a full pass over the tracked tree -- 15-20s here -- so a branch
  # sitting 28 commits off main takes over eight minutes, measured. A gate that
  # slow is bypassed, and a bypassed gate protects nothing. So the budget is
  # explicit, overridable, and its remainder is PRINTED rather than dropped
  # quietly: an unscanned commit that nobody names looks exactly like a scanned
  # one. The durable cure is a scanner that can be pointed at a tree without a
  # worktree per commit; until it exists, this states its own coverage.
  budget="${PUBLIC_SURFACE_MAX_COMMITS:-10}"
  i=0
  skipped=""
  while IFS= read -r c; do
    [ -n "$c" ] || continue
    i=$((i + 1))
    if [ "$i" -gt "$budget" ] && [ "$c" != "$local_sha" ]; then
      skipped="$skipped $(git rev-parse --short "$c")"
      continue
    fi
    printf 'public surface: scanning %s (%s/%s)\n' "$(git rev-parse --short "$c")" "$i" "$n"
    scan_commit "$c" "$base" "$remote_ref" "$tag_object" || status=$?
  done <<< "$commits"
  if [ -n "$skipped" ]; then
    # ⚠ REFUSING, NOT WARNING. The first version printed this and exited 0,
    # which is a gate passing what it did not look at -- and precisely the
    # earlier-add/later-remove leak this hook exists to stop
    # (shardpilot/shardpilot-go#79 review). A disclosed hole is still a hole.
    printf '\nREFUSING: these commits were NOT scanned and this push would\n' >&2
    printf '  publish them:%s\n' "$skipped" >&2
    printf '  The budget is %s commits (PUBLIC_SURFACE_MAX_COMMITS), and one scan\n' "$budget" >&2
    printf '  is a full pass over the tree. Raise the budget and push again, or\n' >&2
    printf '  push in smaller steps. This gate does not report on what it has not\n' >&2
    printf '  read.\n' >&2
    exit 2
  fi
done <<< "$pushed_lines"
exit "$status"
