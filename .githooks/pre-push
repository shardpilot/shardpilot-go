  commits="$(git rev-list --reverse "$base..$peeled" $excl)"
  # An annotated tag publishes its own message and signer, which no tree or
  # commit scan reaches. It rides along with the peeled commit's scan as one more
  # staged evidence file.
  # ⚠ A TAG CHAIN IS A CHAIN. `^{}` peels RECURSIVELY, so an outer tag pointing
  # at another annotated tag reaches the commit in one step while the inner tag
  # object is transferred and published unscanned -- reading only `$local_sha`
  # saw the outer one and stopped (shardpilot/shardpilot-go#79 review). Every
  # object on the way down is staged.
  tag_object=""
  tag_target=""
  tag_blobs=""
  run_evidence "$tmpdir/tag-object" write "the tag-object evidence file" printf ''

  walk="$local_sha"
  depth=0
  # ⚠ WALK WHILE THE OBJECT IS A TAG, not until it equals the peeled id. For a
  # tag on a TREE OR A BLOB the peel fails and `peeled` is the tag's own id, so
  # this loop exited before its first iteration and the tag object -- the only
  # thing such a push publishes -- was never collected. The rig found it: the
  # clean case passed and so did one whose message carried material
  # (shardpilot/shardpilot-go#79 review).
  # ⚠ AND AN UNREADABLE OBJECT IS NOT A NON-TAG. Both probes substituted the type
  # and compared the STRING, so a transient failure read as "not a tag": the walk
  # skipped the whole tag-object collection, and the probe after the loop skipped
  # the depth refusal -- a push approved without its annotation or signer metadata
  # ever being scanned (shardpilot/shardpilot-go#79 review). Empty output has two
  # meanings; the status separates them, exactly as the commit listing below already
  # does.
  while [ "$depth" -lt 32 ]; do
    if ! walk_kind="$(git cat-file -t "$walk" 2>/dev/null)"; then
      printf 'REFUSING: the type of %s could not be read, so this gate cannot tell an\n' "$walk" >&2
      printf '  unreadable object from one that is not a tag.\n' >&2
      exit 2
    fi
    [ "$walk_kind" = tag ] || break
    read_evidence "$tmpdir/tag-object" append "the annotated tag object $walk" cat-file tag "$walk"
    run_evidence "$tmpdir/tag-object" append "a tag-object separator" printf '\n' 
    tag_object="$tmpdir/tag-object"
    # ⚠ `exit` IN THE READER MAKES THE WRITER FAIL. `awk` stops at the `object`
    # header while `git cat-file` is still writing the message, git takes SIGPIPE,
    # and under `pipefail` the substitution's status is 141 -- which `set -e` turns
    # into the hook terminating and REFUSING a valid tag. Reproduced with a 1 MiB
    # tag message (shardpilot/shardpilot-go#79 review). The gate reads its own
    # evidence file, which is already written above, so nothing needs to be streamed
    # a second time and no reader has to stop early.
    # ⚠ AND NOT FROM THE ACCUMULATED EVIDENCE FILE. `$tmpdir/tag-object` is APPENDED
    # once per tag in the chain, so `awk … exit` returned the FIRST tag's target on
    # every iteration -- the walk never advanced, ran to the depth bound, and refused
    # a valid chain. My own SIGPIPE fix introduced that by reading the evidence
    # instead of the object; the battery said so by flipping the exactly-32 scene
    # from PASSED to REFUSED, and I first blamed the scene
    # (shardpilot/shardpilot-go#79 review, and the regression it caused).
    #
    # A per-iteration file: written whole, so no reader stops early and no writer
    # takes SIGPIPE, and it holds this tag alone.
    : > "$tmpdir/tag-walk"
    # ⚠ AND A FAILED RE-READ IS NOT AN EMPTY TAG. Truncating on failure left `nxt`
    # empty, `walk` still a tag, and the post-loop check then reported a chain deeper
    # than 32 and rejected a valid tag push (shardpilot/shardpilot-go#79 review) --
    # a refusal manufactured by the instrument. The validated read above already
    # succeeded on this object, so a failure here is a fault, not a shape.
    if ! git cat-file tag "$walk" > "$tmpdir/tag-walk" 2>/dev/null; then
      printf 'REFUSING: the tag object %s could not be re-read while walking the\n' "$walk" >&2
      printf '  tag chain, and a truncated walk reads as a chain too deep.\n' >&2
      exit 2
    fi
