  printf 'public surface: comparing against %s (%s); %s commit(s) introduced\n' "$base" "$why" "$n"
  # ⚠ A REF WITH NO NEW COMMITS STILL PUBLISHES ITS NAME. Pointing a new branch
  # at a commit already reachable from the default branch introduces nothing --
  # and the name is new, public, and was going unscanned because the loop exited
  # first (shardpilot/shardpilot-go#79 review).
  if [ "$n" = 0 ]; then
    # ⚠ A NON-COMMIT TAG HAS NO TREE TO SCAN. `git tag` accepts a tree or a blob,
    # and `worktree add` on one fails -- so the eligibility fix alone turned a
    # refusal-before-scanning into a refusal-while-scanning
    # (shardpilot/shardpilot-go#79 review, and the rig caught the second half
    # immediately). What such a push publishes is the tag OBJECT and the ref
    # NAME; both are staged as evidence, and the tree the scanner walks is our
    # own HEAD, which is already published and is its own base.
    scan_target="$peeled"
    if [ "$target_kind" != commit ]; then
      # ⚠ AND THE TARGET OBJECT ITSELF. Substituting HEAD gave the scanner a tree
      # to walk and a ref name to read, and quietly dropped the one thing the
      # push actually publishes -- a blob tagged this way could carry anything
      # (shardpilot/shardpilot-go#79 review). My previous fix made the push
      # possible and left it unscanned, which is the worse half of the two.
      # ⚠ `target_kind` IS `tag` HERE, NEVER `blob`. `peeled` is the result of a
      # `^{commit}` that FAILED, so it is the tag's own id and its type is `tag`
      # -- the branches below, keyed on it, could not fire once. The rig published
      # a blob carrying a prohibited shape with the fix in place, which is how the
      # substitution was found a second time: a repair keyed on the wrong name
      # looks exactly like the defect it replaced.
      # ⚠ AND A FAILED PEEL IS NOT "IT PEELS TO ITSELF". Mapping failure back to the
      # outer tag made the type probe below answer `tag`, so neither the blob nor the
      # tree evidence branch ran and the push could be approved having scanned the
      # annotation and the ref name while omitting the published target bytes
      # (shardpilot/shardpilot-go#79 review). `^{}` resolves for every existing
      # object, so a non-zero status here is a fault and not a shape.
      git_probe "the target of the tag $local_sha" git rev-parse --verify --quiet "${local_sha}^{}"
      deref="$PROBE_OUT"
      if [ -z "$deref" ]; then
        printf 'REFUSING: peeling %s produced no object id, so the published target\n' "$local_sha" >&2
        printf '  cannot be named and its bytes cannot be staged as evidence.\n' >&2
        exit 2
      fi
      # ⚠ AND MAPPING FAILURE TO `unknown` SKIPS BOTH EVIDENCE BRANCHES, so the push
      # was approved on the ref name and the tag annotation alone, with the published
      # target object never staged (shardpilot/shardpilot-go#79 review).
      #
      # ⚠ CORRECTION, AND THE ERROR WAS THE INSTRUMENT'"'"'S. I first reported this branch
      # as reached ZERO times across the whole rig battery and said it might be dead.
      # It was not: the marker printed to STDERR and the rigs print only lines matching
      # their own filter, so the probe could not go positive. Re-measured with the
      # marker written to a FILE: 19 hits across the battery. A scene discriminates it
      # now -- three probes ask about the object before this one, measured rather than
      # guessed, so the rig fails the FOURTH.
      if ! deref_kind="$( git cat-file -t "$deref" 2>/dev/null )"; then
        printf 'REFUSING: the type of the tag target %s could not be read, so the object\n' "$deref" >&2
        printf '  this push publishes cannot be staged as evidence.\n' >&2
        exit 2
      fi
      run_evidence "$tmpdir/tag-target" write "the tag-target evidence file" printf ''

      if [ "$deref_kind" = blob ]; then
        read_evidence "$tmpdir/tag-target" append "the tagged blob $deref" cat-file blob "$deref"
      elif [ "$deref_kind" = tree ]; then
        # ⚠ THE COMMENT PROMISED A REFUSAL AND THE CODE TRUNCATED. `head -256`
        # dropped everything past the bound in silence, so a 257-entry tree with
        # prohibited material in the tail passed a gate that had scanned the
        # prefix (shardpilot/shardpilot-go#79 review). A bound that is not
        # enforced is a bound that is documented.
        # ⚠ AND A TREE PUBLISHES ITS PATH NAMES. The pipeline kept blob ids and
        # discarded every path, so a tag on a tree whose prohibited identifier is
        # an ENTRY NAME, with clean blob contents, was never shown to the scanner
        # -- the object publishes the names, and the evidence held only the bytes
        # (same review). The listing itself is staged; the same rules read it.
        # ⚠ `-rt`, NOT `-r`. Plain `-r` emits NOTHING for an empty subtree, so a
        # tagged tree holding only a directory whose NAME carries prohibited
        # material produced an empty listing and no evidence at all
        # (shardpilot/shardpilot-go#79 review). `-t` is documented as "show trees
        # when recursing", which is exactly the entry the recursion was hiding.
        # ⚠ CLASS: WHAT GIT PRINTS FOR HUMANS IS NOT A RECORD FORMAT. A filename needing
        # C-quoting comes back as `"…\nicon.xpm"` -- quotes included -- and that
        # spelling became the staged FILENAME, so an XPM stopped being `.xpm` and the
        # scanner's image refusal never ran (shardpilot/shardpilot-go#79 review).
        # `-z` emits the path raw and NUL-terminated, which is the machine form the
        # parser below already expects.
        read_evidence "$tmpdir/tag-tree-listing" write "the tagged tree listing of $deref" ls-tree -rtz "$deref"
        # ⚠ RECORDS, NOT LINES. `-z` made the listing NUL-terminated, so `wc -l`
        # answered 0 and the 256 bound stopped firing -- the regression suite caught
        # it on the first run after the format changed. A count is about the unit the
        # format uses, and the format had just changed under it.
        # ⚠ IN THE C LOCALE, BECAUSE THIS COUNTS BYTES. Under a UTF-8 locale BSD `tr`
        # stops with `Illegal byte sequence` on a filename holding non-UTF-8 bytes --
        # which git permits in a path -- so this count produced nothing and the push
        # was refused before the tree was ever scanned (shardpilot/shardpilot-go#86
        # review). Measured here: 0 under `en_US.UTF-8`, 2 under `C`, same input. The
        # scanner already runs its own NUL count this way; this one did not.
        entries="$( LC_ALL=C tr -dc '\000' < "$tmpdir/tag-tree-listing" | LC_ALL=C wc -c | tr -d ' ' )"
        if [ "${entries:-0}" -gt 256 ]; then
          printf 'REFUSING: the tagged tree has %s entries, past this gate'"'"'s bound of 256.\n' "$entries" >&2
          printf '  Scanning a prefix of it and reporting clean is worse than refusing:\n' >&2
          printf '  everything past the bound becomes publicly reachable unexamined.\n' >&2
          exit 2
        fi
        # ⚠ NOT THROUGH A PIPE. `while read` on the right of `|` runs in a SUBSHELL,
        # so the refusal below would have exited that subshell and let the push
        # continue -- the same shape as the `||` context that disables `set -e`
        # elsewhere in this file. The list goes to a file and the loop redirects
        # from it, which keeps the refusal in the shell that can act on it.
        # Not evidence itself, but a truncated list means fewer blobs scanned,
        # which fails in the same direction as truncated evidence.
        # ⚠ EACH BLOB AS ITS OWN FILE, UNDER ITS OWN NAME. Appending them into one
        # synthetic `.txt` destroyed exactly what the scanner classifies by: an XPM
        # whose pixels render prohibited material stops being `.xpm` and stops
        # beginning with the XPM header, so the image refusal never ran
        # (shardpilot/shardpilot-go#79 review). A concatenation is a NEW document,
        # and the rules are about the documents that were published.
        # ⚠ AND A GITLINK IS NOT A BLOB, BUT IT IS PUBLISHED. `ls-tree` reports a
        # `160000` entry with type `commit`, so a blob-only filter dropped it and the
        # scanner's own gitlink refusal never saw it
        # (shardpilot/shardpilot-go#79 review). The listing carries the mode, which
        # is what that refusal reads, so the entry needs no blob of its own.
        #
        # ⚠ CLASS: `-z` IS THE PARSER'S FORMAT AND NOBODY ELSE'S. Two failures came
        # out of letting the NUL form travel past the thing that parses it
        # (shardpilot/shardpilot-go#86 review), and the split below is the fix for
        # both: this loop is the ONLY reader of the raw listing, and it emits a
        # NUL-free rendering for everything downstream.
        #
        #   The producer was `awk ... printf "...\0"`. awk is not required to emit a
        #   NUL, and the awk this gate runs under on macOS -- `awk version 20200816`,
        #   the system default -- emits NONE: measured, zero NUL bytes out. The
        #   `read -d ''` below then hit EOF on the first iteration, so NO blob from a
        #   tagged tree was ever staged and none of the content or filename rules ran.
        #   It reported clean by doing nothing, on the developer machine this hook is
        #   written for, which is why the shape matters more than the portability:
        #   the loop that skips ITSELF prints exactly what a clean tree prints.
        #   The records are `<mode> SP <type> SP <oid> TAB <path>`, and bash can cut
        #   that, so there is no producer to disagree with.
        #
        #   And the raw listing was ALSO appended to `tag-target`, which is staged as
        #   `scripts/tag-target-as-committed.txt` and read as text -- but the scanner
        #   refuses any tracked file carrying a NUL, so a tag on ANY nonempty tree was
        #   refused whatever it held. The text rendering below terminates records with
        #   a newline instead. Path BYTES are preserved: the evidence is scanned, not
        #   parsed, so a path that itself contains a newline costs an extra break in
        #   the evidence and nothing else -- the parsing above reads the raw file.
        # ⚠ THE SIDECAR LIVES BESIDE THE SET, NOT INSIDE IT. Naming a blob's mode
        # `<blob>.mode` made the suffix carry the distinction, and a tree entry may
        # BE named `credentials.mode` -- so its evidence and its own
        # `credentials.mode.mode` were both taken for sidecars, skipped, and the
        # blob went unscanned while the push was approved
        # (shardpilot/shardpilot-go#79 review). A separate directory is a position,
        # and a position cannot be spelled by the branch.
        mkdir -p "$tmpdir/tag-blobs" "$tmpdir/tag-blobs.modes"
        tag_blobs="$tmpdir/tag-blobs"
        tab="$(printf '\t')"
        run_evidence "$tmpdir/tag-tree-listing-text" write \
          "the NUL-free rendering of the tagged tree listing" printf ''
        nb=0
        while IFS= read -r -d '' rec || [ -n "$rec" ]; do
          [ -n "$rec" ] || continue
          run_evidence "$tmpdir/tag-tree-listing-text" append \
            "an entry of the tagged tree listing" printf '%s\n' "$rec"
          # `<mode> SP <type> SP <oid> TAB <path>`; the path is raw and may hold
          # anything but a NUL, so it is cut at the FIRST tab and never split again.
          meta="${rec%%"$tab"*}"
          path="${rec#*"$tab"}"
          otype="${meta#* }"
          otype="${otype%% *}"
          oid="${meta##* }"
          # ⚠ A GITLINK IS REFUSED HERE, not left to the scanner. The round before
          # said the listing carries the mode "which is what that refusal reads" --
          # it is not: the scanner asks `git ls-files -s` for the mode of the STAGED
          # file, so a `160000` spelled in a text evidence file cannot reach it, and
          # a clean tagged tree containing a gitlink was published with the linked
          # repository never scanned (shardpilot/shardpilot-go#86 review). A
          # by-construction argument is worth exactly what the named construction is
          # worth, and this one named a check that reads something else.
          #
          # It cannot be staged AS a gitlink either: the commit it points at need not
          # exist here. Nothing this gate can do makes those contents scannable, so
          # the answer is the same one the scanner gives for a gitlink it does see.
          if [ "$otype" = commit ]; then
            printf 'REFUSING: the tagged tree contains a gitlink (%s).\n' "$oid" >&2
            printf '  Its contents are another repository, which this gate cannot scan,\n' >&2
            printf '  and publishing a tree that names it makes them reachable unexamined.\n' >&2
            exit 2
          fi
          [ "$otype" = blob ] || continue
          # The MODE travels with the blob: `120000` is a symlink and the scanner
          # classifies it differently from a regular file. Recorded beside the
          # staged bytes rather than inferred later, because the listing is the only
          # place that knows it.
          omode="${meta%% *}"
          [ -n "$oid" ] || continue
          nb=$((nb + 1))
          case "$path" in
            */*) leaf="${path##*/}" ;;
            *) leaf="$path" ;;
          esac
          # ⚠ THE STAGED NAME MUST BE USABLE AND MUST KEEP THE EXTENSION. A path may
          # carry newlines or quotes; the scanner classifies by suffix and by leading
          # bytes, so control characters are dropped and the suffix is preserved
          # rather than the whole spelling being trusted as a filename.
          # ⚠ REPLACED, NOT DELETED. Deleting a byte JOINS its neighbours, so a clean
          # blob named `asset.xp<newline>m` was staged as `asset.xpm` and refused by
          # the scanner's image rule for an extension the published path does not
          # have (shardpilot/shardpilot-go#86 review). Sanitising must not be able to
          # change what a name MEANS; one byte in, one byte out.
          # A KEPT SET, NOT A BANNED ONE, and the reason is the filesystem rather
          # than the scanner: git permits any non-NUL byte in a path, macOS permits
          # only valid UTF-8 in a filename, so staging `café.txt` spelled with a raw
          # `0xe9` failed the redirection itself -- `Illegal byte sequence` -- and the
          # push was refused over a name git considers ordinary
          # (shardpilot/shardpilot-go#86 review). Banning the bytes I had met left
          # every byte I had not.
          #
          # The identifier in a NAME is still shown to the scanner: the listing
          # evidence carries the path verbatim. What this spelling has to preserve is
          # what the scanner CLASSIFIES by -- the suffix -- and one byte in, one byte
          # out preserves it.
          leaf="$(printf '%s' "$leaf" | LC_ALL=C tr -c 'A-Za-z0-9._-' '_' )"
          [ -n "$leaf" ] || leaf="blob"
          # ⚠ AND THE COMPONENT HAS A LENGTH LIMIT, WHICH A TREE ENTRY DOES NOT.
          # Git accepts and pushes a tree whose leaf is 256 bytes; this destination
          # then exceeded the filesystem's per-component limit, the redirection
          # failed with `ENAMETOOLONG`, and the gate refused a VALID push
          # (shardpilot/shardpilot-go#79 review). A declared limit excuses missing
          # something, never rejecting something correct.
          #
          # The limit is ASKED FOR, not assumed: `NAME_MAX` is 255 on ext4 and APFS
          # and smaller on others, and a guessed bound is the same defect one size
          # along. The tail is what survives, because the SUFFIX is what the scanner
          # classifies by; the complete path is still published verbatim in the
          # listing evidence, so nothing is lost from the record. `tr` above left
          # only ASCII, so `${#leaf}` counts bytes here.
          name_max="$(getconf NAME_MAX "$tmpdir" 2>/dev/null || printf 255)"
          case "$name_max" in ''|*[!0-9]*) name_max=255 ;; esac
          [ "$name_max" -ge 32 ] || name_max=255
          # `- 6` is a margin, not an exact accounting: nothing is appended to the
          # leaf any more, and a margin costs a few bytes of a name nobody reads.
          leaf_max=$(( name_max - ${#nb} - 6 ))
          [ "$leaf_max" -ge 8 ] || leaf_max=8
          if [ "${#leaf}" -gt "$leaf_max" ]; then
            leaf="$(printf '%s' "$leaf" | tail -c "$leaf_max")"
          fi
          read_evidence "$tmpdir/tag-blobs/$nb-$leaf" write \
            "a blob reached through the tagged tree ($oid)" cat-file blob "$oid"
          run_evidence "$tmpdir/tag-blobs.modes/$nb-$leaf" write \
            "the mode of a blob reached through the tagged tree" printf '%s' "$omode"
        done < "$tmpdir/tag-tree-listing"
        run_evidence "$tmpdir/tag-target" append "the tagged tree listing" \
          cat "$tmpdir/tag-tree-listing-text"
        run_evidence "$tmpdir/tag-target" append "a tag-target separator" printf '\n'
      fi
      if [ -s "$tmpdir/tag-target" ]; then
        tag_target="$tmpdir/tag-target"
      fi
      # ⚠ AND AN UNBORN HEAD HAS NO TREE TO STAGE EVIDENCE INTO. Substituting an
      # empty `head_sha` made `worktree add` run with no commit at all and refused a
      # push git performs without reading one (shardpilot/shardpilot-go#79 review).
      # A synthetic empty commit gives the scan a tree that carries nothing of its
      # own, which is exactly what a repository with no history has; it is written
      # to the private evidence object store, so the repository under inspection
      # gains nothing.
      # ⚠ THE SCAFFOLD IS ALREADY-PUBLISHED CONTENT, NOT LOCAL `HEAD`. A refspec that
      # pushes a blob or a tree updates the destination with THAT object and nothing
      # else -- git's own documentation says the `<src>` side determines it -- so
      # scanning the local HEAD tree let Lane A refuse over unpublished material this
      # push does not transfer (shardpilot/shardpilot-go#79 review). The destination's
      # baseline is public by definition, so a refusal from it is a pre-existing
      # condition rather than something this push introduces, and the object actually
      # published is staged as evidence either way.
      scan_target=""
      if git cat-file -e "$base^{commit}" 2>/dev/null; then
        scan_target="$base"
      elif [ -n "${branch:-}" ] &&
           scan_target="$(git rev-parse --verify --quiet "refs/remotes/$remote_name/$branch^{commit}" 2>/dev/null)" &&
           [ -n "$scan_target" ]; then
        # The remote-tracking tip of the destination's default branch: published
        # content, already here, no network. Used only as the SCAFFOLD -- the ratchet
        # baseline stays the empty tree, because a non-commit push introduces no
        # ancestry and those are two different questions.
        :
      else
        # ⚠ LIMIT, NAMED: with no published commit available -- an empty destination,
        # or no remote-tracking ref for its default branch -- the local HEAD is the
        # only scaffold this gate has, and Lane A can still refuse over material the
        # push does not transfer. Fetching one purely to scaffold a scan is network
        # work this round did not take on.
        scan_target="$head_sha"
      fi
      if [ -z "$scan_target" ]; then
        # ⚠ AND A SYNTHETIC BASE CANNOT SATISFY THE SCANNER'S SELF-AUDIT.
        #
        # The trusted scanner refuses when a roster literal in its own file appears
        # nowhere ELSE in the tree it is scanning -- a real protection, because every
        # release archive carries that file. A base synthesised for a repository with
        # no history holds the published object and the scanner and nothing else, so
        # the audit fires by construction. Measured with the real scanner:
        # `4 literal(s) in this file exist nowhere else in this tree`
        # (shardpilot/shardpilot-go#79 review); the previous round's fix made the
        # push reach the scan and the scan could not pass.
        #
        # The repair the review asks for -- separating that self-validation from the
        # scan of a synthetic evidence tree -- belongs in
        # `scripts/check_public_surface.sh`, which another lane owns. Satisfying the
        # audit from HERE would mean writing a decoy second copy of the scanner into
        # the tree, which passes the check by defeating it. So this refuses, and says
        # which of the two it is: a limit of the gate, not a finding about the push.
        #
        # ⚠ AND ONLY HERE. My first version put this refusal after the whole block, so
        # it fired for EVERY non-commit push -- five scenes that had published for
        # rounds went red at once, which is what a batteryged before pushing is for.
        printf 'REFUSING: %s introduces no commit and this repository has no history,\n' "${local_ref:-that ref}" >&2
        printf '  so the only scan base would be synthetic -- and the trusted scanner\n' >&2
        printf '  audits its own literals against the tree it scans, which a two-file\n' >&2
        printf '  synthetic tree cannot satisfy. This is a limit of the gate, not a\n' >&2
        printf '  finding about what you are pushing: make one commit first, or\n' >&2
        printf '  --no-verify and own it.\n' >&2
        exit 2
      fi
    fi
    scan_ref_name "$scan_target" "$base" "$remote_ref" "$tag_object" "$tag_target" "$tag_blobs" || status=$?
    continue
  fi

  # ⚠ A DISCLOSED BUDGET, AND EVERY SKIPPED COMMIT IS NAMED.
  #
  # One scan is a full pass over the tracked tree -- 15-20s here -- so a branch
  # sitting 28 commits off main takes over eight minutes, measured. A gate that
  # slow is bypassed, and a bypassed gate protects nothing. So the budget is
  # explicit, overridable, and its remainder is PRINTED rather than dropped
  # quietly: an unscanned commit that nobody names looks exactly like a scanned
  # one. The durable cure is a scanner that can be pointed at a tree without a
  # worktree per commit; until it exists, this states its own coverage.
  budget="${PUBLIC_SURFACE_MAX_COMMITS:-10}"
  i=0
  skipped=""
  while IFS= read -r c; do
    [ -n "$c" ] || continue
    i=$((i + 1))
    if [ "$i" -gt "$budget" ] && [ "$c" != "$local_sha" ]; then
      skipped="$skipped $(git rev-parse --short "$c")"
      continue
    fi
    printf 'public surface: scanning %s (%s/%s)\n' "$(git rev-parse --short "$c")" "$i" "$n"
    scan_commit "$c" "$base" "$remote_ref" "$tag_object" || status=$?
  done <<< "$commits"
  if [ -n "$skipped" ]; then
    # ⚠ REFUSING, NOT WARNING. The first version printed this and exited 0,
    # which is a gate passing what it did not look at -- and precisely the
    # earlier-add/later-remove leak this hook exists to stop
    # (shardpilot/shardpilot-go#79 review). A disclosed hole is still a hole.
    printf '\nREFUSING: these commits were NOT scanned and this push would\n' >&2
    printf '  publish them:%s\n' "$skipped" >&2
    printf '  The budget is %s commits (PUBLIC_SURFACE_MAX_COMMITS), and one scan\n' "$budget" >&2
    printf '  is a full pass over the tree. Raise the budget and push again, or\n' >&2
    printf '  push in smaller steps. This gate does not report on what it has not\n' >&2
    printf '  read.\n' >&2
    exit 2
  fi
done <<< "$pushed_lines"
exit "$status"
